# Plinth starter .gitignore (per-project, copied once, never overwritten).
# EXTEND for your stack/domain. Do NOT ignore your project's committed output
# data (e.g. results/, manifests/) — only artifacts and secrets.

# Secrets — belt and suspenders alongside the guard hook and gitleaks
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
secrets/
credentials/

# Model weights / large binaries — commit pointers or use LFS, never raw weights
*.gguf
*.safetensors
*.ckpt
*.pt
*.onnx
*.mlx

# OS junk
.DS_Store
Thumbs.db

# Ephemeral subagent worktrees. Agent harnesses may create isolated git worktrees
# UNDER the repo. They cannot affect a reviewed diff (a worktree's own changes are
# invisible to the superproject's `git status`), but the untracked DIRECTORY makes the
# tree read as dirty — and ./.plinth/review.sh refuses a dirty tree, so the review loop
# is blocked for exactly as long as a subagent is alive. That is precisely when you want
# the reviewer running in parallel with the workers.
.claude/worktrees/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/

# Rust
target/

# Node
node_modules/
*.tsbuildinfo

# Go
/bin/
