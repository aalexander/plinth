  # Parse Claude-style reset_text → reset_at so linear-from-reset works without multi-sample history.
  # Mutates vendors_tmp in place (NDJSON of vendor objects). Best-effort; never fails the probe.
  python3 -c '
import json, re, sys
from datetime import datetime, timezone
try:
    from zoneinfo import ZoneInfo
except ImportError:
    ZoneInfo = None  # type: ignore

path, now_s = sys.argv[1], int(sys.argv[2])
try:
    lines = open(path, "r", encoding="utf-8").read().splitlines()
except Exception:
    sys.exit(0)

def parse_reset(text, now_ts):
    if not text or not isinstance(text, str):
        return None
    text = text.strip()
    m = re.match(r"^(.*?)\s*\(([^)]+)\)\s*$", text)
    if m:
        body, tzname = m.group(1).strip(), m.group(2).strip()
    else:
        body, tzname = text, "UTC"
    tz = timezone.utc
    if ZoneInfo is not None:
        try:
            tz = ZoneInfo(tzname)
        except Exception:
            tz = timezone.utc
    body_n = re.sub(r"\s+", " ", body)
    now_dt = datetime.fromtimestamp(now_ts, tz=tz)
    dt = None
    has_year = False
    # Prefer formats with year (codex-style); Claude uses "Jul 30 at 9am".
    candidates = [
        ("%Y-%m-%d %H:%M UTC", True),
        ("%Y-%m-%d %H:%M", True),
        ("%b %d at %I:%M%p", False),
        ("%b %d at %I%p", False),
        ("%b %d at %H:%M", False),
    ]
    for fmt, yflag in candidates:
        try:
            raw = body_n
            if fmt.endswith("%p"):
                raw = re.sub(r"\b([ap])m\b", lambda mm: mm.group(1).upper() + "M", raw, flags=re.I)
            dt = datetime.strptime(raw, fmt)
            has_year = yflag
            break
        except ValueError:
            continue
    if dt is None:
        return None
    if not has_year:
        dt = dt.replace(year=now_dt.year)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=tz)
    ts = int(dt.timestamp())
    # Reset times are in the future within the window; if already past, try next year.
    if not has_year and ts < now_ts - 3600:
        try:
            dt = dt.replace(year=dt.year + 1)
            ts = int(dt.timestamp())
        except Exception:
            pass
    return ts

def default_window_seconds(name):
    if not name:
        return None
    if name == "session":
        return 18000  # Claude 5h session
    if name.startswith("week") or name in ("primary", "week"):
        return 604800
    return None

out_lines = []
for line in lines:
    line = line.strip()
    if not line:
        continue
    try:
        obj = json.loads(line)
    except Exception:
        out_lines.append(line)
        continue
    if not isinstance(obj, dict) or obj.get("available") is not True:
        out_lines.append(json.dumps(obj, separators=(",", ":")))
        continue
    wins = obj.get("windows")
    if isinstance(wins, list):
        new_wins = []
        for w in wins:
            if not isinstance(w, dict):
                new_wins.append(w)
                continue
            w = dict(w)
            if w.get("window_seconds") is None:
                ws = default_window_seconds(w.get("window"))
                if ws is not None:
                    w["window_seconds"] = ws
            if w.get("reset_at") is None and w.get("reset_text"):
                ra = parse_reset(w.get("reset_text"), now_s)
                if ra is not None:
                    w["reset_at"] = ra
            new_wins.append(w)
        obj["windows"] = new_wins
    out_lines.append(json.dumps(obj, separators=(",", ":")))
try:
    open(path, "w", encoding="utf-8").write("\n".join(out_lines) + ("\n" if out_lines else ""))
except Exception:
    pass
' "$vendors_tmp" "$now" 2>/dev/null || true

  # Observed API $ only — no list-price extrapolation. Harvest real cost events into
  # an append-only log (~/.config/plinth/api-cost-log.jsonl), then sum periods.
  # Mutates vendors_tmp. Best-effort; never fails the probe.
  python3 -c '
import json, os, sys, time
from pathlib import Path
from datetime import datetime, timezone

path = sys.argv[1]
now_ts = time.time()
period_days = (
    ("24h", 1),
    ("7d", 7),
    ("30d", 30),
    ("90d", 90),
    ("180d", 180),
    ("365d", 365),
)
cuts = {lab: now_ts - d * 86400 for lab, d in period_days}
cut_year = cuts["365d"]

# Durable cumulative log (not /tmp — must survive reboot for year windows).
log_dir = Path.home() / ".config" / "plinth"
log_path = log_dir / "api-cost-log.jsonl"
TICKS = 10_000_000_000  # Grok: 1 USD = 1e10 ticks

def ensure_log():
    try:
        log_dir.mkdir(parents=True, exist_ok=True)
    except Exception:
        return False
    return True

def load_seen():
    """Return (id_set, content_key_set) for upgrade-safe dedupe.
    content keys: (vendor, usd, session_or_file, line) extracted from known id
    shapes so a format change cannot re-append the same event.
    """
    seen = set()
    content = set()
    if not log_path.is_file():
        return seen, content
    try:
        with log_path.open("r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                i = rec.get("id")
                if isinstance(i, str) and i:
                    seen.add(i)
                    ck = _content_key_from_id(i, rec.get("vendor"), rec.get("usd"))
                    if ck:
                        content.add(ck)
    except Exception:
        pass
    return seen, content

def _content_key_from_id(i, v, usd):
    if not isinstance(i, str) or not isinstance(v, str) or not isinstance(usd, (int, float)):
        return None
    parts = i.split(":")
    # grok:<eventId> | grok:sid:prompt:ticks
    if parts and parts[0] == "grok":
        if len(parts) == 2:
            return (v, round(float(usd), 6), parts[1], "")
        if len(parts) >= 4:
            return (v, round(float(usd), 6), parts[1], parts[2])
    # claude:sid:lineno:usd | codex:file:lineno:usd (+ legacy longer forms)
    sess, lineno = "", ""
    if len(parts) >= 4:
        sess, lineno = parts[1], parts[2]
    elif len(parts) >= 3:
        sess, lineno = parts[1], parts[2]
    return (v, round(float(usd), 6), sess, str(lineno))

def append_entries(entries):
    if not entries or not ensure_log():
        return 0
    n = 0
    try:
        # Exclusive lock across dashboard processes so load_seen→append is atomic.
        with log_path.open("a", encoding="utf-8") as f:
            try:
                import fcntl
                fcntl.flock(f.fileno(), fcntl.LOCK_EX)
            except Exception:
                pass
            # Re-load seen under the lock so concurrent harvests do not double-append.
            seen_now, content_now = load_seen()
            for e in entries:
                eid = e.get("id") if isinstance(e, dict) else None
                if isinstance(eid, str) and eid in seen_now:
                    continue
                ck = _content_key_from_id(
                    e.get("id") if isinstance(e, dict) else None,
                    e.get("vendor") if isinstance(e, dict) else None,
                    e.get("usd") if isinstance(e, dict) else None,
                )
                if ck is not None and ck in content_now:
                    continue
                f.write(json.dumps(e, separators=(",", ":")) + "\n")
                n += 1
                if isinstance(eid, str):
                    seen_now.add(eid)
                if ck is not None:
                    content_now.add(ck)
            # Flush while still holding the lock; unlock on close (do not unlock early).
            f.flush()
            try:
                os.fsync(f.fileno())
            except Exception:
                pass
    except Exception:
        return 0
    return n

def parse_ts(val, fallback):
    if isinstance(val, (int, float)):
        return float(val)
    if isinstance(val, str) and len(val) >= 19:
        try:
            return datetime.fromisoformat(val.replace("Z", "+00:00")).timestamp()
        except Exception:
            pass
    return float(fallback)

# ── Harvest OBSERVED costs only (no token*price extrapolation) ──
def harvest_grok(seen):
    """Server costUsdTicks on turn_completed — same family as /usage cost."""
    root = Path.home() / ".grok" / "sessions"
    if not root.is_dir():
        return []
    out = []
    for f in root.rglob("updates.jsonl"):
        try:
            mtime = f.stat().st_mtime
        except Exception:
            continue
        if mtime < cut_year:
            continue
        try:
            for line in f.open(errors="ignore"):
                if "costUsdTicks" not in line or "turn_completed" not in line:
                    continue
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                params = rec.get("params") if isinstance(rec.get("params"), dict) else {}
                upd = params.get("update") if isinstance(params.get("update"), dict) else {}
                if upd.get("sessionUpdate") != "turn_completed":
                    continue
                usage = upd.get("usage") if isinstance(upd.get("usage"), dict) else {}
                raw = usage.get("costUsdTicks")
                if raw is None:
                    continue
                try:
                    ticks = int(raw)
                except Exception:
                    continue
                if ticks <= 0:
                    continue
                usd = ticks / TICKS
                ts = parse_ts(rec.get("timestamp"), mtime)
                if ts < cut_year:
                    continue
                # Stable id for dedupe
                eid = None
                meta = rec.get("_meta") if isinstance(rec.get("_meta"), dict) else {}
                if isinstance(meta.get("eventId"), str) and meta["eventId"]:
                    eid = "grok:" + meta["eventId"]
                else:
                    sid = params.get("sessionId") or ""
                    pid = upd.get("prompt_id") or ""
                    eid = "grok:%s:%s:%s" % (sid, pid, ticks)
                if eid in seen:
                    continue
                seen.add(eid)
                out.append({
                    "t": int(ts),
                    "vendor": "grok",
                    "usd": round(usd, 6),
                    "id": eid,
                    "src": "costUsdTicks",
                })
        except Exception:
            continue
    return out

def harvest_claude(seen):
    """Only structured result/assistant total_cost_usd (never free-text or token*price)."""
    root = Path.home() / ".claude" / "projects"
    if not root.is_dir():
        return []
    out = []
    cands = []
    for f in root.rglob("*.jsonl"):
        try:
            m = f.stat().st_mtime
        except Exception:
            continue
        if m < cut_year:
            continue
        try:
            if f.stat().st_size > 80_000_000:
                continue
        except Exception:
            continue
        cands.append((m, f))
    cands.sort(reverse=True)
    for mtime, f in cands[:500]:
        try:
            for lineno, line in enumerate(f.open(errors="ignore"), 1):
                if "total_cost_usd" not in line:
                    continue
                # Structured JSON only — ignore tool_result strings / prompt echoes.
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                if not isinstance(rec, dict):
                    continue
                rtype = rec.get("type")
                usd = None
                if rtype == "result" and isinstance(rec.get("total_cost_usd"), (int, float)):
                    usd = float(rec["total_cost_usd"])
                elif rtype == "assistant":
                    msg = rec.get("message") if isinstance(rec.get("message"), dict) else {}
                    usage = msg.get("usage") if isinstance(msg.get("usage"), dict) else {}
                    if isinstance(usage.get("total_cost_usd"), (int, float)):
                        usd = float(usage["total_cost_usd"])
                    elif isinstance(rec.get("total_cost_usd"), (int, float)):
                        usd = float(rec["total_cost_usd"])
                else:
                    continue
                if usd is None or usd <= 0:
                    continue
                ts = parse_ts(rec.get("timestamp"), mtime)
                if ts < cut_year:
                    continue
                sid = rec.get("session_id") or rec.get("sessionId") or f.name
                # Stable per-event id: session + line + usd (line anchors event;
                # content_seen migrates legacy ids with same session+usd+line).
                eid = "claude:%s:%s:%.6f" % (sid, lineno, usd)
                if eid in seen:
                    continue
                seen.add(eid)
                out.append({
                    "t": int(ts),
                    "vendor": "claude",
                    "usd": round(usd, 6),
                    "id": eid,
                    "src": "total_cost_usd",
                })
        except Exception:
            continue
    return out

def harvest_codex(seen):
    """Codex: only numeric cost on known event payload types (never free-text)."""
    root = Path.home() / ".codex" / "sessions"
    if not root.is_dir():
        return []
    out = []
    cands = []
    for f in root.rglob("*.jsonl"):
        try:
            m = f.stat().st_mtime
        except Exception:
            continue
        if m < cut_year:
            continue
        cands.append((m, f))
    cands.sort(reverse=True)
    cost_keys = ("total_cost_usd", "cost_usd", "costUsd")
    for mtime, f in cands[:400]:
        try:
            for lineno, line in enumerate(f.open(errors="ignore"), 1):
                if "cost" not in line.lower() and "usd" not in line.lower():
                    continue
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                if not isinstance(rec, dict):
                    continue
                rtype = rec.get("type")
                if rtype not in ("event_msg", "turn_context", "session_meta", "response_item"):
                    continue
                payload = rec.get("payload") if isinstance(rec.get("payload"), dict) else {}
                usd = None
                for k in cost_keys:
                    if isinstance(payload.get(k), (int, float)):
                        usd = float(payload[k])
                        break
                    if isinstance(rec.get(k), (int, float)):
                        usd = float(rec[k])
                        break
                if usd is None or usd <= 0:
                    continue
                ts = parse_ts(rec.get("timestamp"), mtime)
                if ts < cut_year:
                    continue
                eid = "codex:%s:%s:%.6f" % (f.name, lineno, usd)
                if eid in seen:
                    continue
                seen.add(eid)
                out.append({
                    "t": int(ts),
                    "vendor": "codex",
                    "usd": round(usd, 6),
                    "id": eid,
                    "src": "session_cost",
                })
        except Exception:
            continue
    return out

def sum_log_by_vendor():
    """Sum cumulative log into period buckets per vendor."""
    by_v = {}
    oldest = {}
    n_entries = 0
    if not log_path.is_file():
        return by_v, oldest, 0
    try:
        with log_path.open("r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                v = rec.get("vendor")
                usd = rec.get("usd")
                t = rec.get("t")
                if not isinstance(v, str) or not isinstance(usd, (int, float)):
                    continue
                try:
                    t = float(t)
                except Exception:
                    continue
                if v not in by_v:
                    by_v[v] = {lab: 0.0 for lab, _ in period_days}
                    oldest[v] = t
                if t < oldest[v]:
                    oldest[v] = t
                for lab, cut in cuts.items():
                    if t >= cut:
                        by_v[v][lab] += float(usd)
                n_entries += 1
    except Exception:
        pass
    return by_v, oldest, n_entries

# 1) Harvest new observed costs (harvesters dedupe by id via seen; we also
# block re-append when a content-key matches a legacy log row under a new id).
seen, content_seen = load_seen()

def _content_key(e):
    if not isinstance(e, dict):
        return None
    return _content_key_from_id(e.get("id"), e.get("vendor"), e.get("usd"))

new_entries = []
for harvester in (harvest_grok, harvest_claude, harvest_codex):
    try:
        # harvester mutates seen for ids it emits; filter content-key dups here.
        for e in harvester(seen):
            ck = _content_key(e)
            if ck is not None and ck in content_seen:
                continue
            if ck is not None:
                content_seen.add(ck)
            new_entries.append(e)
    except Exception:
        pass
appended = append_entries(new_entries)

# 2) Sum log for period display.
sums, oldest_map, n_log = sum_log_by_vendor()

def spend_from_log(vendor):
    """Return observed API $ periods only when at least one bucket is > 0.
    Claude/Codex seats often have no events — omit spend entirely rather than
    inventing $0 placeholders (plan % is the primary metric for those seats).
    """
    if vendor not in sums:
        return None
    local = {lab: round(sums[vendor][lab], 2) for lab, _ in period_days}
    if not any(v > 0 for v in local.values()):
        return None
    out = {
        "currency": "USD",
        "kind": "api_cost",
        "pricing": "observed",
        "local_usd": local,
        "local_24h_usd": local["24h"],
        "local_7d_usd": local["7d"],
        "local_30d_usd": local["30d"],
        "local_90d_usd": local["90d"],
        "local_180d_usd": local["180d"],
        "local_365d_usd": local["365d"],
        "log_entries": n_log,
        "log_path": str(log_path),
        "source": "api-cost-log",
        "note": "Observed API cost only (cumulative log; not subscription; no extrapolation)",
    }
    if vendor in oldest_map:
        out["local_history_days"] = max(
            0, int(round((now_ts - oldest_map[vendor]) / 86400))
        )
    if appended:
        out["log_appended"] = appended
    return out

try:
    lines = open(path, "r", encoding="utf-8").read().splitlines()
except Exception:
    sys.exit(0)

out_lines = []
for line in lines:
    line = line.strip()
    if not line:
        continue
    try:
        obj = json.loads(line)
    except Exception:
        out_lines.append(line)
        continue
    if not isinstance(obj, dict):
        out_lines.append(line)
        continue
    # Attach observed api-cost-log spend even when the live quota probe failed
    # (available:false) — history must not disappear on a transient CLI/auth error.
    vendor = obj.get("vendor")
    api_spend = spend_from_log(vendor) if isinstance(vendor, str) else None
    prev = obj.get("spend") if isinstance(obj.get("spend"), dict) else {}
    if api_spend:
        merged = dict(prev)
        for k, v in api_spend.items():
            if k in ("on_demand_usd", "on_demand_cap_usd", "prepaid_usd",
                     "credits_balance_usd", "spend_limit_usd") and k in prev:
                continue
            merged[k] = v
        src_bits = []
        if prev.get("source"):
            src_bits.append(str(prev["source"]))
        if "api-cost-log" not in src_bits:
            src_bits.append("api-cost-log")
        merged["source"] = "+".join(src_bits)
        merged["kind"] = "api_cost"
        obj["spend"] = merged
    out_lines.append(json.dumps(obj, separators=(",", ":")))

try:
    open(path, "w", encoding="utf-8").write("\n".join(out_lines) + ("\n" if out_lines else ""))
except Exception:
    pass
' "$vendors_tmp" 2>/dev/null || true

  # Assemble: enrich EACH available vendor with linear-from-reset burn projection;
  # overall = claude week_all_models when present.
  # History samples are per-vendor: {t, vendor, window, used_pct, reset_text} (observability only).
  local history_in='[]' cached_body
  if cached_body="$(_dash_quota_read_cache "$cache")"; then
    history_in="$(printf '%s' "$cached_body" | jq -c '.history // []' 2>/dev/null || echo '[]')"
  fi
  local assembled
  assembled="$(jq -nc --slurpfile v "$vendors_tmp" --argjson now "$now" --argjson hist "$history_in" '
    def is_session_win:
      (.window // "") == "session"
      or ((.window_seconds // 0) > 0 and (.window_seconds // 0) <= 21600);
    def is_plan_win:
      (.window // "" | test("week|month|all_models|^primary$"))
      or ((.window_seconds // 0) > 21600);
    def primary_window:
      # Prefer weekly all-models; else first plan window; else first with used_pct.
      (.windows // []) as $w
      | ([$w[] | select(.window=="week_all_models" and (.used_pct!=null))][0] // null) as $wk
      | if $wk != null then $wk
        else
          ([$w[] | select(.used_pct != null and is_plan_win)][0]
           // [$w[] | select(.used_pct != null)][0] // null)
        end;
    def session_window:
      (.windows // []) as $w
      | ([$w[] | select(.used_pct != null and is_session_win)][0] // null);
    # Linear extrapolation from last reset: assume 0% at (reset_at - window_seconds).
    def rate_from_reset($pct; $reset_at; $win_secs):
      if $pct == null or $reset_at == null or $win_secs == null then null
      elif ($win_secs | type) != "number" or $win_secs <= 0 then null
      else
        ($reset_at - $win_secs) as $start
        | ($now - $start) as $elapsed
        | if $elapsed <= 0 then null
          elif $pct <= 0 then {rate_pct_per_s: 0}
          else {rate_pct_per_s: ($pct / $elapsed)}
          end
      end;
    def enrich_one_window:
      . as $w
      | ($w.used_pct) as $pct
      | ($w.reset_text // null) as $reset
      | ($w.window // "unknown") as $win
      | ($w.reset_at // null) as $ra
      | ($w.window_seconds // null) as $ws
      | rate_from_reset($pct; $ra; $ws) as $rate
      | (if $rate == null then null
         elif $pct >= 100 then $now
         elif ($rate.rate_pct_per_s // 0) <= 0 then null
         else ($now + (((100 - $pct) / $rate.rate_pct_per_s) | floor)) end) as $proj100
      | (if $rate == null or ($rate.rate_pct_per_s // 0) <= 0 then null
         else ((($rate.rate_pct_per_s * 3600 * 100) | floor) / 100) end) as $rph
      | (if $proj100 != null and $ra != null and $pct < 100 and $proj100 < $ra
         then true else false end) as $overrun
      | {
          window: $win,
          used_pct: $pct,
          remaining_pct: (if $pct == null then null else (100 - $pct) end),
          reset_text: $reset,
          reset_at: $ra,
          window_seconds: $ws,
          projected_100pct_at: $proj100,
          rate_pct_per_hour: $rph,
          overrun_risk: $overrun,
          kind: (if ($w | is_session_win) then "session"
                 elif ($w | is_plan_win) then "plan"
                 else "other" end)
        };
    def enrich:
      if .available != true then .
      else
        ((.windows // []) | map(select(.used_pct != null) | enrich_one_window)) as $wd
        | (primary_window | if . == null then null else enrich_one_window end) as $pw
        | (session_window | if . == null then null else enrich_one_window end) as $sw
        | if $pw == null and ($wd | length) == 0 then .
          else
            . + {
              windows_detail: $wd,
              session: $sw,
              plan: $pw,
              used_pct: ($pw.used_pct // $sw.used_pct // null),
              remaining_pct: ($pw.remaining_pct // $sw.remaining_pct // null),
              primary_window: ($pw.window // $sw.window // null),
              reset_text: ($pw.reset_text // $sw.reset_text // null),
              reset_at: ($pw.reset_at // $sw.reset_at // null),
              window_seconds: ($pw.window_seconds // $sw.window_seconds // null),
              projected_100pct_at: ($pw.projected_100pct_at // null),
              rate_pct_per_hour: ($pw.rate_pct_per_hour // null),
              overrun_risk: ($pw.overrun_risk // false)
            }
          end
      end;
    ($v[0:] | map(select(type=="object"))) as $vendors0
    # Normalize history: accept legacy {t, week_all_models_pct, reset_text} as claude.
    | ([ $hist[]
         | if .vendor != null then .
           elif .week_all_models_pct != null then
             {t:.t, vendor:"claude", window:"week_all_models",
              used_pct:.week_all_models_pct, reset_text:(.reset_text // null)}
           else empty end
       ]) as $hist_norm
    | ($vendors0 | map(enrich)) as $vendors
    # Append history samples for plan + session windows (sparkline fuel).
    | ($hist_norm + [
         $vendors[]
         | select(.available==true)
         | . as $v
         | (
             (if $v.plan != null and $v.plan.used_pct != null then
                {t:$now, vendor:$v.vendor, window:($v.plan.window // "plan"),
                 used_pct:$v.plan.used_pct, reset_text:($v.plan.reset_text // null)}
              else empty end),
             (if $v.session != null and $v.session.used_pct != null then
                {t:$now, vendor:$v.vendor, window:($v.session.window // "session"),
                 used_pct:$v.session.used_pct, reset_text:($v.session.reset_text // null)}
              else empty end)
           )
       ] | .[-120:]) as $hist2
    | ([$vendors[] | select(.vendor=="claude" and .available==true and .plan != null)][0] // null) as $cl
    | (if $cl != null and $cl.plan != null then
          ($cl.plan + {vendor:"claude"})
        elif $cl != null then {
          vendor: "claude",
          window: ($cl.primary_window // "week_all_models"),
          used_pct: $cl.used_pct,
          remaining_pct: $cl.remaining_pct,
          reset_text: $cl.reset_text,
          reset_at: $cl.reset_at,
          projected_100pct_at: $cl.projected_100pct_at,
          rate_pct_per_hour: $cl.rate_pct_per_hour,
          overrun_risk: ($cl.overrun_risk // false)
        } else null end) as $overall
    | {
        available: ([$vendors[] | select(.available==true)] | length > 0),
        refreshed_at: $now,
        overall: $overall,
        vendors: $vendors,
        history: $hist2,
        note: "claude: -p /usage; codex: wham/usage; grok: billing+credits. Primary: plan % + linear →100% from last reset. API $ only when observed in ~/.config/plinth/api-cost-log.jsonl (no extrapolation)."
      }
  ' 2>/dev/null)" || assembled=""
  rm -f "$vendors_tmp"
  if [ -z "$assembled" ]; then
    jq -nc --argjson now "$now" \
      '{available:false, refreshed_at:$now, note:"quota assemble failed", vendors:[]}'
    return 0
  fi
  # Persist cache atomically (best-effort). Create parent only if missing and a
  # directory; if the target path is already a directory, skip write.
  local parent
  parent="$(dirname "$cache")"
  if [ -e "$cache" ] && [ ! -f "$cache" ]; then
    printf '%s\n' "$assembled"
    return 0
  fi
  if [ ! -d "$parent" ]; then
    mkdir -p "$parent" 2>/dev/null || true
  fi
  [ -d "$parent" ] || { printf '%s\n' "$assembled"; return 0; }
  local tmpc
  tmpc="$(mktemp "$parent/dash-quota.XXXXXX" 2>/dev/null || true)"
  if [ -n "$tmpc" ]; then
    printf '%s\n' "$assembled" > "$tmpc" 2>/dev/null \
      && mv -f "$tmpc" "$cache" 2>/dev/null \
      || rm -f "$tmpc" 2>/dev/null || true
  fi
  printf '%s\n' "$assembled"
}

build_dashboard_snapshot() {
  local roots tmp dir projects_json discovery quota_json
  tmp="$(mktemp)" || { echo "plinth dash: mktemp failed" >&2; exit 1; }
  : > "$tmp"
  roots="$(discover_dashboard_projects | sort -u)"
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    snapshot_one_project "$dir" >> "$tmp" || true
  done <<< "$roots"
  # jq -s on an empty file yields []; if the slurp itself fails, surface a top-level
  # error rather than a silent empty wallboard (looks-idle-while-broken).
  local top_err=""
  if projects_json="$(jq -s '.' "$tmp" 2>/dev/null)"; then
    :
  else
    projects_json='[]'
    top_err="projects_aggregate_failed"
  fi
  rm -f "$tmp"
  if [ -n "${PLINTH_DASH_ROOTS:-}" ]; then
    discovery="env:PLINTH_DASH_ROOTS"
  elif [ -f "$HOME/.config/plinth/dashboard-projects" ]; then
    discovery="config:~/.config/plinth/dashboard-projects"
  else
    discovery="default:~/Dev/*/.plinth/config"
  fi
  # Quota probe is independent of project cards; failures stay inside the object.
  quota_json="$(_dash_quota_probe 2>/dev/null || true)"
  [ -n "$quota_json" ] || quota_json='{"available":false,"note":"quota probe unavailable","vendors":[]}'
  if [ -n "$top_err" ]; then
    jq -nc --argjson projects "$projects_json" --argjson generated_at "$(date +%s)" \
       --arg discovery "$discovery" --arg error "$top_err" --argjson quota "$quota_json" \
       '{generated_at:$generated_at, discovery:$discovery, projects:$projects, error:$error, quota:$quota}'
  else
    jq -nc --argjson projects "$projects_json" --argjson generated_at "$(date +%s)" \
       --arg discovery "$discovery" --argjson quota "$quota_json" \
       '{generated_at:$generated_at, discovery:$discovery, projects:$projects, quota:$quota}'
  fi
}

run_dashboard() {
  shift  # drop cmd
  local mode=serve port="${PLINTH_DASH_PORT:-7348}" arg
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --snapshot) mode=snapshot ;;
      # Internal: HTTP serve child only. Not a public operator flag.
      --snapshot-with-quota) mode=snapshot_quota ;;
      --port)
        port="${1:-}"
        [ -n "$port" ] || { echo "plinth dash: --port needs a number" >&2; exit 1; }
        shift || true
        ;;
      --help|-h) usage ;;
      *) echo "plinth dash: unknown arg: $arg" >&2; usage ;;
    esac
  done

  if [ "$mode" = snapshot ] || [ "$mode" = snapshot_quota ]; then
    # Public --snapshot is always offline. Probe only via --snapshot-with-quota
    # (serve child). Env vars cannot enable probes on --snapshot.
    if [ "$mode" = snapshot_quota ]; then
      _DASH_QUOTA_ALLOW_PROBE=1
    else
      _DASH_QUOTA_ALLOW_PROBE=0
    fi
    build_dashboard_snapshot
    exit 0
  fi

  # Validate the final port whether it came from --port or PLINTH_DASH_PORT
  # (serve mode only — snapshot never binds). Length-cap first so an oversized
  # digit string cannot trip bash "integer expression expected" and fall through.
  case "$port" in ''|*[!0-9]*) echo "plinth dash: bad port: $port" >&2; exit 1 ;; esac
  if [ "${#port}" -gt 5 ] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo "plinth dash: port out of range (1-65535): $port" >&2; exit 1
  fi

  command -v python3 >/dev/null 2>&1 || { echo "plinth dash: python3 required to serve the UI" >&2; exit 1; }
  local html="$PLINTH_ROOT/shared/dashboard/index.html"
  [ -f "$html" ] || { echo "plinth dash: missing $html" >&2; exit 1; }

  # Resolve self for the child to re-invoke --snapshot (same checkout / same env).
  local self="$PLINTH_ROOT/bin/plinth"
  [ -x "$self" ] || self="$(command -v plinth 2>/dev/null || true)"
  [ -n "$self" ] || { echo "plinth dash: cannot locate plinth binary" >&2; exit 1; }

  echo "plinth dash: http://127.0.0.1:${port}/  (loopback only · ctrl-c to quit)"
  echo "  discovery: $(if [ -n "${PLINTH_DASH_ROOTS:-}" ]; then echo "PLINTH_DASH_ROOTS"; elif [ -f "$HOME/.config/plinth/dashboard-projects" ]; then echo "~/.config/plinth/dashboard-projects"; else echo "~/Dev/*/.plinth/config"; fi)"
  # Env passed explicitly so the child inherits roots/config the same way.
  # Serve child re-invokes `dash --snapshot-with-quota` (not public --snapshot).
  PLINTH_BIN="$self" PLINTH_DASH_HTML="$html" \
  PLINTH_DASH_ROOTS="${PLINTH_DASH_ROOTS:-}" \
  python3 - "$port" <<'PY'
import json, os, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(sys.argv[1])
HOST = "127.0.0.1"
HTML = os.environ["PLINTH_DASH_HTML"]
BIN = os.environ["PLINTH_BIN"]
# Preserve operator discovery overrides for snapshot child.
CHILD_ENV = os.environ.copy()

# Single-flight + TTL cache: concurrent /api/snapshot callers share one builder.
# TTL is >= the UI poll interval (2s) so steady-state polling reuses the body
# instead of re-scanning every project's events.jsonl every tick. Loopback-only.
_snap_lock = threading.Lock()
_snap_body = None  # success body bytes
_snap_err = None   # failure body bytes (shared single-flight)
_snap_mono = 0.0
_SNAP_TTL = 2.5
_SNAP_ERR_TTL = 1.0
# Optional test hook: PLINTH_DASH_SNAPSHOT_BIN overrides the offline builder
# (smoke counts invocations for single-flight / TTL assertions).
SNAP_BIN = os.environ.get("PLINTH_DASH_SNAPSHOT_BIN") or BIN

def _host_ok(handler):
    # DNS-rebinding defense: only accept loopback Host values.
    # Handles "127.0.0.1:7348", "localhost", "[::1]", "[::1]:7348".
    # Rejects "[::1]attacker.example" and any non-empty non-:port suffix after ].
    h = (handler.headers.get("Host") or "").strip().lower()
    if not h:
        return False
    if h.startswith("["):
        end = h.find("]")
        if end < 0:
            return False
        host = h[1:end]
        rest = h[end + 1:]
        if rest:
            # Must be exactly :digits (port); nothing else.
            if not (rest.startswith(":") and rest[1:].isdigit() and len(rest) > 1):
                return False
    else:
        # hostname / IPv4, optional :port (exactly one colon for port split)
        if h.count(":") == 1:
            host, port = h.rsplit(":", 1)
            if not port.isdigit():
                return False
        else:
            host = h
    return host in ("127.0.0.1", "localhost", "::1")

def _snapshot_bytes():
    """Single-flight success + short-lived shared failure (no stampede on errors)."""
    global _snap_body, _snap_err, _snap_mono
    now = time.monotonic()
    with _snap_lock:
        if _snap_body is not None and (now - _snap_mono) < _SNAP_TTL:
            return 200, _snap_body
        if _snap_err is not None and (now - _snap_mono) < _SNAP_ERR_TTL:
            return 500, _snap_err
        try:
            proc = subprocess.run(
                # Internal flag: may refresh vendor quota; public --snapshot cannot.
                [SNAP_BIN, "dash", "--snapshot-with-quota"],
                env=CHILD_ENV,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=120,
                check=False,
            )
            if proc.returncode != 0:
                detail = (proc.stderr or b"").decode("utf-8", "replace").strip()
                if not detail:
                    detail = (proc.stdout or b"").decode("utf-8", "replace").strip()
                if not detail:
                    detail = "dash --snapshot exited %s" % proc.returncode
                err = json.dumps({"error": "snapshot_failed", "detail": detail[:2000]}).encode()
                _snap_err = err
                _snap_body = None
                _snap_mono = time.monotonic()
                return 500, err
            out = proc.stdout or b""
            json.loads(out)
            _snap_body = out
            _snap_err = None
            _snap_mono = time.monotonic()
            return 200, out
        except Exception as e:
            err = json.dumps({"error": "snapshot_failed", "detail": str(e)[:2000]}).encode()
            _snap_err = err
            _snap_body = None
            _snap_mono = time.monotonic()
            return 500, err

class H(BaseHTTPRequestHandler):
    server_version = "plinth-dash/1"
    def log_message(self, fmt, *args):
        sys.stderr.write("plinth dash: %s - %s\n" % (self.address_string(), fmt % args))

    def _send(self, code, body: bytes, ctype: str):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if not _host_ok(self):
            self._send(400, b"bad host", "text/plain; charset=utf-8")
            return
        path = self.path.split("?", 1)[0]
        if path in ("/", "/index.html"):
            try:
                with open(HTML, "rb") as f:
                    body = f.read()
            except OSError as e:
                self._send(500, str(e).encode(), "text/plain; charset=utf-8")
                return
            self._send(200, body, "text/html; charset=utf-8")
            return
        if path == "/api/snapshot":
            code, out = _snapshot_bytes()
            self._send(code, out, "application/json; charset=utf-8")
            return
        self._send(404, b"not found", "text/plain; charset=utf-8")

    def do_POST(self):
        if not _host_ok(self):
            self._send(400, b"bad host", "text/plain; charset=utf-8")
            return
        self._send(405, b"read-only", "text/plain; charset=utf-8")

class LoopbackServer(ThreadingHTTPServer):
    allow_reuse_address = True
    def server_bind(self):
        # Belt: refuse non-loopback even if HOST were ever changed above.
        if self.server_address[0] not in ("127.0.0.1", "::1"):
            raise RuntimeError("plinth dash refuses non-loopback bind")
        super().server_bind()

httpd = LoopbackServer((HOST, PORT), H)
try:
    httpd.serve_forever()
except KeyboardInterrupt:
    pass
finally:
    httpd.server_close()
PY
}

# ── Lifecycle: default build, ship-time harden, handoff ─────────────────────
# Phase is branch-keyed session state (agents cannot write .plinth/session/).
# Missing phase file => build (Stop does not force review). harden => Stop
# requires APPROVED@HEAD. Ship gate always requires APPROVED@HEAD.

# Branch slug for session files. Encode / and space distinctly so feat/a-b ≠ feat/a/b.
# Legacy readers also try tr '/ ' '--' via _lifecycle_phase_file_legacy.
_lifecycle_slug() {
  local b
  # Detached HEAD → "detached" (matches dashboard smoke / statusline contract).
  b=$(git -C "${1:-.}" symbolic-ref --short -q HEAD 2>/dev/null || echo detached)
  printf '%s' "$b" | sed 's/\//%2F/g; s/ /%20/g'
}
_lifecycle_slug_legacy() {
  local b
  b=$(git -C "${1:-.}" symbolic-ref --short -q HEAD 2>/dev/null || echo detached)
  printf '%s' "$b" | tr '/ ' '--'
}

# Resolve review session dir: prefer a directory that actually has verdict.json
# (encoded first, then legacy). Empty encoded dirs must not mask legacy verdicts.
_lifecycle_review_dir() {
  local root="$1" enc leg
  enc="$root/.plinth/session/review/$(_lifecycle_slug "$root")"
  leg="$root/.plinth/session/review/$(_lifecycle_slug_legacy "$root")"
  if [ -f "$enc/verdict.json" ]; then printf '%s' "$enc"
  elif [ -f "$leg/verdict.json" ]; then printf '%s' "$leg"
  elif [ -d "$enc" ]; then printf '%s' "$enc"
  elif [ -d "$leg" ]; then printf '%s' "$leg"
  else printf '%s' "$enc"
  fi
}
_lifecycle_verdict_file() {
  local d
  d="$(_lifecycle_review_dir "$1")"
  printf '%s' "$d/verdict.json"
}

_lifecycle_phase_file() {
  local root="$1" slug
  slug=$(_lifecycle_slug "$root")
  printf '%s' "$root/.plinth/session/phase-$slug.json"
}
_lifecycle_phase_file_legacy() {
  local root="$1" slug
  slug=$(_lifecycle_slug_legacy "$root")
  printf '%s' "$root/.plinth/session/phase-$slug.json"
}

_lifecycle_read_phase() {
  # Missing file => build (default). Corrupt / unknown phase => harden (fail closed:
  # Stop requires APPROVED rather than silently deferring review).
  # Prefer encoded slug; fall back to legacy tr '/ ' '--' for older session files.
  local f p root="$1"
  f=$(_lifecycle_phase_file "$root")
  if [ ! -f "$f" ]; then
    f=$(_lifecycle_phase_file_legacy "$root")
  fi
  if [ ! -f "$f" ]; then
    echo build
    return 0
  fi
  p=$(jq -r '.phase // empty' "$f" 2>/dev/null || true)
  case "$p" in
    build|harden) echo "$p" ;;
    *) echo harden ;;
  esac
}

_lifecycle_write_phase() {
  local root="$1" phase="$2" f dir slug head ts
  slug=$(_lifecycle_slug "$root")
  dir="$root/.plinth/session"
  mkdir -p "$dir"
  f="$dir/phase-$slug.json"
  head=$(git -C "$root" rev-parse HEAD 2>/dev/null || echo unknown)
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  jq -n --arg p "$phase" --arg b "$(git -C "$root" symbolic-ref --short -q HEAD 2>/dev/null || echo HEAD)" \
    --arg slug "$slug" --arg head "$head" --arg ts "$ts" --arg who "${USER:-unknown}" \
    '{phase:$p, branch:$b, slug:$slug, head:$head, updated_at:$ts, by:$who}' > "$f"
}

run_phase_status() {
  local root="${1:-$target}" p f
  p=$(_lifecycle_read_phase "$root")
  f=$(_lifecycle_phase_file "$root")
  [ -f "$f" ] || f=$(_lifecycle_phase_file_legacy "$root")
  echo "project: $root"
  echo "branch:  $(git -C "$root" symbolic-ref --short -q HEAD 2>/dev/null || echo detached)"
  echo "phase:   $p"
  if [ -f "$f" ]; then
    echo "state:   $f"
    jq -c . "$f" 2>/dev/null || true
  else
    echo "state:   (absent — default build)"
  fi
  if [ "$p" = "harden" ]; then
    echo "stop:    requires APPROVED@HEAD (run ./.plinth/review.sh)"
  else
    echo "stop:    build_defer (no forced review); ship still needs APPROVED@HEAD"
  fi
  echo "plan:    $([ -f "$root/PLAN.md" ] && echo yes || echo no)  plan-review: $([ -f "$root/PLAN-REVIEW.md" ] && echo yes || echo no)  handoff: $([ -f "$root/HANDOFF.md" ] && echo yes || echo no)"
}

# Classify handoff: milestone (optional compact advice) vs checkpoint (keep cooking).
# NEVER waits for human/compaction — notify and return immediately.
_handoff_kind() {
  case "${1:-manual}" in
    enter-harden|enter-build|plan-deep|review-approved|approved|manual-milestone)
      echo milestone ;;
    *) echo checkpoint ;;
  esac
}

# Write HANDOFF.md. Args: root, optional reason, optional next_hint.
# Auto snapshots preserve prior ## Next / ## Done when present.
# Always continues immediately (max automation). context_advice is advisory only.
_write_handoff() {
  local root="$1" reason="${2:-manual}" next_hint="${3:-}"
  local out head branch phase slug vfile verdict vsha goal next done_block ts kind advice
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || return 1
  head=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown)
  branch=$(git -C "$root" symbolic-ref --short -q HEAD 2>/dev/null || echo HEAD)
  phase=$(_lifecycle_read_phase "$root")
  slug=$(_lifecycle_slug "$root")
  vfile="$(_lifecycle_verdict_file "$root")"
  verdict="none"; vsha=""
  if [ -f "$vfile" ]; then
    verdict=$(jq -r '.verdict // "none"' "$vfile" 2>/dev/null || echo none)
    vsha=$(jq -r '.sha // empty' "$vfile" 2>/dev/null | head -c 12)
  fi
  goal="(edit: one paragraph of what this branch ships)"
  if [ -f "$root/PLAN.md" ]; then
    # Full Problem section — collapse to one paragraph. Avoid SIGPIPE under
    # pipefail (large sections + head -c) by reading into a var first.
    local graw
    graw=$(awk '/^## Problem/{p=1;next} p&&/^## /{exit} p' "$root/PLAN.md" 2>/dev/null || true)
    if [ -n "$graw" ]; then
      goal=$(printf '%s' "$graw" | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g; s/^ //; s/ $//')
      [ "${#goal}" -gt 500 ] && goal="${goal:0:500}"
    fi
    [ -n "$goal" ] || goal="(edit: one paragraph of what this branch ships)"
  fi
  out="$root/HANDOFF.md"
  done_block="- (edit: bullets of what is already committed)"
  next="1. (edit: next concrete step)"$'\n'"2. …"
  # Operator freeform sections preserved across refresh (not only Done/Next).
  local goal_body="" evidence_body="" risks_body="" extra_sections="" restart_body=""
  if [ -f "$out" ]; then
    local _hd _hn _hg _he _hr _hx _raw
    _hd=$(mktemp) _hn=$(mktemp) _hg=$(mktemp) _he=$(mktemp) _hr=$(mktemp) _hx=$(mktemp)
    # Archive PRE-overwrite so freeform text is recoverable.
    local sdir_pre arch_pre
    sdir_pre="$root/.plinth/session"
    mkdir -p "$sdir_pre"
    arch_pre="$sdir_pre/handoff-${slug}-pre-$(date -u +%Y%m%dT%H%M%S)-$$-$RANDOM.md"
    cp "$out" "$arch_pre" 2>/dev/null || true
    # Exact reserved headings only — "## Next release" etc. stay operator freeform.
    awk '/^## Done[[:space:]]*$/{p=1;next} p&&/^## /{exit} p' "$out" 2>/dev/null > "$_hd" || true
    awk '/^## Next([[:space:]]*\(ordered\))?[[:space:]]*$/{p=1;next} p&&/^## /{exit} p' "$out" 2>/dev/null > "$_hn" || true
    awk '/^## Goal[[:space:]]*$/{p=1;next} p&&/^## /{exit} p' "$out" 2>/dev/null > "$_hg" || true
    awk '/^## Evidence[[:space:]]*$/{p=1;next} p&&/^## /{exit} p' "$out" 2>/dev/null > "$_he" || true
    awk '/^## Risks( \/ Noticed)?[[:space:]]*$/{p=1;next} p&&/^## /{exit} p' "$out" 2>/dev/null > "$_hr" || true
    # Unrecognized ## sections (exact reserved names only)
    awk '
      /^## / {
        title=$0
        if (title ~ /^## (Goal|Done|Evidence)[[:space:]]*$/ \
            || title ~ /^## Next([[:space:]]*\(ordered\))?[[:space:]]*$/ \
            || title ~ /^## Restart prompt[[:space:]]*$/ \
            || title ~ /^## Risks( \/ Noticed)?[[:space:]]*$/) { p=0; next }
        p=1; print title; next
      }
      p { print }
    ' "$out" 2>/dev/null > "$_hx" || true
    _read_sec() {
      local f="$1"
      [ -s "$f" ] || return 1
      _raw=$(python3 -c 'import pathlib,sys; sys.stdout.write(pathlib.Path(sys.argv[1]).read_text()+"\n<<PLINTH_EOF>>")' "$f" 2>/dev/null) \
        || _raw=$(cat "$f"; printf '\n<<PLINTH_EOF>>')
      _raw=${_raw%$'\n<<PLINTH_EOF>>'}
      _raw=${_raw%<<PLINTH_EOF>>}
      printf '%s' "$_raw"
    }
    if [ -s "$_hd" ]; then done_block=$(_read_sec "$_hd"); fi
    if [ -s "$_hn" ]; then next=$(_read_sec "$_hn"); fi
    if [ -s "$_hg" ]; then
      goal_body=$(_read_sec "$_hg")
      # Keep freeform unless every non-empty line is still a scaffold (edit: ...) line.
      if printf '%s\n' "$goal_body" | grep -vE '^[[:space:]]*$|^\(edit' | grep -q .; then
        goal="$goal_body"
      fi
    fi
    if [ -s "$_he" ]; then evidence_body=$(_read_sec "$_he"); fi
    if [ -s "$_hr" ]; then risks_body=$(_read_sec "$_hr"); fi
    if [ -s "$_hx" ]; then extra_sections=$(_read_sec "$_hx"); fi
    rm -f "$_hd" "$_hn" "$_hg" "$_he" "$_hr" "$_hx"
  fi
  # Insert a phase-aware first Next line. Only drop exact known auto-generated
  # lifecycle hints (not arbitrary operator text containing "review.sh" etc.).
  _handoff_is_auto_lifecycle() {
    case "$1" in
      "Run ./.plinth/review.sh until APPROVED@HEAD, then open PR (or plinth build to leave harden)."|\
      "Run ./.plinth/review.sh until APPROVED@HEAD, then open PR (or plinth build to leave harden)"|\
      "continue build (or plinth harden when product ready)"|\
      "continue build (or plinth harden when product ready)."|\
      "Continue implementation; plinth harden when product is ready to ship."|\
      "Continue implementation; plinth harden when product is ready to ship"|\
      "open PR (APPROVED@HEAD)"|\
      "open PR (APPROVED@HEAD) — or re-run review if HEAD moved"|\
      "re-run ./.plinth/review.sh (APPROVED but not at HEAD — ship gate unsatisfied)"|\
      "run ./.plinth/review.sh (harden phase, no APPROVED@HEAD)"|\
      "fix review finding, commit, re-run ./.plinth/review.sh"|\
      "Resolve PLAN-REVIEW.md merged blockers (or plinth next); update PLAN.md; then implement."|\
      "Resolve PLAN-REVIEW.md merged blockers (or plinth next); update PLAN.md; then implement")
        return 0 ;;
    esac
    # Residual: never pattern-match Fix […] (operators and generated share shape).
    # Exact allowlist only for known auto lifecycle strings (see CHANGELOG residual).
    return 1
  }
  _handoff_set_primary_next() {
    local hint="$1" cur="$2" line stripped out="" started=0
    [ -n "$hint" ] || { printf '%s' "$cur"; return; }
    while IFS= read -r line || [ -n "$line" ]; do
      # Preserve blank separators (including leading) and original formatting.
      if [ -z "${line// }" ]; then
        if [ "$started" = 0 ]; then
          out=$'\n'
          started=1
        else
          out="${out}"$'\n'
        fi
        continue
      fi
      stripped=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*([0-9]+[.)]+|-)?[[:space:]]*//')
      [ -n "$stripped" ] || continue
      [ "$stripped" = "$hint" ] && continue
      if _handoff_is_auto_lifecycle "$stripped"; then
        continue
      fi
      if [ "$started" = 0 ]; then
        out="${line}"
        started=1
      else
        out="${out}"$'\n'"${line}"
      fi
    done <<< "$cur"
    if [ "$started" = 1 ]; then
      printf '1. %s\n%s' "$hint" "$out"
    else
      printf '1. %s' "$hint"
    fi
  }
  # Default primary action from current phase when no explicit hint (e.g. review-approved).
  if [ -z "$next_hint" ] && [ -z "${PLINTH_HANDOFF_NEXT:-}" ]; then
    local full_head
    full_head=$(git -C "$root" rev-parse HEAD 2>/dev/null || true)
    case "$phase" in
      harden)
        if [ "$verdict" = "APPROVED" ] && [ -n "$vsha" ] && [ -n "$full_head" ] \
           && { [ "$vsha" = "$full_head" ] || [ "$vsha" = "${full_head:0:${#vsha}}" ]; }; then
          next_hint="open PR (APPROVED@HEAD)"
        elif [ "$verdict" = "APPROVED" ]; then
          next_hint="re-run ./.plinth/review.sh (APPROVED but not at HEAD — ship gate unsatisfied)"
        else
          next_hint="Run ./.plinth/review.sh until APPROVED@HEAD, then open PR (or plinth build to leave harden)."
        fi
        ;;
      build)
        next_hint="Continue implementation; plinth harden when product is ready to ship."
        ;;
    esac
  fi
  if [ -n "${PLINTH_HANDOFF_NEXT:-}" ] || [ -n "$next_hint" ]; then
    local _hp _hint_use
    _hint_use="${PLINTH_HANDOFF_NEXT:-$next_hint}"
    _hp=$(mktemp)
    # Sentinel so trailing blanks from the helper survive command substitution.
    { _handoff_set_primary_next "$_hint_use" "$next"; printf '\n<<PLINTH_EOF>>'; } > "$_hp"
    _raw=$(cat "$_hp")
    rm -f "$_hp"
    next=${_raw%$'\n<<PLINTH_EOF>>'}
    next=${next%<<PLINTH_EOF>>}
  fi
  kind=$(_handoff_kind "$reason")
  if [ "$kind" = "milestone" ]; then
    advice="optional_fresh_session — NOT required; do not wait. Keep working unless human-blocked."
  else
    advice="keep_cooking — checkpoint only; do not compact/clear mid-loop."
  fi
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  # Normalize section bodies to end with exactly one newline so the template
  # does not accumulate blanks on every refresh.
  if command -v python3 >/dev/null 2>&1; then
    done_block=$(printf '%s' "$done_block" | python3 -c 'import sys; t=sys.stdin.read().rstrip("\n")+"\n"; sys.stdout.write(t)')
    next=$(printf '%s' "$next" | python3 -c 'import sys; t=sys.stdin.read().rstrip("\n")+"\n"; sys.stdout.write(t)')
    goal=$(printf '%s' "$goal" | python3 -c 'import sys; t=sys.stdin.read().rstrip("\n")+"\n"; sys.stdout.write(t)')
  fi
  # shellcheck disable=SC2154
  {
    printf '%s\n' "# Handoff — \`${branch}\` @ ${head}" "" \
      "Updated: ${ts} · Phase: **${phase}** · Snapshot: **${reason}** (${kind}) · Verdict: ${verdict}${vsha:+ @ $vsha}" "" \
      "context_advice: ${advice}" "" \
      "## Goal"
    printf '%s' "$goal"
    printf '%s\n' "" "## Done"
    printf '%s' "$done_block"
    printf '%s\n' "" "## Next (ordered)"
    printf '%s' "$next"
    printf '%s\n' "" "## Restart prompt" \
      "> Read HANDOFF.md and continue from ## Next." \
      "> Phase is **${phase}**. Do not open a PR until \`plinth harden\` and \`./.plinth/review.sh\` reach APPROVED@HEAD (unless already APPROVED at this HEAD)." \
      "> Advisor: \`plinth advise\` anytime." \
      "> **Automation:** never block on compaction. At milestones, fresh session is optional; default is keep cooking until ## Next is empty or NEEDS-HUMAN has [BLOCKING] items." \
      "" "## Evidence"
    # Single Live snapshot. Strip only our auto Live: lines and exact template
    # bullets we generate — never delete operator freeform (even if it starts HEAD:).
    live_line="- Live: phase=${phase} reason=${reason} verdict=${verdict}${vsha:+ @ $vsha} HEAD=\`${head}\` branch=\`${branch}\`"
    if [ -n "$evidence_body" ]; then
      printf '%s\n' "$evidence_body" | grep -vE '^- Live: phase=' \
        | grep -vE '^- Lifecycle phase: (build|harden)$' \
        | grep -vE '^- Snapshot reason: ' \
        | grep -vE '^- Review verdict: ' \
        | grep -vE '^- PLAN\.md: (present|absent)$' \
        | grep -vE '^- PLAN-REVIEW\.md: (present|absent)$' \
        | grep -vE '^- HEAD: `[^`]+` on `' || true
    fi
    printf '%s\n' "$live_line"
    printf '%s\n' "" "## Risks / Noticed"
    if [ -n "$risks_body" ]; then
      printf '%s' "$risks_body"
      case "$risks_body" in *$'\n') ;; *) printf '\n' ;; esac
    else
      printf '%s\n' "- (edit)"
    fi
    if [ -n "$extra_sections" ]; then
      printf '\n%s' "$extra_sections"
      case "$extra_sections" in *$'\n') ;; *) printf '\n' ;; esac
    fi
  } > "$out"
  local arch sdir
  sdir="$root/.plinth/session"
  mkdir -p "$sdir"
  # Post-write snapshot (pre-write already archived when prior file existed).
  arch="$sdir/handoff-${slug}-$(date -u +%Y%m%dT%H%M%S)-$$-$RANDOM.md"
  cp "$out" "$arch" 2>/dev/null || true
  # Non-blocking notification event for watch/dash (never waits).
  { jq -cn --arg reason "$reason" --arg kind "$kind" --arg advice "$advice" --arg head "$head" \
      '{ts:(now|todate),epoch:(now|floor),event:"handoff_snapshot",sid:null,tool:null,
        detail:("reason="+$reason+" kind="+$kind+" advice="+$advice),head:$head}' \
      >> "$sdir/events.jsonl"; } 2>/dev/null || true
  echo "Wrote $out (snapshot: $reason / $kind)"
  echo "NOTIFY: handoff ${kind} — ${advice}"
  echo "Automation: continuing immediately (no wait for compact/human)."
}

run_harden() {
  local root="${1:-$target}"
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || { echo "plinth harden: not a git repo: $root" >&2; exit 1; }
  case "$(git -C "$root" symbolic-ref --short -q HEAD 2>/dev/null || echo HEAD)" in
    main|master|HEAD)
      echo "plinth harden: refuse on base/detached branch — use a feature branch" >&2
      exit 1 ;;
  esac
  _lifecycle_write_phase "$root" harden
  # Invalidate any prior BUILD APPROVED@HEAD in BOTH encoded and legacy review
  # dirs — harden requires a new review under HARDEN rigor. Same HEAD must not
  # ship on a BUILD verdict (guard falls back across both paths).
  local vf pv demoted=0
  for vf in \
    "$root/.plinth/session/review/$(_lifecycle_slug "$root")/verdict.json" \
    "$root/.plinth/session/review/$(_lifecycle_slug_legacy "$root")/verdict.json"
  do
    [ -f "$vf" ] || continue
    pv=$(jq -r '.review_phase // .risk.review_phase // empty' "$vf" 2>/dev/null || true)
    # Missing review_phase = pre-v5 / BUILD-era — always invalidate on harden.
    if [ "$pv" != "hardening" ]; then
      jq --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '.verdict = "UNBOUND" | .unbound_reason = "plinth harden invalidated non-HARDEN approval — re-run review" | .ts = $ts' \
        "$vf" > "$vf.tmp" 2>/dev/null && mv "$vf.tmp" "$vf" \
        || rm -f "$vf"
      demoted=1
    fi
  done
  [ "$demoted" = 1 ] && echo "  Prior non-HARDEN verdict demoted to UNBOUND — re-run ./.plinth/review.sh under harden."
  _write_handoff "$root" "enter-harden" "Run ./.plinth/review.sh until APPROVED@HEAD, then open PR (or plinth build to leave harden)."
  echo "Plinth phase → HARDEN (ship prep)."
  echo "  Stop gate now requires APPROVED@HEAD."
  echo "  Run:  (cd \"$root\" && ./.plinth/review.sh)"
  echo "  When done shipping prep without ship: plinth build \"$root\""
  echo "  Ship still blocked until APPROVED@HEAD (unchanged)."
}

run_build_phase() {
  local root="${1:-$target}"
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || { echo "plinth build: not a git repo: $root" >&2; exit 1; }
  _lifecycle_write_phase "$root" build
  _write_handoff "$root" "enter-build" "Continue implementation; plinth harden when product is ready to ship."
  echo "Plinth phase → BUILD (default)."
  echo "  Stop gate allows end-of-turn without APPROVED (build_defer)."
  echo "  PR/merge still requires APPROVED@HEAD — run plinth harden when ready to ship."
}

run_handoff() {
  local root="${1:-$target}" reason="${PLINTH_HANDOFF_REASON:-manual}"
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || { echo "plinth handoff: not a git repo: $root" >&2; exit 1; }
  _write_handoff "$root" "$reason" ""
}

# Scaffold or ensure PLAN.md (light). --deep also runs multi-agent critique → PLAN-REVIEW.md.
_plan_scaffold() {
  local root="$1" f="$1/PLAN.md"
  if [ -f "$f" ]; then
    echo "PLAN.md already present — not overwriting ($f)"
    return 0
  fi
  cat > "$f" <<'EOF'
# Product plan
product_rev: 1

## Problem
(What user pain / opportunity?)

## Users / context
(Who is this for? Constraints?)

## Non-goals
- …

## Acceptance criteria
(Testable — Given/When/Then or checklist)

## Risks / trust boundaries
(Auth, data, fail-open, deploy?)

## Open tradeoffs (with agent recommendation each)
1. … — **rec:** …

## Ratification
- by:
- at:
- notes: (human product decisions)
EOF
  echo "Wrote $f (light scaffold). Fill AC, then build — or: plinth plan --deep"
}

# One plan-review seat via a vendor CLI (read-only). Prints body to stdout.
_plan_seat_call() {
  local vendor="$1" model="$2" role="$3" plan_body="$4"
  local prompt margs=() unavail
  unavail="(seat $role unavailable: $vendor CLI missing or failed)"
  prompt="You are an independent PLAN REVIEWER (role: $role), not the author and not the driver.
Read-only. Do not implement. Critique the PRODUCT PLAN only.

Role focus:
- security_ops: trust boundaries, fail-open, secrets, auth, deploy/rollback gaps
- completeness: testable AC, non-goals, demo/done definition, scope holes
- delete_simplify: question every requirement; cut non-load-bearing scope; overbuild

Output markdown EXACTLY in this shape (bullets must start with \"- \"):
### Seat: $role
#### Blockers
- … (or a single line: - none)
#### Questions for human
- … (or: - none)
#### Nits
- … (or: - none)
#### One-line verdict
…

Also append a fenced JSON block (for machine merge):
\`\`\`json
{\"seat\":\"$role\",\"blockers\":[\"...\"],\"questions\":[\"...\"],\"nits\":[\"...\"],\"verdict\":\"...\"}
\`\`\`
Use empty arrays when none.

PLAN:
$plan_body"
  case "$vendor" in
    claude)
      [ -n "$model" ] && margs=(--model "$model")
      printf '%s' "$prompt" | claude -p --safe-mode ${margs[@]+"${margs[@]}"} --permission-mode dontAsk \
        --allowed-tools "Read,Grep,Glob" 2>/dev/null || echo "$unavail"
      ;;
    codex)
      [ -n "$model" ] && margs=(-m "$model")
      printf '%s' "$prompt" | codex exec -c project_doc_max_bytes=0 ${margs[@]+"${margs[@]}"} \
        --sandbox read-only - 2>/dev/null || echo "$unavail"
      ;;
    grok)
      [ -n "$model" ] && margs=(-m "$model")
      grok -p "$prompt" --sandbox read-only \
        --rules 'You are a read-only plan reviewer. Advise only — never implement.' \
        ${margs[@]+"${margs[@]}"} 2>/dev/null || echo "$unavail"
      ;;
    *)
      echo "(seat $role: unsupported vendor '$vendor')"
      ;;
  esac
}

run_plan() {
  local root="$1" deep="${2:-0}"
  local cfg planf body ts
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || { echo "plinth plan: not a git repo: $root" >&2; exit 1; }
  _plan_scaffold "$root"
  planf="$root/PLAN.md"
  [ -f "$planf" ] || { echo "plinth plan: PLAN.md missing after scaffold" >&2; exit 1; }

  if [ "$deep" != 1 ]; then
    echo "Plan depth: light (scaffold only)."
    echo "  Edit $planf — fill Problem, AC, risks."
    echo "  New product / fuzzy scope: plinth plan --deep \"$root\""
    echo "  Then build; when ready to ship: plinth harden && ./.plinth/review.sh"
    return 0
  fi

  # Deep: parallel independent seats (best-effort vendors from project config).
  cfg="$root/.plinth/config"
  # Missing config must not abort under pipefail — defaults apply.
  aval() {
    [ -f "$cfg" ] || { printf ''; return 0; }
    sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" "$cfg" 2>/dev/null | head -1 || true
  }
  local rv am av rm amodel
  rv="$(aval reviewer_vendor)"; [ -n "$rv" ] || rv=codex
  av="$(aval audit_vendor)"; [ -n "$av" ] || av=claude
  rm="$(aval reviewer_model_tier2)"; [ -n "$rm" ] || rm="$(aval reviewer_model_tier1)"
  amodel="$(aval audit_model)"
  # Third seat: advisor vendor if distinct, else same as primary with different role.
  local tv tm
  tv="$(aval advisor_vendor)"; [ -n "$tv" ] || tv="$rv"
  tm="$(aval advisor_model_max)"; [ -n "$tm" ] || tm="$(aval advisor_model)"

  body="$(cat "$planf")"
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  local d1 d2 d3 o1 o2 o3
  d1="$(mktemp)"; d2="$(mktemp)"; d3="$(mktemp)"
  o1="$(mktemp)"; o2="$(mktemp)"; o3="$(mktemp)"
  trap 'rm -f "$d1" "$d2" "$d3" "$o1" "$o2" "$o3"' RETURN

  echo "plinth plan --deep: launching 3 independent seats (parallel)…" >&2
  ( cd "$root" && _plan_seat_call "$rv" "$rm" "security_ops" "$body" >"$o1" 2>"$d1" ) &
  local p1=$!
  ( cd "$root" && _plan_seat_call "$av" "$amodel" "completeness" "$body" >"$o2" 2>"$d2" ) &
  local p2=$!
  ( cd "$root" && _plan_seat_call "$tv" "$tm" "delete_simplify" "$body" >"$o3" 2>"$d3" ) &
  local p3=$!
  wait "$p1" "$p2" "$p3" || true

  local out="$root/PLAN-REVIEW.md" merge_json="$root/.plinth/session/plan-review-merge.json"
  mkdir -p "$root/.plinth/session"
  # Structured merge: extract JSON fences if present, else scrape markdown #### Blockers bullets.
  python3 - "$o1" "$o2" "$o3" "$merge_json" <<'PY'
import json, re, sys
paths, outj = sys.argv[1:4], sys.argv[4]
roles_default = ["security_ops", "completeness", "delete_simplify"]
seats = []
for i, p in enumerate(paths):
    text = open(p, encoding="utf-8", errors="replace").read()
    role = roles_default[i]
    m = re.search(r"```json\s*(\{.*?\})\s*```", text, re.S)
    data = None
    if m:
        try:
            data = json.loads(m.group(1))
        except Exception:
            data = None
    if not isinstance(data, dict):
        def section(name):
            mm = re.search(rf"#### {re.escape(name)}\s*\n(.*?)(?=\n#### |\n### |\Z)", text, re.S | re.I)
            if not mm:
                return []
            body = mm.group(1)
            items = []
            for line in body.splitlines():
                line = line.strip()
                if line.startswith("- "):
                    item = line[2:].strip()
                    if item and item.lower() not in ("none", "n/a", "…", "..."):
                        items.append(item)
            return items
        data = {
            "seat": role,
            "blockers": section("Blockers"),
            "questions": section("Questions for human"),
            "nits": section("Nits"),
            "verdict": "",
            "raw_ok": False,
        }
    else:
        data.setdefault("seat", role)
        for k in ("blockers", "questions", "nits"):
            if not isinstance(data.get(k), list):
                data[k] = []
        data["raw_ok"] = True
    seats.append(data)

def norm(s):
    return re.sub(r"\s+", " ", s.strip().lower())[:120]

blockers, questions, nits = [], [], []
seen_b, seen_q, seen_n = set(), set(), set()
for s in seats:
    seat = s.get("seat") or "?"
    for b in s.get("blockers") or []:
        k = norm(str(b))
        if k and k not in seen_b:
            seen_b.add(k)
            blockers.append({"text": str(b), "seats": [seat], "security": seat == "security_ops"})
        elif k in seen_b:
            for x in blockers:
                if norm(x["text"]) == k and seat not in x["seats"]:
                    x["seats"].append(seat)
    for q in s.get("questions") or []:
        k = norm(str(q))
        if k and k not in seen_q:
            seen_q.add(k)
            questions.append({"text": str(q), "seats": [seat]})
        elif k in seen_q:
            for x in questions:
                if norm(x["text"]) == k and seat not in x["seats"]:
                    x["seats"].append(seat)
    for n in s.get("nits") or []:
        k = norm(str(n))
        if k and k not in seen_n:
            seen_n.add(k)
            nits.append({"text": str(n), "seats": [seat]})

# majority: 2+ seats listed same blocker
for b in blockers:
    b["label"] = "majority_blocker" if len(b["seats"]) >= 2 else "minority_blocker"
    if b.get("security"):
        b["label"] = "security_" + b["label"]

merge = {
    "seats": seats,
    "blockers": blockers,
    "questions": questions,
    "nits": nits,
    "open_blocker_count": len(blockers),
    "open_question_count": len(questions),
}
with open(outj, "w", encoding="utf-8") as f:
    json.dump(merge, f, indent=2)
print(json.dumps({"blockers": len(blockers), "questions": len(questions), "nits": len(nits)}))
PY

  local merge_stats
  merge_stats=$(python3 -c 'import json; d=json.load(open("'"$merge_json"'")); print(d["open_blocker_count"], d["open_question_count"], len(d.get("nits") or []))' 2>/dev/null || echo "0 0 0")

  {
    echo "# Plan review — deep (structured merge)"
    echo
    echo "Updated: $ts"
    echo "Seats: security_ops ($rv${rm:+ /$rm}) · completeness ($av${amodel:+ /$amodel}) · delete_simplify ($tv${tm:+ /$tm})"
    echo "Machine merge: \`.plinth/session/plan-review-merge.json\`"
    echo
    echo "Human: resolve **Merged blockers** and **Questions** before treating the plan as ratified."
    echo "Labels are advisory (majority = 2+ seats); you adjudicate. Security-tagged items stay visible even if minority."
    echo
    echo "## Merged blockers (checklist)"
    echo
    python3 - "$merge_json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
bs = d.get("blockers") or []
if not bs:
    print("- [ ] _(none extracted — read raw seats below)_")
else:
    for b in bs:
        seats = ",".join(b.get("seats") or [])
        lab = b.get("label") or "blocker"
        print(f"- [ ] **[{lab}]** {b.get('text','')} _(seats: {seats})_")
PY
    echo
    echo "## Merged questions for human"
    echo
    python3 - "$merge_json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
qs = d.get("questions") or []
if not qs:
    print("- [ ] _(none)_")
else:
    for q in qs:
        seats = ",".join(q.get("seats") or [])
        print(f"- [ ] {q.get('text','')} _(seats: {seats})_")
PY
    echo
    echo "## Merged nits (non-blocking)"
    echo
    python3 - "$merge_json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
ns = d.get("nits") or []
if not ns:
    print("- _(none)_")
else:
    for n in ns:
        print(f"- {n.get('text','')}")
PY
    echo
    echo "---"
    echo
    echo "## Raw: security_ops"
    echo
    cat "$o1"
    echo
    echo "---"
    echo
    echo "## Raw: completeness"
    echo
    cat "$o2"
    echo
    echo "---"
    echo
    echo "## Raw: delete_simplify"
    echo
    cat "$o3"
    echo
    echo "---"
    echo
    echo "## Human adjudication"
    echo "- [ ] All merged blockers addressed or dismissed with reason"
    echo "- [ ] Product tradeoffs decided"
    echo "- [ ] PLAN.md updated (bump product_rev if AC/scope changed)"
  } > "$out"

  echo "Wrote $out (merged blockers/questions; stats: $merge_stats)"
  # Security-tagged majority blockers → NEEDS-HUMAN [BLOCKING] so plinth next stops that path.
  local nhf
  nhf="$(needs_human_file "$root")"
  mkdir -p "$(dirname "$nhf")"
  python3 - "$merge_json" "$nhf" <<'PY' 2>/dev/null || true
import json, sys, os
merge, nhf = sys.argv[1], sys.argv[2]
d = json.load(open(merge))
items = []
for b in d.get("blockers") or []:
    lab = b.get("label") or ""
    if "security" in lab or (b.get("security") and "majority" in lab):
        items.append(f"- [ ] [BLOCKING] plan-review: {b.get('text','')}")
    elif "majority" in lab:
        items.append(f"- [ ] plan-review: {b.get('text','')}")
if not items:
    sys.exit(0)
existing = open(nhf, encoding="utf-8").read() if os.path.isfile(nhf) else "# NEEDS-HUMAN\n\n"
for it in items:
    if it[6:] not in existing:  # rough dedupe on text after checkbox
        existing = existing.rstrip() + "\n" + it + "\n"
open(nhf, "w", encoding="utf-8").write(existing)
print(f"NEEDS-HUMAN: appended {len(items)} plan-review item(s)")
PY
  _write_handoff "$root" "plan-deep" "Resolve PLAN-REVIEW.md merged blockers (or plinth next); update PLAN.md; then implement."
  echo "Next: human resolves questions → edit PLAN.md → build → plinth harden when ready to ship."
  echo "Or: plinth next \"$root\""
}

# Single next action for autonomous drivers. Exit: 0=action, 2=human-blocked, 3=done.
run_next() {
  local root="${1:-$target}"
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || { echo "plinth next: not a git repo: $root" >&2; exit 1; }
  local slug phase vfile verdict vsha head nhf
  slug=$(_lifecycle_slug "$root")
  phase=$(_lifecycle_read_phase "$root")
  head=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo "?")
  vfile="$(_lifecycle_verdict_file "$root")"
  verdict=""; vsha=""
  if [ -f "$vfile" ]; then
    verdict=$(jq -r '.verdict // empty' "$vfile" 2>/dev/null || true)
    vsha=$(jq -r '.sha // empty' "$vfile" 2>/dev/null || true)
  fi
  nhf="$(needs_human_file "$root" 2>/dev/null || echo "")"
  local blocking=""
  if [ -n "$nhf" ] && [ -s "$nhf" ]; then
    blocking=$(open_items "$nhf" 2>/dev/null | grep '^\[BLOCKING\]' | head -1 || true)
  fi
  if [ -n "$blocking" ]; then
    echo "status: human_blocked"
    echo "action: resolve NEEDS-HUMAN blocking item"
    echo "detail: $blocking"
    echo "phase: $phase"
    exit 2
  fi

  # Open plan-review blockers (unchecked checklist)
  if [ -f "$root/PLAN-REVIEW.md" ]; then
    local pb
    pb=$(grep -E '^- \[ \] \*\*\[.*blocker' "$root/PLAN-REVIEW.md" 2>/dev/null | head -1 || true)
    if [ -z "$pb" ]; then
      pb=$(grep -E '^- \[ \] \*\*\[' "$root/PLAN-REVIEW.md" 2>/dev/null | head -1 || true)
    fi
    if [ -n "$pb" ]; then
      echo "status: work"
      echo "action: resolve plan-review blocker (human if product tradeoff)"
      echo "detail: $pb"
      echo "hint: edit PLAN.md / check off PLAN-REVIEW.md; then plinth next"
      exit 0
    fi
  fi

  # Harden path: open review findings
  if [ "$phase" = "harden" ]; then
    local full
    full=$(git -C "$root" rev-parse HEAD 2>/dev/null || true)
    if [ "$verdict" = "APPROVED" ] && [ -n "$vsha" ] && [ -n "$full" ] && [ "$vsha" = "$full" ]; then
      echo "status: work"
      echo "action: open PR (APPROVED@HEAD)"
      echo "detail: gh pr create — ship gate satisfied at $head"
      exit 0
    fi
    # Stale APPROVED (or APPROVED with missing sha) — ship gate unsatisfied; re-review.
    if [ "$verdict" = "APPROVED" ]; then
      echo "status: work"
      echo "action: re-run ./.plinth/review.sh (APPROVED but not at HEAD — ship gate unsatisfied)"
      echo "detail: phase=harden head=$head verdict_sha=${vsha:-none} HEAD=$full"
      exit 0
    fi
    # Check latest findings for open majors (basename numeric N — not full-path sort)
    local fdir latest
    fdir="$(_lifecycle_review_dir "$root")"
    latest=$(_latest_findings_json "$fdir")
    if [ -n "$latest" ] && [ -f "$latest" ]; then
      local openf
      openf=$(jq -r '[.findings[]|select(.status=="open" and (.severity=="blocker" or .severity=="major"))][0]
        | if . then "[\(.severity)] \(.file):\(.line) — \(.description[0:120])" else empty end' "$latest" 2>/dev/null || true)
      if [ -n "$openf" ]; then
        echo "status: work"
        echo "action: fix review finding, commit, re-run ./.plinth/review.sh"
        echo "detail: $openf"
        exit 0
      fi
    fi
    if [ "$verdict" != "APPROVED" ]; then
      echo "status: work"
      echo "action: run ./.plinth/review.sh (harden phase, no APPROVED@HEAD)"
      echo "detail: phase=harden head=$head verdict=${verdict:-none}"
      exit 0
    fi
  fi

  # BUILD: open review majors still route (checkpoint mid-loop), not only harden.
  if [ "$phase" != "harden" ]; then
    local fdir latest openf
    fdir="$(_lifecycle_review_dir "$root")"
    latest=$(_latest_findings_json "$fdir")
    if [ -n "$latest" ] && [ -f "$latest" ]; then
      openf=$(jq -r '[.findings[]|select(.status=="open" and (.severity=="blocker" or .severity=="major"))][0]
        | if . then "[\(.severity)] \(.file):\(.line) — \(.description[0:120])" else empty end' "$latest" 2>/dev/null || true)
      if [ -n "$openf" ]; then
        echo "status: work"
        echo "action: fix review finding, commit, re-run ./.plinth/review.sh"
        echo "detail: phase=build $openf"
        exit 0
      fi
    fi
  fi

  # HANDOFF ## Next first actionable line
  if [ -f "$root/HANDOFF.md" ]; then
    local nxt
    nxt=$(awk '/^## Next/{p=1;next} p&&/^## /{exit} p' "$root/HANDOFF.md" \
      | sed -n 's/^[[:space:]]*[0-9]*[.)]*[[:space:]]*//p; s/^-[[:space:]]*//p' \
      | grep -v '^$' | grep -viE '^\(edit|^\.\.\.|^…' | head -1 || true)
    if [ -n "$nxt" ]; then
      echo "status: work"
      echo "action: $nxt"
      echo "detail: from HANDOFF.md ## Next (phase=$phase)"
      exit 0
    fi
  fi

  # Nothing left in Next / NH / open review majors — done (both phases).
  echo "status: done"
  echo "action: none"
  echo "detail: no open next / blocking items detected (phase=$phase head=$head)"
  exit 3
}

# On plinth update: migrate open review loops → harden phase; corrupt phase → fail closed harden.
# Always scans phase-*.json (even with no review/ dir) plus every review slug.
migrate_lifecycle_phases() {
  local root="$1" sdir revdir
  sdir="$root/.plinth/session"
  [ -d "$sdir" ] || return 0
  local phasef slug d vfile v base
  # 1) All phase files — corrupt / unknown → harden (no review dir required).
  for phasef in "$sdir"/phase-*.json; do
    [ -f "$phasef" ] || continue
    base=$(basename "$phasef")
    slug=${base#phase-}; slug=${slug%.json}
    if ! jq -e '.phase == "build" or .phase == "harden"' "$phasef" >/dev/null 2>&1; then
      echo "  lifecycle migrate: corrupt $base → harden (fail closed)"
      jq -n --arg p harden --arg slug "$slug" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{phase:$p, slug:$slug, updated_at:$ts, migrated:true, reason:"corrupt_phase"}' > "$phasef"
    fi
  done
  # 2) Open review verdicts → ensure harden phase.
  revdir="$sdir/review"
  [ -d "$revdir" ] || return 0
  for d in "$revdir"/*/; do
    [ -d "$d" ] || continue
    slug=$(basename "$d")
    phasef="$sdir/phase-$slug.json"
    vfile="$d/verdict.json"
    [ -f "$vfile" ] || continue
    v=$(jq -r '.verdict // empty' "$vfile" 2>/dev/null || true)
    case "$v" in
      CHANGES_NEEDED|UNBOUND)
        if [ ! -f "$phasef" ] || [ "$(jq -r '.phase // empty' "$phasef" 2>/dev/null)" != "harden" ]; then
          echo "  lifecycle migrate: $slug verdict=$v → phase harden"
          jq -n --arg p harden --arg slug "$slug" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --arg v "$v" \
            '{phase:$p, slug:$slug, updated_at:$ts, migrated:true, reason:("open_review_"+$v)}' > "$phasef"
        fi
        ;;
    esac
  done
}

case "$cmd" in
  statusline) statusline_render ;;
  advise) run_advise "$@" ;;
  hookprobe) run_hookprobe "$@" ;;
  changelog-collate) run_changelog_collate "$@" ;;
  queue) run_queue ;;
  smoke) run_smoke "$@" ;;
  watch) watch_project ;;
  dash|dashboard) run_dashboard "$@" ;;
  harden) run_harden "$target" ;;
  build) run_build_phase "$target" ;;
  phase) run_phase_status "$target" ;;
  handoff) run_handoff "$target" ;;
  plan) run_plan "$target" "$PLAN_DEEP" ;;
  next) run_next "$target" ;;
  lifecycle-migrate)
    migrate_lifecycle_phases "$target"
    echo "plinth lifecycle-migrate: done for $target"
    ;;
  init)
    preflight_reserved_lanes
    copy_templates_if_absent
    copy_shared
    # Backfill security patterns even on init: a re-run (or a partially-scaffolded repo)
    # may already have a pre-v4.4 .plinth/protected-paths that copy_templates_if_absent
    # keeps as-is, so the new contract-file patterns (reviewer.md, CLAUDE.md, AGENTS.md)
    # would otherwise be missing. Idempotent — a fresh template already has them.
    ensure_protected_paths
    github_preflight
    warn_missing_gate_wiring
    echo "Plinth $PLINTH_VERSION initialized in $target"
    echo "Next: edit SPEC.md; commit. (ci.yml is zero-edit: owner auto-injected, checks auto-detect the stack at CI time.)"
    ;;
  update)
    [ -f "$target/.plinth-version" ] || { echo "Not a Plinth project (no .plinth-version). Run 'plinth init' first."; exit 1; }
    old="$(cat "$target/.plinth-version")"
    preflight_reserved_lanes
    warn_live_review
    copy_templates_if_absent
    copy_shared
    ensure_protected_paths
    migrate_needs_human
    migrate_lifecycle_phases "$target"
    # Tier-2 cross-vendor audit needs audit_vendor; init sets it but existing
    # configs are preserved, so remind upgraded projects (MANUAL.md points here).
    # The audit only runs when audit_vendor DIFFERS from the primary reviewer_vendor,
    # so suggest a different one than whatever this project's primary is.
    if ! grep -q '^audit_vendor' "$target/.plinth/config" 2>/dev/null; then
      rv="$(sed -n 's/^reviewer_vendor[[:space:]]*=[[:space:]]*//p' "$target/.plinth/config" 2>/dev/null | head -1)"
      [ -n "$rv" ] || rv=codex
      # v4 seats: the claude audit is the recommended second opinion (a different
      # family than both the grok driver and a codex/grok primary); a claude
      # PRIMARY can't audit itself, so it gets grok.
      case "$rv" in claude) sug=grok ;; *) sug=claude ;; esac
      # The suggested value is a SINGLE valid vendor (copy-pastable); agy is offered in
      # prose OUTSIDE the config line so it is never pasted as part of the value.
      # An unset audit_vendor DEFAULTS to codex in review.sh, so the audit is OFF only when
      # the primary is also codex; for a claude/grok primary the codex default already runs.
      if [ "$rv" = codex ]; then
        echo "  note: audit_vendor unset — it defaults to codex == reviewer_vendor (codex), so Tier 2 approvals get NO cross-vendor second opinion. Add 'audit_vendor = $sug' (or 'agy') to .plinth/config."
      else
        echo "  note: audit_vendor unset — it defaults to codex, which differs from reviewer_vendor ($rv), so the cross-vendor audit already runs with codex. Add 'audit_vendor = $sug' (or 'agy') to pin the auditor explicitly."
      fi
    fi
    github_preflight
    warn_missing_gate_wiring
    warn_stale_reusable_refs
    echo "Plinth updated in $target: $old -> $PLINTH_VERSION"
    echo "Review before committing: git -C \"$target\" diff"
    ;;
  goal)
    if [ -f "$target/GOAL.md" ]; then
      echo "GOAL.md already exists in $target — not overwriting."
      exit 1
    fi
    cp "$PLINTH_ROOT/templates/GOAL.template.md" "$target/GOAL.md"
    echo "GOAL.md draft created in $target."
    echo "Workflow: have the driver draft the specifics -> YOU ratify (STATUS: RATIFIED)"
    echo "-> add the eval script pattern to .plinth/protected-paths -> have Codex attack"
    echo "the rubric for gameability -> then let the loop run."
    ;;
  *) usage ;;
esac
