#!/usr/bin/env bash
# Plinth CLI v4.8.0 — scaffold and update projects from a pinned Plinth release.
#
#   plinth init   <project-path>  Bootstrap: create per-project files (only where
#                                 absent) + copy shared files. Idempotent.
#   plinth watch  <project-path>  Live session dashboard (task, stage pipeline,
#                                 tokens, burn, review/gate state). --once for a
#                                 single frame.
#   plinth dash|dashboard         Multi-instance HTML wallboard on 127.0.0.1
#                                 (--snapshot for offline JSON; --port N).
#   plinth update <project-path>  Propagate a Plinth version to an existing project:
#                                 refresh shared files (always overwritten), backfill
#                                 any per-project files new to this Plinth version
#                                 (created only if absent). Your per-project files are
#                                 not rewritten, with TWO managed exceptions:
#                                 .plinth/protected-paths gets new plinth-managed
#                                 security patterns appended (your lines preserved), and
#                                 a legacy root NEEDS-HUMAN.md is migrated into .plinth/
#                                 (warns instead of clobbering if both exist).
#                                 Reports the version transition. Refuses to run on a
#                                 directory that isn't already a Plinth project.
#   plinth goal   <project-path>  Drop a GOAL.md draft (auto-research mode) if absent.
#
# Operates from the Plinth checkout it lives in. To adopt a new Plinth version:
# `git -C <plinth> pull` (or checkout a tag), then `plinth update <project>`.
set -euo pipefail

# Resolve symlinks so PLINTH_ROOT is the real checkout, not the symlink's dir.
# (A naive dirname "$BASH_SOURCE" resolves to /usr/local when invoked via the
#  /usr/local/bin/plinth symlink, breaking every subcommand. Do not simplify.)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$DIR/$SOURCE"  # relative link -> absolute
done
PLINTH_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
PLINTH_VERSION="$(cat "$PLINTH_ROOT/VERSION" 2>/dev/null || echo "unknown")"

usage() { echo "Usage: plinth {init|update|goal|watch|statusline|queue} <project-path> [--once]
       plinth smoke <project-path> -- <command...>   (run + write execution receipt)
       plinth queue <project-path>                   (full NEEDS-HUMAN queue, untruncated)
       plinth advise [--impactful] \"<question>\"       (consult a stronger model, read-only; runs in CWD)
       plinth hookprobe <grok|codex>                 (does this CLI EXECUTE wired .claude hooks? one model call)
       plinth changelog-collate [<target-repo>]      (fold changelog.d/*.md into CHANGELOG.md + VERSION)
       plinth dash|dashboard [--snapshot] [--port N] (multi-instance HTML wallboard on 127.0.0.1)"; exit 1; }
[ $# -ge 1 ] || usage
cmd="$1"; target="${2:-}"; opt="${3:-}"
if [ "$cmd" = "statusline" ] || [ "$cmd" = "advise" ] || [ "$cmd" = "hookprobe" ] || [ "$cmd" = "changelog-collate" ] \
   || [ "$cmd" = "dash" ] || [ "$cmd" = "dashboard" ]; then
  :  # statusline: project path optional (falls back to statusLine JSON on stdin).
     # advise: operates on the CWD; its args are the question, not a project path.
     # hookprobe: probes a vendor CLI in a scratch repo; its arg is a vendor, not a path.
     # changelog-collate: optional target-repo (defaults to CWD); validated in the handler.
     # dash/dashboard: multi-repo wallboard; no project path (see run_dashboard).
elif [ -z "$target" ]; then
  usage
elif [ ! -d "$target" ]; then
  echo "No such directory: $target"; exit 1
fi

# Portable in-place edit (macOS + Linux): sed to a temp file in the SAME dir (so mv is atomic), then
# move. The temp path is created UNPREDICTABLY via mktemp (O_EXCL) — never a predictable sibling like
# `${f}.plinth-tmp` a repo could precreate as a symlink/hardlink to an external target and be written
# through before the mv (path-escape / clobber).
edit_file() {  # edit_file <file> <sed-expr>...
  local f="$1"; shift
  # Read the ORIGINAL mode FIRST and fail closed if it can't be established: mktemp creates 0600,
  # so a swallowed chmod would move a 0600 (group/other-UNREADABLE) file into place — the exact
  # regression this preservation exists to prevent (e.g. a generated ci.yml unreadable until git
  # recreates it). GNU (-c) first; BSD (-f) fallback. Must be octal digits.
  local mode; mode="$(stat -c '%a' "$f" 2>/dev/null || stat -f '%Lp' "$f" 2>/dev/null)"
  case "$mode" in ''|*[!0-7]*) echo "edit_file: cannot determine the mode of $f (stat failed) — refusing to rewrite it (fail closed)" >&2; exit 1 ;; esac
  local tmp; tmp="$(mktemp "$(dirname "$f")/.plinth-tmp.XXXXXX")" || { echo "edit_file: mktemp failed for $f" >&2; exit 1; }
  chmod "$mode" "$tmp" || { rm -f "$tmp"; echo "edit_file: could not apply mode $mode to the temp for $f — refusing (fail closed, would leave it 0600/unreadable)" >&2; exit 1; }
  sed "$@" "$f" > "$tmp" && mv "$tmp" "$f" || { rm -f "$tmp"; echo "edit_file: failed to rewrite $f" >&2; exit 1; }
}

# Install a managed file by writing a same-directory temp and renaming it over
# the destination. Bash reads scripts incrementally, so truncating an existing
# review.sh during `plinth update` can crash a round already running from that
# inode. rename(2) leaves the running inode intact. Preserve the destination's
# exact mode on refresh; for a new file, preserve the source's exact mode.
copy_managed_file() {  # <src> <dst>
  local src="$1" dst="$2" mode tmp
  if [ -e "$dst" ]; then
    mode="$(stat -c '%a' "$dst" 2>/dev/null || stat -f '%Lp' "$dst" 2>/dev/null)"
  else
    mode="$(stat -c '%a' "$src" 2>/dev/null || stat -f '%Lp' "$src" 2>/dev/null)"
  fi
  case "$mode" in ''|*[!0-7]*) echo "copy_managed_file: cannot determine mode for $dst — refusing to replace it" >&2; exit 1 ;; esac
  tmp="$(mktemp "$(dirname "$dst")/.plinth-tmp.XXXXXX")" \
    || { echo "copy_managed_file: mktemp failed for $dst" >&2; exit 1; }
  cp "$src" "$tmp" \
    && chmod "$mode" "$tmp" \
    && mv -f "$tmp" "$dst" \
    || { rm -f "$tmp"; echo "copy_managed_file: failed to install $dst" >&2; exit 1; }
}

# NEEDS-HUMAN queue path — canonical is .plinth/NEEDS-HUMAN.md; tolerate a legacy
# root copy (some projects kept it there) so the queue and dashboard still find it.
# `plinth update` migrates a root copy into .plinth/ (see migrate_needs_human).
needs_human_file() {  # <dir> -> active NEEDS-HUMAN.md path (canonical preferred)
  if [ -f "$1/.plinth/NEEDS-HUMAN.md" ]; then echo "$1/.plinth/NEEDS-HUMAN.md"
  elif [ -f "$1/NEEDS-HUMAN.md" ]; then echo "$1/NEEDS-HUMAN.md"
  else echo "$1/.plinth/NEEDS-HUMAN.md"; fi
}
migrate_needs_human() {  # move a legacy root NEEDS-HUMAN.md into .plinth/ (canonical)
  local root="$target/NEEDS-HUMAN.md" canon="$target/.plinth/NEEDS-HUMAN.md"
  [ -f "$root" ] || return 0
  if [ -f "$canon" ]; then
    echo "  NOTE: NEEDS-HUMAN.md exists at BOTH repo root and .plinth/ — canonical is"
    echo "        .plinth/; merge the root copy in by hand and delete it."
  else
    mkdir -p "$target/.plinth"; mv "$root" "$canon"
    echo "  migrated: NEEDS-HUMAN.md -> .plinth/NEEDS-HUMAN.md (canonical location)"
  fi
}

# Detect the GitHub owner for ci.yml injection. Chain: target repo's origin ->
# this Plinth checkout's origin -> git config github.user -> empty (warn).
# Parses both git@github.com:owner/repo.git and https://github.com/owner/repo(.git).
detect_owner() {
  local url owner
  for repo in "$target" "$PLINTH_ROOT"; do
    url="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
    if [ -n "$url" ]; then
      owner="$(printf '%s' "$url" | sed -E 's#^(git@[^:]+:|https?://[^/]+/)([^/]+)/.*#\2#')"
      if [ -n "$owner" ] && [ "$owner" != "$url" ]; then printf '%s' "$owner"; return 0; fi
    fi
  done
  owner="$(git config github.user 2>/dev/null || true)"
  [ -n "$owner" ] && { printf '%s' "$owner"; return 0; }
  printf ''
}

# Materialize the DRIVER contract shell into BOTH CLAUDE.md and AGENTS.md
# (byte-identical). Whichever a vendor auto-loads delivers the driver role:
# Claude reads CLAUDE.md (and expands the @import); codex reads AGENTS.md; grok
# reads both. AGENTS.md was ALWAYS a pinned copy (reviewer contract pre-v4.4.0,
# driver shell now) — safe to (re)generate unconditionally. CLAUDE.md was
# historically per-project (held user "Project-specific notes"), so only
# (re)generate it when absent or already a stock shell; otherwise PRESERVE it and
# tell the human to move notes into .plinth/DRIVER-project.md (no auto-extraction —
# marker-parsing a user-edited file is a known bug class).
DRIVER_SHELL_MARKER="Plinth driver shell (version-pinned)"
# True if $1 is the pre-v4.4 STOCK driver CLAUDE.md: the WHOLE file equals the retired
# templates/CLAUDE.md verbatim (whitespace-normalized: per-line trim, blank lines
# dropped). Whole-file — not marker/section — comparison, because custom content can
# live ANYWHERE (a rule added above the notes heading, notes inside the placeholder
# comment); only a byte-honest match proves there is nothing to lose, so `update` may
# regenerate it as the new shell (the migration the CHANGELOG promises). ANY deviation
# — including an older template revision we do not recognize — is treated as custom and
# preserved with the migration NOTE: a false "custom" costs a 30-second manual step, a
# false "stock" destroys user content.
is_stock_old_claude() {
  local f="$1" norm ref
  norm="$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$f" 2>/dev/null | grep -v '^$' || true)"
  ref="$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<'OLDSTOCK' | grep -v '^$'
# CLAUDE.md

You are the implementer for this repository. The canonical spec (see `spec_path` in `.plinth/config`; default `SPEC.md`) is the source of truth —
read it before implementing. Model and orchestration guidance: `.plinth/MODELS.md`.

@.plinth/plinth-rules.md

## Precedence — these rules override defaults
Where this file or the plinth rules conflict with harness defaults, output
styles, or personal/global preferences, PLINTH RULES WIN. Standing exceptions
you must apply without being asked:
- COMMIT your work on feature branches as part of the loop — do not wait for
  permission. Verdicts bind to commit SHAs and the Stop gate requires an
  APPROVED review at HEAD; a driver that waits to be asked deadlocks itself.
  (Opening the PR follows review; pushing follows the rules, not impulse.)
- Rule 10 evidence — pasted runner output — overrides any brevity or style
  preference, always.
- If a personal or global instruction conflicts with the plinth rules, follow
  the plinth rules and SAY you did; never silently blend the two.

## Project-specific notes
<!-- Anything unique to THIS project: domain constraints, hard "never do" rules,
     stack quirks. Shared Plinth rules import above; this section is yours and is
     never overwritten by `plinth update`. -->
OLDSTOCK
)"
  [ -n "$norm" ] && [ "$norm" = "$ref" ]
}
materialize_driver_shell() {
  copy_managed_file "$PLINTH_ROOT/shared/driver-shell.md" "$target/AGENTS.md"
  local c="$target/CLAUDE.md"
  if [ ! -f "$c" ] || grep -qF "$DRIVER_SHELL_MARKER" "$c" 2>/dev/null || is_stock_old_claude "$c"; then
    copy_managed_file "$PLINTH_ROOT/shared/driver-shell.md" "$c"   # absent, already-shell, or stock old -> (re)generate
  else
    echo "  NOTE: $c has CUSTOM content — NOT overwritten. The v4.4.0 driver contract"
    echo "        is a pinned shell (CLAUDE.md + AGENTS.md, regenerated) plus"
    echo "        .plinth/DRIVER-project.md for your notes. Move your"
    echo "        '## Project-specific notes' into .plinth/DRIVER-project.md, then delete"
    echo "        CLAUDE.md and re-run 'plinth update' to regenerate the shell."
  fi
}

# The two lane-agent filenames are RESERVED for version-pinned Plinth tooling (protected-path +
# HARNESS-classified by path). Refresh the pinned copy freely, but if a NON-Plinth file already
# occupies that exact path (no pin marker = project-authored), do NOT clobber it and do NOT leave a
# half-managed state (a preserved file would still get frozen/misclassified) — fail LOUD and abort so
# the user resolves it. Non-destructive: their file is untouched.
cp_lane_agent() {  # <src> <dst> — belt: preflight_reserved_lanes should have caught a collision first
  local src="$1" dst="$2" marker='Plinth implementer lane (version-pinned)'
  if [ -f "$dst" ] && ! grep -qF "$marker" "$dst" 2>/dev/null; then
    echo "ERROR: $dst exists and is NOT a Plinth lane agent. That filename is RESERVED for the Plinth" >&2
    echo "       implementer lane (version-pinned tooling). Rename or move your file, then re-run —" >&2
    echo "       refusing to overwrite it or leave it half-managed (protected/frozen but project-owned)." >&2
    exit 1
  fi
  copy_managed_file "$src" "$dst"
}
# Preflight the reserved lane-agent paths BEFORE any file is written, so a collision aborts with the
# repo UNTOUCHED — never a partial scaffold (protected-paths / settings.json / a new review.sh already
# installed while the project's colliding agent stays behind, frozen or misclassified).
# A managed FILE target must be ABSENT or a true regular file — reject a symlink (would clobber its
# external target), a directory (cp would copy INTO it, partial scaffold), or a FIFO/socket/device
# (cp would hang/misbehave). Used before any managed-file write.
reject_nonregular_file() {  # <path>
  if [ -L "$1" ]; then echo "ERROR: $1 is a symlink — refusing to write through it." >&2; exit 1; fi
  if [ -e "$1" ] && [ ! -f "$1" ]; then echo "ERROR: $1 is present but not a regular file (a directory or special file) — refusing." >&2; exit 1; fi
  # A HARDLINK (nlink > 1) shares its inode with a file elsewhere; cp/redirection would truncate that
  # shared inode and clobber the external target. Refuse rather than write through it.
  if [ -f "$1" ]; then
    # GNU (-c) first; BSD stat rejects -c and falls through to -f. Reverse order is WRONG: GNU
    # `stat -f '%l'` succeeds with filesystem status (not nlink), so the `||` never falls through.
    local n; n="$(stat -c '%h' "$1" 2>/dev/null || stat -f '%l' "$1" 2>/dev/null)"
    # FAIL CLOSED if the link count can't be determined (both stat forms failed / non-numeric):
    # defaulting to 1 would let a copy proceed and clobber an external hardlink (data loss).
    case "$n" in ''|*[!0-9]*) echo "ERROR: cannot determine link count of $1 (stat failed) — refusing to touch it (fail closed)." >&2; exit 1 ;; esac
    if [ "$n" -gt 1 ]; then echo "ERROR: $1 is a hardlink (nlink=$n) — refusing to overwrite a shared inode (would clobber the other link)." >&2; exit 1; fi
  fi
}
preflight_reserved_lanes() {
  local marker='Plinth implementer lane (version-pinned)' a dst parent="$target/.claude/agents" d f mansym
  # SYMLINK-ESCAPE CLASS — closed once, up front, before ANY write: init/update write many files and
  # dirs under the managed trees, and a symlink anywhere in that ancestry (a managed dir, an
  # intermediate, or a file leaf) would let a write follow it and clobber a target OUTSIDE the
  # workspace, or make a policy read return the wrong bytes. Refuse rather than write through any.
  # (1) managed DIRECTORIES + intermediates: never a symlink, never a non-directory.
  for d in .claude .claude/agents .claude/hooks .plinth .plinth/session .github .github/workflows; do
    if [ -L "$target/$d" ]; then
      echo "ERROR: $target/$d is a symlink — refusing to write through it (could escape the workspace)." >&2
      exit 1
    fi
    if [ -e "$target/$d" ] && [ ! -d "$target/$d" ]; then
      echo "ERROR: $target/$d exists but is not a directory — refusing to touch this repo until it is resolved." >&2
      exit 1
    fi
  done
  # (2) every managed FILE leaf that is unconditionally (re)written must be ABSENT or a real regular
  #     file — never a symlink, directory, FIFO, or device (else cp escapes / copies into a dir / hangs).
  #     Checked per Plinth-OWNED path only (NOT a whole-tree sweep) — a project's own .claude/agents/*
  #     or unrelated .github/* symlink must NOT block init/update.
  for f in \
    .plinth/plinth-rules.md .plinth/MODELS.md .plinth/review.sh .plinth/risk-classify.sh \
    .plinth/lane-guard.sh .plinth/receipt-verify.sh .plinth/review-schema.json .plinth/reviewer.md .plinth/protected-paths \
    .plinth/config .plinth/AGENTS-project.md .plinth/DRIVER-project.md \
    .claude/hooks/guard.sh .claude/hooks/session-start.sh .claude/hooks/review-gate.sh \
    .claude/hooks/pulse.sh .claude/settings.json .github/workflows/ci.yml .github/workflows/smoke.yml \
    SPEC.md .gitignore AGENTS.md CLAUDE.md .plinth-version; do
    reject_nonregular_file "$target/$f"
  done
  # (3) the NEEDS-HUMAN queue MIGRATION targets. update mv's a legacy root NEEDS-HUMAN.md into
  #     .plinth/NEEDS-HUMAN.md (migrate_needs_human). If the canonical DESTINATION is a directory,
  #     `mv` nests the queue inside it; if it (or the legacy SOURCE) is a symlink, `mv`/later reads
  #     follow it and move/expose the queue OUTSIDE the workspace. Reject any non-regular node at
  #     BOTH before update writes anything (absent is fine — the common case).
  for f in .plinth/NEEDS-HUMAN.md NEEDS-HUMAN.md; do
    reject_nonregular_file "$target/$f"
  done
  # (4) the two RESERVED lane-agent names.
  for a in grok-implementer codex-implementer; do
    dst="$parent/$a.md"
    # First reject any symlink / directory / FIFO / device / HARDLINK at the reserved path — same
    # write-through/escape guard as every other managed leaf (cp_lane_agent would otherwise clobber a
    # hardlink's external inode).
    reject_nonregular_file "$dst"
    # Now dst is ABSENT or a true regular file. A regular file WITHOUT the pin marker is project-
    # authored content occupying the RESERVED lane name — a collision; abort before any write.
    if [ -f "$dst" ] && ! grep -qF "$marker" "$dst" 2>/dev/null; then
      echo "ERROR: $dst is present but is not the Plinth lane agent (project-authored content). That" >&2
      echo "       path is RESERVED for the version-pinned Plinth implementer lane. Remove or rename" >&2
      echo "       it, then re-run — refusing to touch this repo." >&2
      exit 1
    fi
  done
}

# SHARED (version-pinned, overwritten on update):
copy_shared() {
  mkdir -p "$target/.plinth" "$target/.claude/hooks" "$target/.claude/agents"
  copy_managed_file "$PLINTH_ROOT/shared/plinth-rules.md"        "$target/.plinth/plinth-rules.md"
  copy_managed_file "$PLINTH_ROOT/shared/MODELS.md"              "$target/.plinth/MODELS.md"
  copy_managed_file "$PLINTH_ROOT/shared/.plinth/review.sh"      "$target/.plinth/review.sh"
  copy_managed_file "$PLINTH_ROOT/shared/.plinth/risk-classify.sh" "$target/.plinth/risk-classify.sh"
  copy_managed_file "$PLINTH_ROOT/shared/.plinth/lane-guard.sh"  "$target/.plinth/lane-guard.sh"
  copy_managed_file "$PLINTH_ROOT/shared/.plinth/receipt-verify.sh" "$target/.plinth/receipt-verify.sh"
  copy_managed_file "$PLINTH_ROOT/shared/.plinth/review-schema.json" "$target/.plinth/review-schema.json"
  copy_managed_file "$PLINTH_ROOT/shared/.claude/hooks/guard.sh" "$target/.claude/hooks/guard.sh"
  copy_managed_file "$PLINTH_ROOT/shared/.claude/hooks/session-start.sh" "$target/.claude/hooks/session-start.sh"
  copy_managed_file "$PLINTH_ROOT/shared/.claude/hooks/review-gate.sh"   "$target/.claude/hooks/review-gate.sh"
  copy_managed_file "$PLINTH_ROOT/shared/.claude/hooks/pulse.sh"         "$target/.claude/hooks/pulse.sh"
  # Lane agents live in .claude/agents/ — a namespace a project may ALSO use. The two lane filenames
  # are RESERVED: preflight_reserved_lanes() already aborted (repo untouched) if a non-Plinth file
  # occupied either path, so here we just refresh the pinned copy (cp_lane_agent re-checks as a belt).
  cp_lane_agent "$PLINTH_ROOT/shared/.claude/agents/grok-implementer.md"  "$target/.claude/agents/grok-implementer.md"
  cp_lane_agent "$PLINTH_ROOT/shared/.claude/agents/codex-implementer.md" "$target/.claude/agents/codex-implementer.md"
  copy_managed_file "$PLINTH_ROOT/shared/reviewer.md"           "$target/.plinth/reviewer.md"
  materialize_driver_shell
  # Exec-bit floor for managed scripts: heal a lost +x (archive restore, non-exec
  # FS, stripped checkout) without resetting other mode bits. copy_managed_file
  # preserves destination mode exactly; u+x only adds the missing execute bit.
  chmod u+x "$target/.plinth/review.sh" "$target/.plinth/risk-classify.sh" \
            "$target/.plinth/lane-guard.sh" "$target/.plinth/receipt-verify.sh" \
            "$target/.claude/hooks/guard.sh" "$target/.claude/hooks/session-start.sh" \
            "$target/.claude/hooks/review-gate.sh" "$target/.claude/hooks/pulse.sh"
  # Stamp from $PLINTH_VERSION (single source of truth). Not a managed script —
  # no rename atomicity needed; echo cannot fail mid-update the way a missing
  # $PLINTH_ROOT/VERSION would under copy_managed_file.
  echo "$PLINTH_VERSION" > "$target/.plinth-version"
}

warn_live_review() {
  local req dir verdict rqround vround
  for req in "$target"/.plinth/session/review/*/request-*.json; do
    [ -f "$req" ] || continue
    rqround="$(jq -r 'if (.round | type) == "number" then .round else empty end' "$req" 2>/dev/null || true)"
    [ -n "$rqround" ] || continue
    dir="$(dirname "$req")"
    verdict="$dir/verdict.json"
    vround="$(jq -r 'if (.round | type) == "number" then .round else 0 end' "$verdict" 2>/dev/null || echo 0)"
    case "$vround" in ''|*[!0-9]*) vround=0 ;; esac
    if [ "$rqround" -gt "$vround" ] 2>/dev/null; then
      echo "WARNING: review round $rqround appears to be in flight in ${dir#"$target/"}."
      echo "         Updating managed files mid-round can change helpers/contracts the running review loads later by path."
      echo "         Continuing: the already-running review.sh keeps its open inode (rename does not truncate it)."
      return 0
    fi
  done
}

# GitHub preflight: verify the layers underneath the gates actually exist.
# Automates what is safe (local git init), asks consent for what is outward
# (creating a GitHub repo), and only REPORTS on branch protection — required-
# check names exist only after the first CI run; configuring them blind can
# block merging forever behind checks that never report.
github_preflight() {
  if ! git -C "$target" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$target" init -b main >/dev/null 2>&1 || git -C "$target" init >/dev/null 2>&1
    echo "  git:           initialized repository — Plinth's review, gates, and dashboard were inert without it"
  fi
  if ! git -C "$target" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    echo "  git:           NO COMMITS yet — commit the scaffold + spec BEFORE starting a"
    echo "                 driver. Verdicts and gates bind to commits; on an unborn branch"
    echo "                 the review loop cannot run."
  fi
  command -v gh >/dev/null 2>&1 || { echo "  github:        gh CLI not found — install it to verify/create the remote and check protection"; return 0; }
  gh auth status >/dev/null 2>&1 || { echo "  github:        gh not authenticated (run: gh auth login) — skipping remote/protection checks"; return 0; }

  local url name slug defb out
  url="$(git -C "$target" remote get-url origin 2>/dev/null || true)"
  if [ -z "$url" ]; then
    name="$(basename "$target")"
    if [ -t 0 ]; then
      printf '  github:        no origin remote. Create GitHub repo "%s" now? [y/N] ' "$name"
      read -r ans || ans=""
      if [ "$ans" = "y" ] || [ "$ans" = "Y" ]; then
        printf '  visibility:    public gets branch protection on the free plan; private needs Pro. [public/private] (public): '
        read -r vis || vis=""
        [ "$vis" = "private" ] || vis="public"
        if (cd "$target" && gh repo create "$name" "--$vis" --source . --push); then
          echo "  github:        created and pushed ($vis)"
          url="$(git -C "$target" remote get-url origin 2>/dev/null || true)"
        else
          echo "  github:        creation failed — run manually: gh repo create $name --$vis --source \"$target\" --push"
          return 0
        fi
      else
        echo "  github:        skipped. When ready: gh repo create $name --public --source \"$target\" --push"
        return 0
      fi
    else
      echo "  github:        no origin remote. When ready: gh repo create $name --public --source \"$target\" --push"
      return 0
    fi
  fi

  slug="$(printf '%s' "$url" | sed -E 's#^(git@[^:]+:|https?://[^/]+/)##; s#\.git$##')"
  defb="$(gh api "repos/$slug" -q .default_branch 2>/dev/null || echo main)"
  if out="$(gh api "repos/$slug/branches/$defb/protection" 2>&1)"; then
    # "configured" alone is not the guarantee — verify the required CONTEXTS actually
    # cover the floor and checks jobs; protection with the wrong (or no) contexts
    # leaves merges ungated while the preflight reads as healthy.
    ctxs="$(printf '%s' "$out" | jq -r '.required_status_checks.contexts[]?' 2>/dev/null || true)"
    # The floor is FOUR independent jobs (secrets, sast, dependencies/osv-scan, harness) —
    # each needs its own required context; one present floor job does not gate the others.
    # Contexts are matched by JOB NAME (grep -xF, exact) — GitHub does not prefix required-check
    # contexts with the workflow name; the caller jobs are the scaffold's `floor` and `checks`.
    miss=""
    # GitHub required-check contexts are JOB names, NOT workflow-name-prefixed labels: a direct job
    # is "<job>"; a reusable-workflow job is "<caller-job> / <reusable-job>". The scaffold's caller
    # jobs are `floor` and `checks`, so the expected contexts are "floor / secrets", "floor / sast",
    # "floor / dependencies / osv-scan", "floor / harness", and "checks / <job>" (or "checks" direct).
    # Fetch actual check-runs ONCE and validate EVERY configured floor+checks context against them:
    # a context that is required but names no real job (jobs removed/renamed) is a ghost gate.
    runs="$(gh api --paginate "repos/$slug/commits/$defb/check-runs" -q '.check_runs[].name' 2>/dev/null || true)"
    ckctx="$(printf '%s\n' "$ctxs" | grep -E "^checks( / checks)?\$" || true)"
    # required-set membership (grep -xF) first:
    fmiss=""
    for want in "floor / secrets" "floor / sast" "floor / dependencies / osv-scan" "floor / harness"; do
      printf '%s\n' "$ctxs" | grep -qxF "$want" || fmiss="${fmiss:+$fmiss }$want"
    done
    [ -z "$fmiss" ] || for w in $fmiss; do case "$w" in *secrets) miss="${miss:+$miss, }floor/secrets";; *sast) miss="${miss:+$miss, }floor/sast";; *harness) miss="${miss:+$miss, }floor/harness";; *osv-scan) miss="${miss:+$miss, }floor/dependencies/osv-scan";; esac; done
    [ -n "$ckctx" ] || miss="${miss:+$miss, }checks"
    # The receipt check (auto mode, v4.7+) is expected ONLY where the project's CI
    # actually wires plinth-receipt.yml — never demanded of an older scaffold, so
    # the preflight cannot tell an operator to require a context no job reports.
    # Match a `uses:` LINE, not the bare filename anywhere in any workflow: a comment
    # or an unrelated job name mentioning plinth-receipt.yml would otherwise make the
    # preflight tell the operator to require a context that no job reports. (Not the
    # full job-scoped awk that warn_stale_reusable_refs uses — this check is ADVISORY
    # and gates nothing, so a `uses:`-line match is the proportionate precision; a
    # decoy would have to be a real uses: line, which IS the wiring.)
    # Appended AFTER the floor/checks items on purpose: the floor is the older and
    # more consequential gate, so it leads the message — and the existing fixtures
    # assert on contiguous substrings like "MISSING: floor/sast", which a prepended
    # entry would silently break.
    if grep -qsE '^[[:space:]]*["'"'"']?uses["'"'"']?[[:space:]]*:.*plinth-receipt\.yml' "$target/.github/workflows/"*.yml 2>/dev/null; then
      printf '%s\n' "$ctxs" | grep -qxF "receipt / verify" || miss="${miss:+$miss, }receipt/verify"
    fi
    # then cross-check EVERY present floor/checks context against actual check runs (fail closed on
    # no data): a required context not among real check runs is a ghost gate that never reports.
    # `receipt / verify` joins the ghost sweep on the same terms as floor/checks: it is a
    # REQUIRED context wherever the operator enabled it, so a misspelled one — or one left
    # required after the job was removed — is exactly the ghost gate this detects. Included
    # unconditionally: membership above is gated on the workflow being wired, but a context
    # that is already REQUIRED must be checked for reporting whether or not ci.yml wires it
    # (a required context naming no job is the failure mode, and that is the case where the
    # wiring is gone).
    present="$(printf '%s\n' "$ctxs" | grep -E "^floor / (secrets|sast|harness|dependencies / osv-scan)\$|^checks( / checks)?\$|^receipt / verify\$" || true)"
    if [ -n "$present" ]; then
      if [ -z "$runs" ]; then
        miss="${miss:+$miss, }UNVERIFIED: no check-run data on $defb — cannot confirm the required contexts name real jobs; re-run after the first PR"
      else
        ghost=""
        while IFS= read -r c; do [ -n "$c" ] || continue; printf '%s\n' "$runs" | grep -qxF "$c" || ghost="${ghost:+$ghost; }$c"; done <<GHOSTEOF
$present
GHOSTEOF
        [ -z "$ghost" ] || miss="${miss:+$miss, }required context(s) not among actual check runs: $ghost"
      fi
    fi
    # When 'receipt / verify' is among the required contexts, strict MUST be true.
    # That check verifies the subject as of job execution; after it goes green the
    # base can advance while the PR head and the successful status stay unchanged.
    # Absent is treated exactly like false — do not assume a GitHub default.
    # Only required when the receipt context is present; floor/checks-only configs
    # are unaffected.
    have_receipt=0
    strict_ok=""
    if printf '%s\n' "$ctxs" | grep -qxF "receipt / verify"; then
      have_receipt=1
      # jq `// empty`: null AND false both become empty; only JSON true stays "true".
      strict_ok="$(printf '%s' "$out" | jq -r '.required_status_checks.strict // empty' 2>/dev/null || true)"
    fi
    if [ -z "$ctxs" ]; then
      echo "  protection:    configured on $defb — but NO required status checks are set, so"
      echo "                 floor/checks do NOT gate merges. Add them (Settings -> Branches)."
    elif [ -n "$miss" ]; then
      echo "  protection:    configured on $defb — but required contexts are MISSING: $miss."
      echo "                 Present: $(printf '%s' "$ctxs" | tr '\n' ' '). Absent jobs do not gate merges."
    elif [ "$have_receipt" = 1 ] && [ "$strict_ok" != "true" ]; then
      echo "  protection:    configured on $defb — incomplete: set required_status_checks.strict=true while 'receipt / verify' is required (a green receipt check can describe a base that has since moved)."
    else
      echo "  protection:    configured on $defb (required: $(printf '%s' "$ctxs" | tr '\n' ' '))"
    fi
  elif printf '%s' "$out" | grep -q "Upgrade to GitHub Pro"; then
    echo "  protection:    IMPOSSIBLE on this plan (private repo, GitHub Free) — floor/checks are"
    echo "                 NOT required to merge. Make the repo public or upgrade to Pro."
  elif printf '%s' "$out" | grep -qi "not protected"; then
    echo "  protection:    available but NOT configured on $defb. After the first PR shows the"
    echo "                 check names, require them: repo Settings -> Branches -> protect $defb."
  else
    echo "  protection:    could not determine: $(printf '%s' "$out" | tr '\n' ' ' | head -c 90)"
  fi
}

# settings.json is per-project (never overwritten), so new hook wiring cannot
# propagate silently. Warn when the shared hooks exist but aren't wired.
# protected-paths is per-project (never overwritten), so security-critical
# patterns plinth ships in newer versions do not reach upgraded projects on
# their own. Append any missing plinth-managed patterns (idempotent); user-added
# lines are left untouched.
ensure_protected_paths() {
  local f="$target/.plinth/protected-paths"
  # A symlinked/non-regular policy file must NOT be appended THROUGH — that would rewrite an external
  # target and, read back via `git show base:`, silently narrow protection. Belt:
  # preflight_reserved_lanes already refuses it, but ensure runs standalone (init/update both call it).
  reject_nonregular_file "$f"
  [ -f "$f" ] || return 0
  local added=0 line
  # FAIL CLOSED: a security-policy processing ERROR must abort the update, never
  # degrade into a wrong-but-successful answer. grep rc 1 (no match) is a normal
  # answer; rc >= 2 (unreadable input, bad pattern) aborts. Every stage below
  # runs UNPIPED with its status checked; ppfail is the one exit path.
  ppfail() { echo "ERROR: protected-paths processing failed ($1) — aborting rather than degrading the security policy (fail closed)." >&2; exit 1; }
  # Temp hygiene: ALL system scratch files live inside ONE private mktemp -d
  # directory, registered the command after it is created and removed
  # recursively on any exit — ppfail aborts, signals, and normal completion
  # alike — so a failed update leaks nothing under the system temp dir and
  # never leaves a stray .protected-paths.tmp.* dirtying the repository tree.
  # One directory means ONE create-to-register window (an interrupt inside it
  # can leak at most a single empty directory; shell has no atomic
  # create+register). The same-dir atomic-replace temp is the only other
  # registered path (rename(2) requires the policy's own filesystem).
  # (PP_TMPS/PPD are intentionally not local: the EXIT trap outlives this
  # function's frame.)
  PP_TMPS=()
  pp_cleanup() { [ "${#PP_TMPS[@]}" -eq 0 ] || rm -rf -- "${PP_TMPS[@]}"; }
  # Signals must CLEAN UP AND STOP: a bare handler would resume after cleanup
  # and let a cancelled init/update run on and mutate the policy. Conventional
  # 128+SIG exits; `exit` re-fires the EXIT trap (pp_cleanup is idempotent).
  trap pp_cleanup EXIT
  trap 'pp_cleanup; exit 130' INT
  trap 'pp_cleanup; exit 143' TERM
  local rc
  PPD="$(mktemp -d)" || ppfail "scratch dir create"
  PP_TMPS+=("$PPD")
  # BINARY REJECTION: a NUL byte cannot appear in a valid text policy, and
  # common greps report binary input via a "Binary file matches" DIAGNOSTIC
  # with rc 0 — the regex validation below would then be judging the
  # diagnostic, not the policy bytes (and bash cannot even carry a NUL in a
  # variable). UNPIPED, two checked producers: piped, pipefail reports the
  # RIGHTMOST nonzero status, so cmp's rc 1 (EOF vs file) would mask a tr
  # CRASH and misreport a broken scan as "the file contains NULs".
  local bscan="$PPD/bscan"
  rc=0; LC_ALL=C tr -d '\000' < "$f" > "$bscan" || rc=$?
  [ "$rc" -eq 0 ] || ppfail "binary scan of $f (tr rc=$rc)"
  rc=0; cmp -s "$bscan" "$f" || rc=$?
  [ "$rc" -le 1 ] || ppfail "binary scan of $f (cmp rc=$rc)"
  [ "$rc" -eq 0 ] || ppfail "policy file $f contains NUL/binary bytes — refusing to process"
  # The plinth-managed pattern list (canonical (^|/) anchoring), in a scratch
  # file so the convention detection and the append loop below read one source
  # of truth. The heredoc write is status-checked like every other producer.
  local mpat="$PPD/mpat"
  cat > "$mpat" <<'PATTERNS' || ppfail "managed-list write"
(^|/)\.plinth/session/
(^|/)\.plinth/config$
(^|/)\.claude/hooks/
(^|/)\.claude/agents/grok-implementer\.md$
(^|/)\.claude/agents/codex-implementer\.md$
(^|/)\.claude/settings\.json$
(^|/)\.plinth/review\.sh$
(^|/)\.plinth/risk-classify\.sh$
(^|/)\.plinth/lane-guard\.sh$
(^|/)\.plinth/receipt-verify\.sh$
(^|/)\.plinth/review-schema\.json$
(^|/)\.plinth/plinth-rules\.md$
(^|/)\.plinth/MODELS\.md$
(^|/)\.plinth/reviewer\.md$
(^|/)\.plinth/protected-paths$
(^|/)CLAUDE\.md$
(^|/)AGENTS\.md$
PATTERNS
  # Anchor CONVENTION (v4.5.1). Backfilling in the canonical (^|/) form is wrong
  # in a repo whose file anchors differently: the Plinth-on-plinth repo uses
  # (^|plinth/) so patterns match the INSTALLED copies but never the editable
  # shared/ sources — a canonical append there freezes the PRODUCT (the v4.5.0
  # backfill did exactly that; that repo's file was repaired in-branch with the
  # refresh). Convention = the single (^|X) prefix among the file's active
  # lines, ignoring lines byte-equal to a canonical managed pattern (past
  # canonical backfills must not veto detection). Mixed, absent, or canonical
  # prefixes = canonical behavior, unchanged.
  #
  # APPEND-ONLY by design: existing lines are NEVER rewritten. A line byte-equal
  # to a canonical managed pattern in a convention-anchored file MIGHT be a
  # v4.5.0 backfill — but it might be a user rule deliberately anchored broader,
  # and the file records no provenance, so rewriting it could silently WEAKEN
  # user policy. It stays; suffix-dedup below treats it as covering its path, so
  # nothing is duplicated and every append uses the file's own convention.
  local anchor='(^|/)' prefixes active_t strip_t NL='
'
  active_t="$PPD/active"
  strip_t="$PPD/strip"
  # Stage 1: the file's ACTIVE (non-comment, non-blank) lines.
  rc=0; grep -Ev '^[[:space:]]*(#|$)' "$f" > "$active_t" || rc=$?
  [ "$rc" -le 1 ] || ppfail "active-line read of $f, grep rc=$rc"
  # Stage 1b: every active line must COMPILE as an ERE before anything is
  # derived from it. A malformed rule (e.g. '(^|[)custom$') would otherwise
  # yield a malformed extracted anchor and propagate into every appended
  # managed rule — and the guard consuming the file would then error on it at
  # enforcement time. rc 1 (valid, no match on empty input) is the normal
  # answer; rc >= 2 = the regex does not compile: abort naming the line.
  while IFS= read -r line; do
    rc=0; printf '' | grep -E -- "$line" >/dev/null 2>&1 || rc=$?
    [ "$rc" -le 1 ] || ppfail "malformed policy regex in $f: '$line' does not compile (grep rc=$rc)"
  done < "$active_t"
  # READ-ONLY PHASE from here to the single write at the end: NOTHING touches
  # the file until every check has passed, so any abort leaves it byte-identical
  # — no early newline normalization, no partial backfill. If the file doesn't
  # end in a newline, a straight append would concatenate the first managed
  # pattern onto the user's last line, corrupting BOTH — note that here; the
  # payload below carries the fix. A FAILED trailing-byte read must abort, not
  # read as "newline present".
  local lastc=''
  if [ -s "$f" ]; then
    rc=0; lastc="$(tail -c1 "$f")" || rc=$?
    [ "$rc" -eq 0 ] || ppfail "trailing-byte read of $f, tail rc=$rc"
  fi
  # Stage 2: drop lines byte-equal to a managed pattern; stage 3: keep only
  # leading (^|X) anchor groups; stage 4: unique prefixes.
  # SUPPORTED convention grammar (constrained by design), two regexes:
  # - ANCHOR_RE parses any leading (^|X) group with at most ONE level of paren
  #   nesting (what the grammar can REASON about);
  # - SHAPE_RE additionally requires every top-level alternative of X to be a
  #   PATH PREFIX ending in '/' — e.g. plinth/, plinth/|vendor/,
  #   (plinth|vendor)/ — the only anchors whose composed managed rules match
  #   the absolute paths the hooks check. Only SHAPE-conforming anchors are
  #   adopted for appends and stripped in dedup.
  local ANCHOR_RE='^\(\^\|((\([^()]*\))|[^()])*\)'
  # The literal pipe after the group-open is written [|]: BSD sed's ERE parser
  # rejects the escaped form '(\|' ("parentheses not balanced") while [|] is
  # unambiguous everywhere (grep and sed, GNU and BSD).
  local SHAPE_RE='^\(\^([|]((\([^()]*\))|[^()|])*/)+\)'
  rc=0; grep -vxF -f "$mpat" "$active_t" > "$strip_t" || rc=$?
  [ "$rc" -le 1 ] || ppfail "managed-line exclusion, grep rc=$rc"
  rc=0; grep -oE "$ANCHOR_RE" "$strip_t" > "$active_t" || rc=$?
  [ "$rc" -le 1 ] || ppfail "anchor extraction, grep rc=$rc"
  prefixes="$(sort -u "$active_t")" || ppfail "prefix sort"
  # EFFECTIVENESS PROBE: a shape-valid anchor can still be PATH-IRRELEVANT —
  # (^|vendor/) in a project whose absolute path has no vendor/ segment
  # composes managed rules that match NOTHING the hooks ever check, silently
  # installing dead protection. The probe is the policy file's own canonical
  # absolute path: an anchor is adopted for appends — or an anchored line's
  # suffix counted as covered in dedup — only if the composed managed rule
  # actually matches that real path.
  local tprobe
  tprobe="$(cd -P "$target" && pwd)/.plinth/protected-paths" || ppfail "probe path resolve"
  anchor_effective() { # <anchor> -> rc 0 effective / rc 1 not; rc>1 aborts
    local arc=0
    printf '%s\n' "$tprobe" | grep -qE "${1}\\.plinth/protected-paths\$" || arc=$?
    [ "$arc" -le 1 ] || ppfail "anchor effectiveness probe, grep rc=$arc"
    return "$arc"
  }
  # Single non-canonical prefix adopts the convention for APPENDS (pure-bash
  # count: empty or multiline = no single convention) — but only when it is
  # SHAPE-conforming (an anchor like (^|foo) would compose managed rules
  # matching "foo.plinth/…", not absolute paths) AND EFFECTIVE against this
  # project's real path. Otherwise: canonical appends.
  case "$prefixes" in
    ''|*"$NL"*) : ;;  # zero or several conventions: keep canonical appends
    '(^|/)') : ;;     # canonical convention: keep canonical appends
    *)
      rc=0; printf '%s' "$prefixes" | grep -qE "${SHAPE_RE}\$" || rc=$?
      [ "$rc" -le 1 ] || ppfail "anchor shape check, grep rc=$rc"
      if [ "$rc" -eq 0 ] && anchor_effective "$prefixes"; then anchor="$prefixes"; fi
      ;;
  esac
  # Dedup by PATH SUFFIX, not whole line. A project may protect the same path
  # with DIFFERENT anchoring — the Plinth-on-plinth repo uses (^|plinth/) so its
  # patterns match the INSTALLED copies but NOT the editable shared/ sources.
  # Appending our canonical (^|/) form there would ALSO match shared/.plinth/*,
  # wrongly freezing the PRODUCT (hence $anchor on the append below). "Covered"
  # therefore means: some ACTIVE (non-comment, non-blank) line, after stripping
  # a SHAPE-conforming leading (^|...) group, EQUALS the suffix exactly.
  # Equality, not substring: an active-but-different pattern like
  # (^|/)old-CLAUDE\.md$ CONTAINS the suffix CLAUDE\.md$ yet protects a
  # different path, and must not suppress backfilling the real protection.
  # Comments are excluded too. The suffix set is computed ONCE, status-checked
  # (managed suffixes are pairwise distinct, so an append never changes a later
  # pattern's answer); a membership ERROR aborts — it must not read as "missing"
  # and trigger a blind append.
  rc=0; grep -Ev '^[[:space:]]*(#|$)' "$f" > "$active_t" || rc=$?
  [ "$rc" -le 1 ] || ppfail "dedup active-line read, grep rc=$rc"
  # The strip removes only SHAPE-CONFORMING anchors (every arm a path prefix
  # ending in '/'). A parseable-but-NON-conforming anchor like (^|foo) — and
  # likewise a BARE-^ rule like ^\.plinth/session/ — is left in place ON
  # PURPOSE: such rules cannot match the absolute paths the hooks check, so
  # their managed suffixes must read as UNCOVERED and receive the canonical
  # append — stripping them would let a broken rule suppress real protection.
  # Per-line grep probe + bash prefix removal, not sed: BSD sed's ERE parser
  # rejects SHAPE_RE's nesting depth outright ("parentheses not balanced")
  # while grep parses it identically on GNU and BSD. SHAPE_RE is ^-anchored so
  # -o yields at most one match per line.
  : > "$strip_t" || ppfail "dedup strip init"
  local pfx
  while IFS= read -r line; do
    rc=0; pfx="$(printf '%s\n' "$line" | grep -oE "$SHAPE_RE")" || rc=$?
    [ "$rc" -le 1 ] || ppfail "dedup anchor strip probe, grep rc=$rc"
    # An INEFFECTIVE anchor (shape-valid but path-irrelevant) must not be
    # stripped either — its suffix would read as covered while its rule
    # matches nothing on this project's real paths.
    if [ -n "$pfx" ] && ! anchor_effective "$pfx"; then pfx=""; fi
    line="${line#"$pfx"}"
    printf '%s\n' "$line" >> "$strip_t" || ppfail "dedup strip write"
  done < "$active_t"
  # REFUSE-TO-BROADEN: a residual leading '(^|' the grammar can PARSE is the
  # non-conforming case above (safe: canonical append restores protection). One
  # it CANNOT parse (nesting deeper than one level) might legitimately cover
  # its suffix — appending canonical over it would broaden past the file's
  # intent, so that aborts.
  rc=0; grep -E '^\(\^\|' "$strip_t" > "$active_t" || rc=$?
  [ "$rc" -le 1 ] || ppfail "residual-anchor scan, grep rc=$rc"
  if [ "$rc" -eq 0 ]; then
    rc=0; grep -Evq "$ANCHOR_RE" "$active_t" || rc=$?
    [ "$rc" -le 1 ] || ppfail "residual-anchor parse scan, grep rc=$rc"
    [ "$rc" -eq 1 ] || ppfail "unsupported anchor grammar in $f (a leading (^|...) group the grammar cannot parse — nesting deeper than one level) — normalize that line; refusing to append a broader canonical pattern over it"
  fi
  local sfx payload=''
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    sfx="${line#'(^|/)'}"
    rc=0; grep -qxF -- "$sfx" "$strip_t" || rc=$?
    [ "$rc" -le 1 ] || ppfail "dedup membership check, grep rc=$rc"
    [ "$rc" -eq 0 ] && continue
    # Belt: the COMPOSED rule must itself compile before it is collected — the
    # anchor was extracted from a validated line, but never append a rule the
    # guard could later error on.
    rc=0; printf '' | grep -E -- "${anchor}${sfx}" >/dev/null 2>&1 || rc=$?
    [ "$rc" -le 1 ] || ppfail "composed pattern '${anchor}${sfx}' does not compile (grep rc=$rc)"
    payload="${payload}${anchor}${sfx}${NL}"
    added=$((added + 1))
  done < "$mpat"
  # MUTATION PHASE — atomic, reached only with every check green. The ENTIRE
  # new policy (original bytes + newline-termination fix + missing patterns)
  # is composed in a SAME-DIRECTORY temp whose mode is copied from the
  # original, its byte length is verified, and it is rename(2)d over the
  # original. A short write (ENOSPC, quota, I/O) can only truncate the TEMP —
  # the size check catches it and the abort removes it — so the live policy is
  # either the old bytes or the complete new bytes, never a partial. (rename
  # needs only directory write; the policy file is replaced, never written
  # through.)
  if [ "$added" -gt 0 ]; then
    [ -z "$lastc" ] || payload="${NL}${payload}"
    local fdir tmpf osz psz nsz fmode
    fdir="$(dirname "$f")" || ppfail "policy dirname"
    tmpf="$(mktemp "$fdir/.protected-paths.tmp.XXXXXX")" || ppfail "same-dir temp create"
    PP_TMPS+=("$tmpf")
    # The O_EXCL mktemp file is written THROUGH — never deleted and re-created,
    # which would reopen the pathname and let a concurrent process swap in a
    # symlink/hardlink (the write-through class the CLI prevents elsewhere).
    # Its mode is set EXACTLY from the original via stat+chmod — a cp-created
    # file is filtered through the umask (0664 would silently become 0644,
    # dropping group write). Every producer here is status-checked, including
    # the final size read: a wc failure must abort, not be compared as text.
    osz="$(wc -c < "$f")" || ppfail "policy size read"
    psz="$(printf '%s' "$payload" | wc -c)" || ppfail "payload size"
    # GNU (-c) FIRST; BSD stat rejects -c and falls through to -f. Reverse
    # order is WRONG (the same trap the hardlink check documents): GNU
    # `stat -f %Lp f` treats %Lp as a file operand, can emit filesystem data
    # for f with a nonzero status, and the || then APPENDS the fallback —
    # yielding a non-octal fmode that would abort every Linux backfill.
    fmode="$(stat -c %a "$f" 2>/dev/null || stat -f %Lp "$f" 2>/dev/null)" || ppfail "policy mode read"
    case "$fmode" in ''|*[!0-7]*) ppfail "policy mode read (non-octal '$fmode')" ;; esac
    cat "$f" > "$tmpf" || ppfail "temp compose copy"
    printf '%s' "$payload" >> "$tmpf" || ppfail "pattern append (temp)"
    nsz="$(wc -c < "$tmpf")" || ppfail "composed size read"
    [ "$nsz" -eq $(( osz + psz )) ] || ppfail "short write detected composing the new policy"
    chmod "$fmode" "$tmpf" || ppfail "mode preserve (chmod $fmode)"
    mv -f "$tmpf" "$f" || ppfail "atomic replace (rename)"
    echo "  protected-paths: added $added plinth-managed security pattern(s)"
  fi
  return 0
}

warn_missing_gate_wiring() {
  if ! grep -q 'review-gate.sh' "$target/.claude/settings.json" 2>/dev/null; then
    echo "NOTE: .claude/settings.json (yours, never overwritten) lacks the review-gate"
    echo "wiring — the review Stop gate is NOT enforced in this project. Add the"
    echo "SessionStart and Stop hook entries from CHANGELOG v3.7."
  fi
  if ! grep -q 'pulse.sh' "$target/.claude/settings.json" 2>/dev/null; then
    echo "NOTE: .claude/settings.json lacks pulse.sh wiring — under a CLAUDE driver"
    echo "'plinth watch' will run feedless (reduced frame: branch/verdict/queue only)."
    echo "Whether a grok/codex driver executes these hooks: run 'plinth hookprobe <vendor>'"
    echo "(grok 0.2.112 reported no execution (reproduce: plinth hookprobe grok) — feedless is"
    echo "expected there; a driver the probe shows INVOKING PostToolUse yet feedless needs"
    echo "investigating: broken wiring, or the hook gets no usable stdin/env — see the probe"
    echo "json-stdin flag). For Claude, see CHANGELOG v3.8."
  fi
}

# ci.yml is per-project and NEVER rewritten by Plinth (the operator owns it). But its
# reusable-workflow refs pin a Plinth release SHA, and an upgrade that bumps
# .plinth-version WITHOUT repinning leaves the project calling the OLD floor/checks —
# so new floor checks never run while branch protection stays green. update can't
# silently rewrite the operator's workflow, so it WARNS loudly with the exact repin
# command when the pinned SHA is stale (matches the branch-protection warning pattern).
warn_stale_reusable_refs() {
  [ -f "$target/.github/workflows/ci.yml" ] || return 0
  local psha; psha="$(git -C "$PLINTH_ROOT" rev-parse HEAD 2>/dev/null || true)"
  if [ -z "$psha" ]; then
    # Non-git install (archive): we cannot resolve the release SHA to compare, but update still
    # advanced .plinth-version and installed new tooling. Warn LOUDLY rather than silently skip —
    # the old reusable floor/checks may still be active (mirrors the non-git INIT fail-loud path).
    echo "NOTE: could not resolve the Plinth release commit (non-git install?), so update cannot"
    echo "verify .github/workflows/ci.yml's reusable floor/checks refs. If a ref pins an older"
    echo "release, that gate runs older Plinth tooling (and the NEW floor checks run only once the"
    echo "FLOOR ref is current) — repin the reusable ref(s) present to this release's commit SHA."
    return 0
  fi
  # Warn if EITHER ref is stale — floor and checks are independent gates, either can lag.
  local ci="$target/.github/workflows/ci.yml"
  # Tie the check to the GATING jobs (`floor:` / `checks:`), not any uses: line anywhere —
  # a current ref under a decoy non-gating job must not suppress the warning. Best-effort
  # (this is an advisory warning, not a gate): read the uses: line within each job block.
  local fref cref jobawk
  # Match the gating job key robustly: ANY indentation (not exactly two spaces), optional surrounding
  # quotes (`"floor":` / `'checks':`), and optional space before the colon (`floor :`). Record the job
  # key's INDENTATION and end the block only at a SIBLING-or-shallower non-blank line (indent <= the
  # job's) — a MORE-indented child property (`permissions:`, `needs:`, `if:`, `strategy:` before
  # `uses:`) must NOT terminate the block and suppress the warning. `uses:` is checked first.
  # NOTE: the indentation capture MUST be an ACTION block `{ ... }` — a bare `match(...); x=RLENGTH`
  # would be parsed as two PATTERNS (each with the default {print}), default-printing every line and
  # corrupting the captured ref. `{ ... }` with no pattern runs for every line.
  # Discovery is SCOPED to the top-level `jobs:` mapping so a same-named key elsewhere (e.g.
  # `env: { floor: … }` or `on:` inputs) is not mistaken for the gating job. The `uses:` match is a
  # line-start KEY at a child indent (`^[[:space:]]*uses:`), so `name: "uses: …"` text inside a string
  # or a commented `# uses: …` line does NOT satisfy it. Block ends at a sibling-or-shallower line.
  # Require a DIRECT-CHILD job of the top-level `jobs:` mapping (ind == the first job-child indent)
  # and a DIRECT-CHILD `uses:` of that job (ind == the job's first-child indent) — so a same-named
  # MATRIX/nested key (`jobs.setup.strategy.matrix.floor`, `jobs.floor.strategy.matrix.uses`) at a
  # deeper indent does NOT divert discovery. Top-level `jobs:` may itself be quoted.
  # `:[[:space:]]*(#.*)?$` tolerates an inline `# comment` on the `jobs:`/gating-job line; comment
  # lines never establish the inferred child indent (excluded from the jobcind/usescind capture);
  # `uses:` may itself be quoted (`"uses":`). Full YAML flow-style (`jobs: {floor: {…}}`) is out of
  # scope for this line-based best-effort advisory.
  jobawk='
    { match($0, /^[[:space:]]*/); ind0=RLENGTH }
    ind0==0 && $0 ~ /^['\''\"]?jobs['\''\"]?[[:space:]]*:[[:space:]]*(#.*)?$/ { injobs=1; next }
    injobs && !f && ind0==0 && $0 ~ /[^[:space:]]/ && $0 !~ /^[[:space:]]*#/ { injobs=0 }
    injobs && !f && jobcind==0 && ind0>0 && $0 ~ /[^[:space:]]/ && $0 !~ /^[[:space:]]*#/ { jobcind=ind0 }
    injobs && !f && ind0==jobcind && $0 ~ ("^[[:space:]]*['\''\"]?" JOB "['\''\"]?[[:space:]]*:[[:space:]]*(#.*)?$") { f=1; jind=ind0; next }
    f && usescind==0 && ind0>jind && $0 ~ /[^[:space:]]/ && $0 !~ /^[[:space:]]*#/ { usescind=ind0 }
    f && ind0==usescind && $0 ~ /^[[:space:]]*['\''\"]?uses['\''\"]?[[:space:]]*:/ && $0 !~ /^[[:space:]]*#/ { print; exit }
    f && ind0<=jind && $0 ~ /[^[:space:]]/ && $0 !~ /^[[:space:]]*#/ { exit }'
  fref="$(awk -v JOB=floor  "$jobawk" "$ci" 2>/dev/null)"
  cref="$(awk -v JOB=checks "$jobawk" "$ci" 2>/dev/null)"
  # The receipt job is OPTIONAL (only present once an operator wires it), so an
  # absent one is silence, not staleness — same treatment as a custom checks gate.
  rref="$(awk -v JOB=receipt "$jobawk" "$ci" 2>/dev/null)"
  # A `checks:` job with NO plinth-checks.yml reusable ref is an intentional custom/direct gate
  # (template-supported) — not a stale Plinth ref. Only judge staleness of the REUSABLE refs
  # actually present; a customized checks job is not "stale".
  local fstale=0 cstale=0 rstale=0
  # QUOTE-AWARE ref extraction: parse the pinned ref out of each uses line the way YAML would — a
  # value that STARTS with a quote is a quoted scalar whose ref ends at the CLOSING quote; an UNQUOTED
  # value's ref runs to the first whitespace (a `# comment` is only a comment when whitespace-preceded),
  # so a quote INSIDE an unquoted ref (`@<sha>'old`) is part of the ref. This avoids treating a quote as
  # an unconditional terminator (which mis-read `<sha>'old` as current) and lets the repin match the
  # LITERAL stale ref (below) — quote-agnostic AND scoped to that ref value.
  _ref_of() {  # _ref_of <uses-line> <workflow-basename> -> the pinned ref, "" if none
    local _v; _v="$(printf '%s' "$1" | sed -E 's/^[[:space:]]*["'\'']?uses["'\'']?[[:space:]]*:[[:space:]]*//')"
    case "$_v" in
      '"'*) _v="${_v#\"}"; _v="${_v%%\"*}" ;;
      "'"*) _v="${_v#\'}"; _v="${_v%%\'*}" ;;
      *)    _v="${_v%%[[:space:]]*}" ;;
    esac
    case "$_v" in *"$2.yml@"*) printf '%s' "${_v##*"$2.yml@"}" ;; esac
  }
  local fref_r cref_r rref_r
  fref_r="$(_ref_of "$fref" plinth-floor)"
  cref_r="$(_ref_of "$cref" plinth-checks)"
  rref_r="$(_ref_of "$rref" plinth-receipt)"
  { [ -n "$fref_r" ] && [ "$fref_r" != "$psha" ]; } && fstale=1
  { [ -n "$cref_r" ] && [ "$cref_r" != "$psha" ]; } && cstale=1
  { [ -n "$rref_r" ] && [ "$rref_r" != "$psha" ]; } && rstale=1
  [ "$fstale" = 0 ] && [ "$cstale" = 0 ] && [ "$rstale" = 0 ] && return 0
  # Name exactly the stale ones. A stale RECEIPT ref matters as much as the other
  # two: it is a REQUIRED status context wherever the operator enabled it, so an
  # unrepinned ref either runs an older verifier or fails to resolve at all.
  local which stale_list=""
  [ "$fstale" = 1 ] && stale_list="floor"
  [ "$cstale" = 1 ] && stale_list="${stale_list:+$stale_list and }checks"
  [ "$rstale" = 1 ] && stale_list="${stale_list:+$stale_list and }receipt"
  which="reusable ${stale_list} ref(s) (any not named is a custom/direct gate, absent, or already current)"
  echo "NOTE: .github/workflows/ci.yml (yours, never rewritten) pins the $which at an OLDER Plinth"
  echo "commit, so that gate runs an OLDER Plinth workflow."
  # Consequence lines are per-ref: a floor-specific caveat printed for a stale RECEIPT
  # ref would misdescribe what is actually at risk.
  [ "$fstale" = 1 ] && echo "  floor: new floor checks (lane tooling bytes + executable mode) only run once the FLOOR ref is current."
  [ "$rstale" = 1 ] && echo "  receipt: where 'receipt / verify' is a REQUIRED context, a stale ref runs an older verifier — and a ref predating plinth-receipt.yml does not resolve at all, so the check cannot report."
  echo "Repin the stale ref(s) to this release:"
  # Repin by matching the LITERAL stale ref value: `plinth-<wf>.yml@<old-ref>` -> `…@<psha>`. Matching
  # the exact old bytes preserves a surrounding quote for a quoted value, fully replaces an unquoted
  # ref that contains a quote, and does NOT touch an unrelated job pinning a DIFFERENT ref (a comment or
  # job carrying the SAME stale ref is rewritten too — intended, they should all be current). The old
  # ref is escaped for a `#`-delimited sed regex; the emitted sed is SINGLE-quoted so a ref containing a
  # backtick/`$`/`"` is INERT (no shell injection), with an embedded `'` handled via the `'\''` idiom;
  # paths are %q shell-quoted. (Best-effort advisory: a ref using YAML quote-ESCAPING — `\"` in a
  # double-quoted scalar or `''` in a single-quoted scalar — is not decoded.)
  # BRE (no -E): the old ref is a LITERAL string, so `+ ( ) { } ? |` must stay literal — only the BRE
  # specials `\ . * [ ] ^ $` (plus the `#` delimiter and replacement `&`) are escaped. The emitted sed
  # expression is SINGLE-quoted so a ref containing shell metacharacters (backtick, `$`, `"`) is INERT
  # — no command substitution/injection when a human runs the advertised command. A `'` inside the ref
  # is embedded via the `'\''` idiom (close-quote, escaped-quote, reopen).
  _re_esc() {
    local _e _sq=\'\\\'\'   # _sq is the 4-char sequence  '  \  '  '  (the single-quote-in-single-quote idiom)
    _e="$(printf '%s' "$1" | sed 's/[][\.*^$/#&]/\\&/g')"
    _e="${_e//\'/$_sq}"     # ' -> '\''  so it can sit inside the single-quoted sed expression
    printf '%s' "$_e"
  }
  local qci qbak sedx=""
  qci="$(printf '%q' "$target/.github/workflows/ci.yml")"
  qbak="$(printf '%q' "$target/.github/workflows/ci.yml.bak")"
  [ "$fstale" = 1 ] && sedx="${sedx} -e 's#plinth-floor\\.yml@$(_re_esc "$fref_r")#plinth-floor.yml@${psha}#g'"
  [ "$cstale" = 1 ] && sedx="${sedx} -e 's#plinth-checks\\.yml@$(_re_esc "$cref_r")#plinth-checks.yml@${psha}#g'"
  [ "$rstale" = 1 ] && sedx="${sedx} -e 's#plinth-receipt\\.yml@$(_re_esc "$rref_r")#plinth-receipt.yml@${psha}#g'"
  echo "  sed -i.bak${sedx} ${qci} && rm -f ${qbak}"
}

# PER-PROJECT (templates, copied once, never overwritten):
copy_templates_if_absent() {
  place() {  # place <template-rel-path> <dest-rel-path>
    # only-if-absent, but the "absent" test must fail loud on a non-regular/symlinked dest (a symlink
    # or dir/FIFO at SPEC.md/.gitignore/… would let cp escape, copy into a dir, or hang):
    reject_nonregular_file "$target/$2"
    if [ -f "$target/$2" ]; then
      echo "  kept (yours):  $2"
    else
      cp "$PLINTH_ROOT/templates/$1" "$target/$2"
      echo "  created:       $2"
    fi
  }
  mkdir -p "$target/.claude" "$target/.github/workflows" "$target/.plinth"
  # CLAUDE.md is no longer a per-project template — it is a pinned driver shell
  # materialized by copy_shared (materialize_driver_shell). Project-specific driver
  # notes live in .plinth/DRIVER-project.md instead.
  place SPEC.md SPEC.md
  place .gitignore .gitignore
  place .claude/settings.json .claude/settings.json
  place AGENTS-project.md .plinth/AGENTS-project.md
  place DRIVER-project.md .plinth/DRIVER-project.md
  if [ -f "$target/.plinth/protected-paths" ]; then
    echo "  kept (yours):  .plinth/protected-paths"
  else
    printf '# One grep -E pattern per line; the driver must not edit matching paths.\n# Under a Claude driver the guard blocks such edits at the tool level. (Version-pinned Plinth\n# tooling here is also checked by the review as tampering; project-owned entries like config\n# are reviewed as normal project code.) Use (^|/)name anchoring, not ^name: agent file paths\n# are often absolute. Version-pinned tooling updates come via plinth update.\n(^|/)\\.plinth/session/\n(^|/)\\.plinth/config$\n(^|/)\\.claude/hooks/\n(^|/)\\.claude/agents/grok-implementer\\.md$\n(^|/)\\.claude/agents/codex-implementer\\.md$\n(^|/)\\.claude/settings\\.json$\n(^|/)\\.plinth/review\\.sh$\n(^|/)\\.plinth/risk-classify\\.sh$\n(^|/)\\.plinth/lane-guard\\.sh$\n(^|/)\\.plinth/review-schema\\.json$\n(^|/)\\.plinth/plinth-rules\\.md$\n(^|/)\\.plinth/MODELS\\.md$\n(^|/)\\.plinth/reviewer\\.md$\n(^|/)\\.plinth/protected-paths$\n(^|/)CLAUDE\\.md$\n(^|/)AGENTS\\.md$\n' > "$target/.plinth/protected-paths"
    echo "  created:       .plinth/protected-paths"
  fi
  if [ -f "$target/.plinth/config" ]; then
    echo "  kept (yours):  .plinth/config"
  else
    printf '# Plinth per-project config. Never overwritten by plinth update.\n# The driver must not edit this (it is in protected-paths): under a Claude driver the guard\n# blocks edits at the tool level; a change is otherwise reviewed as normal project code.\n# Knobs (all optional, set-once):\n# spec_path: canonical spec — file (SPEC.md) or directory tree (spec/).\n# exec_gated: space-separated grep -E patterns for execution-gated paths;\n#   RUNTIME: review findings there route to the run gate instead of blocking.\n# smoke_cmd: the real-run command the Smoke workflow executes on the\n#   self-hosted runner (empty = smoke job no-ops green).\n# tier2_extra: grep -E pattern for project paths that must always get the\n#   full (Tier 2) adversarial review (risk-classify.sh floors the tier here).\n# reviewer_vendor: PRIMARY reviewer CLI — codex (OpenAI), claude (Anthropic), or\n#   grok (xAI). Default codex. Who runs the primary adversarial review (distinct\n#   from audit_vendor, the cross-vendor SECOND opinion). Must be installed + signed\n#   in. codex/claude resume warm threads across fix rounds; grok runs fresh.\n# reviewer_model_tier1 / reviewer_model_tier2: optional per-tier reviewer model\n#   (passed to the reviewer as its model flag). Unset = the vendor default model.\n#   Set a cheaper model for tier1 to cut cost; the frontier model for tier2.\n# audit_vendor: subscription CLI for the cross-vendor Tier-2 second opinion —\n#   codex (OpenAI), claude (Anthropic), grok (xAI), or agy (Google Antigravity).\n#   The audit runs only\n#   when audit_vendor differs from reviewer_vendor (the primary). The scaffold sets\n#   audit_vendor = claude (below) with the default reviewer_vendor = codex, so in a fresh\n#   project the cross-vendor audit IS ON (every Tier 2 approval, every 5th else) and the\n#   auditor is a different family than BOTH the grok WORKER (the usual diff producer)\n#   and the codex reviewer — true in both the architect-resident default and the\n#   grok-resident alternative. An unset\n#   audit_vendor DEFAULTS to codex, so it runs unless reviewer_vendor is also codex; to turn\n#   it off, set audit_vendor equal to reviewer_vendor. Use a DIFFERENT vendor to keep it on.\n#   All are subscription-authenticated (no per-use cost).\n# audit_model: optional model override for audit_vendor (NOT a trigger — the\n#   cross-vendor audit runs only when audit_vendor is a DIFFERENT vendor than\n#   reviewer_vendor, the primary). When it runs: every Tier 2 approval, every 5th else.\n# advisor_vendor: CLI for `plinth advise` — claude|codex|grok|agy. Default claude.\n#   The advisor is a COLLABORATIVE, non-blocking, driver-initiated consult of a model\n#   as good or BETTER than the driver (distinct from the adversarial reviewer and the\n#   auditor). Cross-family is fine: a grok driver can set advisor_vendor = claude to\n#   consult Fable.\n# advisor_model / advisor_model_max: peer-tier and escalated-tier advisor model.\n#   `plinth advise` uses advisor_model; `plinth advise --impactful` (architectural /\n#   high-consequence decisions) uses advisor_model_max. Both should be >= the driver\n#   model. Unset = the vendor default model (no escalation).\n# round_budget: advisory per-round input-token budget (default 4000000). Over it the\n#   review WARNS and continues (never blocks); spend is visible in plinth watch.\n# round_cap: OPT-IN circuit breaker. UNSET (the default) or 0 means NO CAP — the loop\n#   runs until it converges; a long loop means fix the CONVERGENCE (enumerate whole\n#   finding-classes, batch each round of fixes into one commit), not stop reviewing.\n#   Set a positive integer (max 100000) to cap: the loop stops (exit 2) at that round and\n#   surfaces to the human. A malformed value is refused loudly, never reinterpreted.\n# On-the-fly seat overrides (operator escape hatch, e.g. credits run out mid-loop):\n#   env PLINTH_REVIEWER_VENDOR / PLINTH_REVIEWER_MODEL / PLINTH_AUDIT_VENDOR /\n#   PLINTH_AUDIT_MODEL / PLINTH_ROUND_CAP beat this file for ONE review run and are announced + recorded\n#   in verdict.json (overrides object). Landing a seat change still means a commit here.\n# Recommended reviewer assignment (see .plinth/MODELS.md): primary reviewer\n#   codex/GPT (deepest); audit_vendor = claude (a different family than both the grok\n#   worker and the codex reviewer, in either topology) for the cross-vendor Tier-2 second opinion.\n#   Needs claude signed in; fails non-fatal if not.\n# Everything else has working defaults.\nspec_path = SPEC.md\naudit_vendor = claude\n# v4 audit seat model: Opus 4.8 (the seat is Claude OPUS, not the CLI default —\n# an operator whose claude CLI defaults to Sonnet/Fable would otherwise audit\n# with a different model than the assignment promises):\naudit_model = opus\n# v4 advisor seat (plinth advise): peer = Opus 4.8, --impactful = Fable 5 (credits).\n# advise is NON-BLOCKING, so a missing model/CLI just reports unavailable. Model\n# names are per-vendor — change them if you change advisor_vendor.\nadvisor_model = opus\nadvisor_model_max = fable\n# v4 reviewer seat: GPT-5.6 GA landed July 9 2026, but access is PER-ACCOUNT and\n# needs Codex CLI >= 0.144.0 — uncomment once codex -m gpt-5.6 works for you.\n# An ACTIVE line on an ineligible account makes the reviewer FAIL LOUD, not\n# fall back — that is why these ship commented.\n# reviewer_model_tier1 = gpt-5.6\n# reviewer_model_tier2 = gpt-5.6\n' > "$target/.plinth/config"
    echo "  created:       .plinth/config"
  fi
  place .github/workflows/smoke.yml .github/workflows/smoke.yml
  if [ -f "$target/.github/workflows/ci.yml" ]; then
    echo "  kept (yours):  .github/workflows/ci.yml"
  else
    cp "$PLINTH_ROOT/templates/.github/workflows/ci.yml" "$target/.github/workflows/ci.yml"
    owner="$(detect_owner)"
    if [ -n "$owner" ]; then
      edit_file "$target/.github/workflows/ci.yml" -e "s|OWNER/plinth/|${owner}/plinth/|g"
      echo "  created:       .github/workflows/ci.yml (OWNER='$owner' auto-detected)"
    else
      echo "  created:       .github/workflows/ci.yml — WARNING: owner undetected, edit OWNER manually"
    fi
    # Pin the reusable-workflow refs to the SHA of the Plinth release being
    # installed (immutable — no mutable tag to trust or suppress). If HEAD can't be
    # resolved (non-git checkout), fail LOUD instead: the else branch rewrites the
    # refs to an unpinned sentinel so CI errors until the operator pins them — never
    # a silently-stale floor. BRE-portable sed (no alternation) for macOS BSD sed.
    psha="$(git -C "$PLINTH_ROOT" rev-parse HEAD 2>/dev/null || true)"
    if [ -n "$psha" ]; then
      # EVERY reusable ref the template ships must be repinned here. The receipt
      # job especially: its template placeholder SHA PREDATES plinth-receipt.yml,
      # so a missed repin leaves a `uses:` ref GitHub cannot resolve — the job
      # never runs at all, and the comment rewrite below would still claim it was
      # pinned. Adding a reusable workflow to templates/ci.yml means adding a line
      # here (and to the sentinel branch, and to warn_stale_reusable_refs).
      edit_file "$target/.github/workflows/ci.yml" \
        -e "s|plinth-floor\.yml@[0-9a-f]*|plinth-floor.yml@${psha}|g" \
        -e "s|plinth-checks\.yml@[0-9a-f]*|plinth-checks.yml@${psha}|g" \
        -e "s|plinth-receipt\.yml@[0-9a-f]*|plinth-receipt.yml@${psha}|g" \
        -e "s|# v4\.1\.9 (plinth init repins)|# v${PLINTH_VERSION} (pinned by plinth init from this checkout)|g"
    else
      # Fail LOUD, never silently-stale: if we can't resolve the release commit,
      # replace the shipped fallback SHA with an UNPINNED sentinel so CI errors on
      # the unresolved ref until the operator pins it — rather than quietly running
      # a prior release's floor/checks. BRE-portable sed (backref, no alternation).
      edit_file "$target/.github/workflows/ci.yml" \
        -e "s|\(plinth-floor\.yml@\)[0-9a-f]*|\1PIN_TO_YOUR_PLINTH_RELEASE_COMMIT|g" \
        -e "s|\(plinth-checks\.yml@\)[0-9a-f]*|\1PIN_TO_YOUR_PLINTH_RELEASE_COMMIT|g" \
        -e "s|\(plinth-receipt\.yml@\)[0-9a-f]*|\1PIN_TO_YOUR_PLINTH_RELEASE_COMMIT|g" \
        -e "s|# v4\.1\.9 (plinth init repins)|# UNPINNED — set to your Plinth release commit SHA|g"
      echo "  ci.yml:        WARNING — could not resolve the Plinth commit SHA (PLINTH_ROOT is not a"
      echo "                 git checkout?). Left the reusable-workflow refs UNPINNED"
      echo "                 (PIN_TO_YOUR_PLINTH_RELEASE_COMMIT) so CI fails loudly until you set"
      echo "                 them to this Plinth version's commit SHA — no silently-stale floor."
    fi
  fi
}

# NEEDS-HUMAN items are often multi-line markdown: emit one LOGICAL item per
# line (continuations joined), open ("- [ ]") items only, falling back to any
# non-blank content. Shared by watch and `plinth queue`.
open_items() {  # open_items <needs-human-file>
  awk '
    /^- \[ \]/ { if (cur != "") print cur; cur = substr($0, 7); next }
    /^- \[/    { if (cur != "") print cur; cur = ""; next }
    /^#/       { if (cur != "") print cur; cur = ""; next }
    cur != ""  { line = $0; gsub(/^[[:space:]]+|[[:space:]]+$/, "", line);
                 if (line != "") cur = cur " " line; next }
    END        { if (cur != "") print cur }
  ' "$1" 2>/dev/null
}

# Blocking items first (order preserved within each group), so the human sees
# what's stalling work RIGHT NOW at the top. Reads logical items on stdin.
sort_blocking_first() {
  local all blk non
  all="$(cat)"
  blk="$(printf '%s\n' "$all" | grep '^\[BLOCKING\]' || true)"
  non="$(printf '%s\n' "$all" | grep -v '^\[BLOCKING\]' || true)"
  [ -n "$blk" ] && printf '%s\n' "$blk"
  [ -n "$non" ] && printf '%s\n' "$non"
  return 0   # never fail the caller's `x="$(... | sort_blocking_first)"` under set -e:
             # an all-BLOCKING (or all-non-blocking) queue leaves the final test false,
             # which would otherwise abort `plinth queue`/`watch` mid-render.
}

# Full queue, every item, folded to terminal width — the readable, scrollable
# home for long queues (the watch banner caps to what fits the screen).
run_queue() {
  local f; f="$(needs_human_file "$target")"
  [ -s "$f" ] || { echo "plinth queue: nothing pending in $f"; exit 0; }
  local cols wrapw items
  cols="${PLINTH_WATCH_COLS:-$(tput cols 2>/dev/null || echo 100)}"
  [ "$cols" -ge 40 ] 2>/dev/null || cols=100
  wrapw=$((cols - 4))
  items="$(open_items "$f")"
  [ -n "$items" ] || items="$(grep -v '^[[:space:]]*$' "$f")"
  local qb; qb="$(printf '%s\n' "$items" | grep -c '^\[BLOCKING\]' || true)"
  items="$(printf '%s\n' "$items" | sort_blocking_first)"
  echo "⏸ NEEDS-HUMAN — $target ($(printf '%s\n' "$items" | grep -c .) open, $qb blocking; blocking first)"
  local RD=$'\033[1;31m' Z=$'\033[0m'
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    case "$item" in
      '[BLOCKING]'*) printf '%s· %s%s\n' "$RD" "$item" "$Z" | fold -s -w "$wrapw" | sed '2,$s/^/  /' ;;
      *)             printf '· %s\n' "$item" | fold -s -w "$wrapw" | sed '2,$s/^/  /' ;;
    esac
  done <<< "$items"
}

# ── plinth watch ──────────────────────────────────────────────────────────────
# Live session dashboard. Reads the raw event feed (.plinth/session/events.jsonl,
# written by pulse.sh) + the Claude Code transcript it points at + the review
# verdict, and renders task / stage pipeline / tokens / burn / gates every 2s.
# All interpretation lives here in one jq program — events stay raw facts.
render_frame() {
  local EV="$target/.plinth/session/events.jsonl" feedless=0
  if [ ! -f "$EV" ]; then
    # FEEDLESS mode — a codex/grok driver runs no .claude/ hooks, so pulse.sh never
    # creates the feed (same if the hooks are unwired). Do NOT bail: everything that
    # does not come from hooks still renders — review rounds + verdicts (review.sh
    # writes them for EVERY driver), the NEEDS-HUMAN queue, and branch state. The
    # hook-fed lines (task/stage/tokens/model/evidence) stay at their empty defaults.
    feedless=1; EV=/dev/null
    printf '\033[2m  no event feed (non-Claude driver, or pulse.sh unwired — CHANGELOG v3.8): hook-fed lines blank; review/queue/branch state live\033[0m\n'
  fi
  local transcript head branch slug
  transcript="$(jq -rs '[.[] | select(.transcript != null)] | last | .transcript // empty' "$EV" 2>/dev/null)"
  [ -f "$transcript" ] || transcript=/dev/null
  head="$(git -C "$target" rev-parse --short HEAD 2>/dev/null || echo '-')"
  branch="$(git -C "$target" symbolic-ref --short -q HEAD 2>/dev/null || echo '-')"
  slug="$(printf '%s' "$branch" | tr '/ ' '--')"
  local vfile="$target/.plinth/session/review/$slug/verdict.json"; [ -f "$vfile" ] || vfile=/dev/null
  local ufile="$target/.plinth/session/review/$slug/usage.jsonl"; [ -f "$ufile" ] || ufile=/dev/null
  # A round in flight: the newest request-N.json outruns verdict.json.
  local rqfile
  rqfile="$(ls "$target/.plinth/session/review/$slug"/request-*.json 2>/dev/null | sort -t- -k2 -n | tail -1 || true)"
  [ -n "$rqfile" ] && [ -f "$rqfile" ] || rqfile=/dev/null
  local rfile="$target/.plinth/session/run/$slug/receipt.json"; [ -f "$rfile" ] || rfile=/dev/null
  local nh="" nhn=0 nhb=0 nhf; nhf="$(needs_human_file "$target")"
  if [ -s "$nhf" ]; then
    # Open items = unchecked boxes; fall back to any non-blank line.
    # Full text, every item, SOFTWARE-WRAPPED to the terminal width with a
    # hanging indent: the in-place repaint assumes one logical line per
    # physical row, so we must never rely on the terminal to wrap.
    local raw cols wrapw item rows budget used=0 shown=0 folded flines
    raw="$(open_items "$nhf")"
    [ -n "$raw" ] || raw="$(grep -v '^[[:space:]]*$' "$nhf")"
    nhn="$(printf '%s\n' "$raw" | grep -c . || true)"
    nhb="$(printf '%s\n' "$raw" | grep -c '^\[BLOCKING\]' || true)"
    raw="$(printf '%s\n' "$raw" | sort_blocking_first)"   # blocking to the top
    cols="${PLINTH_WATCH_COLS:-$(tput cols 2>/dev/null || echo 100)}"
    [ "$cols" -ge 40 ] 2>/dev/null || cols=100
    wrapw=$((cols - 6))
    # The frame must fit the screen or the repaint loses its top: show as many
    # COMPLETE items as fit, then point at `plinth queue` for the rest.
    rows="${PLINTH_WATCH_ROWS:-$(tput lines 2>/dev/null || echo 40)}"
    [ "$rows" -ge 24 ] 2>/dev/null || rows=40
    # Reserve = fixed frame (~18 rows: banner, branch, models, pipeline+Σ, CI,
    # tokens/burn/review/run/evidence/signals/now) + queue sep/header + footer.
    budget=$((rows - 23)); [ "$budget" -ge 2 ] || budget=2
    # Each physical line carries a 1-char tag jq reads for color: "!" blocking,
    # " " normal. Blocking items are already partitioned to the top.
    local tag
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      case "$item" in '[BLOCKING]'*) tag='!' ;; *) tag=' ' ;; esac
      folded="$(printf '%s\n' "· $item" | fold -s -w "$wrapw" | sed '2,$s/^/  /')"
      flines="$(printf '%s\n' "$folded" | wc -l | tr -d ' ')"
      if [ $((used + flines)) -gt "$budget" ] && [ "$shown" -gt 0 ]; then break; fi
      while IFS= read -r pl; do nh+="${tag}${pl}"$'\n'; done <<< "$folded"
      used=$((used + flines)); shown=$((shown + 1))
      [ "$used" -ge "$budget" ] && break
    done <<< "$raw"
    if [ "$shown" -lt "$nhn" ]; then
      nh+=" … +$((nhn - shown)) more — full queue: plinth queue $target"$'\n'
    fi
    nh="${nh%$'\n'}"
  fi

  # Live CI row once the feed shows a PR: pull the check rollup from GitHub.
  # PLINTH_CI_STATUS ('{"pass":N,"fail":N,"pending":N}') overrides for non-gh CIs.
  local ci="null"
  if [ -n "${PLINTH_CI_STATUS:-}" ]; then
    ci="$PLINTH_CI_STATUS"
  elif grep -qE 'gh pr (create|merge)' "$EV" 2>/dev/null && command -v gh >/dev/null 2>&1; then
    ci="$( (cd "$target" && gh pr view --json statusCheckRollup 2>/dev/null) | jq -c '
      {pass:    ([.statusCheckRollup[]? | select(.conclusion=="SUCCESS" or .state=="SUCCESS")] | length),
       fail:    ([.statusCheckRollup[]? | select(.conclusion=="FAILURE" or .conclusion=="ERROR" or .conclusion=="CANCELLED" or .state=="FAILURE" or .state=="ERROR")] | length),
       pending: ([.statusCheckRollup[]? | select(.status=="IN_PROGRESS" or .status=="QUEUED" or .status=="PENDING" or .state=="PENDING")] | length)}' 2>/dev/null)"
    [ -n "$ci" ] || ci="null"
  fi

  jq -rn --slurpfile ev "$EV" --slurpfile tr "$transcript" --slurpfile vd "$vfile" \
        --slurpfile us "$ufile" --slurpfile rc "$rfile" --slurpfile rq "$rqfile" \
        --arg nh "$nh" --argjson nhn "${nhn:-0}" --argjson nhb "${nhb:-0}" \
        --arg head "$head" --arg branch "$branch" --argjson ci "$ci" '
    # ---------- helpers ----------
    def B: "[1m";  def D: "[2m";  def R: "[0m";
    def CY: "[36m"; def GR: "[32m"; def YE: "[33m";
    def RD: "[31m"; def MG: "[35m"; def RV: "[7m";
    def rpad(n): (. + (" " * n))[0:n];
    def hum_t: if . == null or . < 0 then "—"
      elif . < 60 then "\(. | floor)s"
      elif . < 3600 then "\((. / 60) | floor)m \((. % 60) | floor)s"
      else "\((. / 3600) | floor)h \(((. % 3600) / 60) | floor)m" end;
    def hum_k: if . == null then "—"
      elif . >= 1000000 then "\(. / 1000000 * 10 | floor / 10)M"
      elif . >= 1000 then "\(. / 1000 * 10 | floor / 10)k"
      else "\(.)" end;
    def ago($now): ($now - .) | hum_t + " ago";

    ($ev | map(select(type == "object"))) as $all
    | (now | floor) as $NOW
    # focus: the most recently ACTIVE session — not the last SessionStart;
    # sessions that predate their own wiring have no start event (certeus bug)
    | (([$all[] | select(.sid != null)] | .[-1].sid)) as $sid
    | ($all | map(select(.sid == $sid))) as $sev
    | if ($sev | length) == 0 then
        # REDUCED frame — no session events (feedless: a codex/grok driver runs no
        # .claude/ hooks; or a wired session that has not pulsed yet). Render what
        # does NOT come from hooks: identity, review state (review.sh writes it for
        # every driver), and the NEEDS-HUMAN queue.
        ([ (B + "  " + $branch + " @ " + $head + R + "  " + D + "(no session events)" + R),
           (($vd[0] // null) as $v |
             if $v == null then (D + "  review: none yet on this branch" + R)
             else ("  review: " +
               (if ($v.verdict // "") == "APPROVED" then GR else RD end) + ($v.verdict // "?") + R +
               D + " @ " + (($v.sha // "")[0:7]) + " round " + (($v.round // "?") | tostring) +
               " tier " + (($v.risk.tier // "?") | tostring) + R)
             end),
           (if $nhn > 0
            then (RD + "  NEEDS-HUMAN: " + ($nhn | tostring) + " open (" + ($nhb | tostring) + " blocking)" + R + "\n" + $nh)
            else empty end)
         ] | join("\n"))
      else

    ($sev[0].epoch) as $t0
    # ---------- stage classification (facts -> stages, renderer-side only) ----------
    | def stage_of:
        if .event == "PostToolUse" and (.tool == "Edit" or .tool == "Write" or .tool == "MultiEdit" or .tool == "NotebookEdit")
        then "IMPLEMENT"
        elif .event == "PostToolUse" and .tool == "Bash" then
          ((.detail // "") |
            if test("review\\.sh") then "REVIEW"
            elif test("gh pr (create|merge)") then "PR"
            elif test("(^|[;&|(\\s])(pytest|go test|cargo (test|nextest|check)|npm (test|run test)|yarn test|pnpm test|python3? -m (pytest|unittest)|make (test|check)|mix test|rspec|jest|vitest|tox|swift test)")
            then "VERIFY" else null end)
        else null end;
    ([{e: $t0, s: "PLAN"}] + [$sev[] | (stage_of) as $s | select($s != null) | {e: .epoch, s: $s}]) as $marks
    # collapse consecutive same-stage marks, then close segments
    | ($marks | reduce .[] as $m ([]; if ((.[-1].s) // "") == $m.s then . else . + [$m] end)) as $tx
    | [range(0; $tx | length) | {s: $tx[.].s, a: $tx[.].e, b: (if . + 1 < ($tx | length) then $tx[. + 1].e else $NOW end)}] as $segs
    | ($segs[-1].s) as $cur
    # ---------- tokens from the transcript ----------
    | ($tr | map(select(type == "object" and .type == "assistant" and (.message.usage? != null))
        | {e: ((.timestamp // "") | sub("\\.[0-9]+Z$"; "Z") | try fromdate catch null),
           i: (.message.usage.input_tokens // 0), cc: (.message.usage.cache_creation_input_tokens // 0),
           cr: (.message.usage.cache_read_input_tokens // 0), o: (.message.usage.output_tokens // 0),
           m: (.message.model // null)}
        | select(.e != null))) as $use
    | {i: ($use | map(.i) | add // 0), cc: ($use | map(.cc) | add // 0),
       cr: ($use | map(.cr) | add // 0), o: ($use | map(.o) | add // 0)} as $tot
    | ([$segs | group_by(.s)[] | {s: .[0].s,
         t: (map(.b - .a) | add),
         k: (map(. as $g | [$use[] | select(.e >= $g.a and .e < $g.b) | .i + .cc + .o] | add // 0) | add)}]) as $per
    | ([$use[] | select(.e > $NOW - 300) | .i + .cc + .o] | add // 0) as $last5
    # sparkline: 12 one-minute buckets
    | (["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]) as $bars
    | ([range(0; 12) | . as $b | [$use[] | select(.e > $NOW - (12 - $b) * 60 and .e <= $NOW - (11 - $b) * 60) | .i + .cc + .o] | add // 0]) as $bkt
    | (($bkt | max) // 0) as $bmax
    | ($bkt | map(if $bmax == 0 then "▁" else $bars[(. / $bmax * 7) | floor] end) | join("")) as $spark
    # ---------- signals ----------
    | ([$all[] | select(.event == "guard_block" and .epoch >= $t0)] | length) as $blocks
    | ([$all[] | select(.event == "gate_release" and .epoch >= $t0)] | length) as $releases
    | ([$sev[] | select(.event == "PreCompact")] | length) as $compacts
    | ([$sev[] | select(.event == "SubagentStop")] | length) as $subs
    | (([$sev[] | select(.event == "UserPromptSubmit") | .detail // ""
         | select((test("^\\s*<") | not) and length > 0)] | .[-1]) // "(no prompt recorded)") as $task
    | ([$sev[] | select((stage_of) == "VERIFY")] | .[-1]) as $evd
    | ([$sev[] | select(.event == "PostToolUse")] | .[-1]) as $lastact
    | (($use | map(.m) | map(select(. != null)) | .[-1]) // "—") as $model
    | ($vd[0] // null) as $V
    # ---------- frame ----------
    | (["PLAN", "IMPLEMENT", "VERIFY", "REVIEW", "PR"]) as $ORDER
    | ([ $ORDER[] | . as $s | ($per | map(select(.s == $s)) | .[0]) as $p
        | if $p == null then D + "   " + ($s | rpad(10)) + ("—" | rpad(10)) + "—" + R
          elif $s == $cur then RV + B + " ▶ " + ($s | rpad(10)) + (($p.t | hum_t) | rpad(10)) + (($p.k | hum_k) + " tok")
               + "  · now " + ((($NOW - $segs[-1].a) | hum_t)) + R
          else GR + " ✓ " + R + ($s | rpad(10)) + (($p.t | hum_t) | rpad(10)) + D + (($p.k | hum_k) + " tok") + R
          end ] | join("\n")) as $pipe0
    | ($pipe0 + "\n" + D + " Σ TOTAL    " + ((($per | map(.t) | add) // 0 | hum_t) | rpad(10))
        + ((($per | map(.k) | add) // 0 | hum_k) + " tok") + R) as $pipe0
    | ($pipe0 + (if $ci == null then "" else "\n"
        + (if ($ci.fail // 0) > 0 then RD elif ($ci.pending // 0) > 0 then YE else GR end)
        + "   CI        " + "✓\($ci.pass // 0)  ✗\($ci.fail // 0)  ◌\($ci.pending // 0)" + R end)) as $pipe
    | (($rq[0] // null) as $RQ
       | if $RQ != null and ($RQ.round // 0) > (($V.round // 0)) then
           YE + "round \($RQ.round) RUNNING (\($RQ.mode))" + R
           + (($RQ.ts // "" | sub("\\.[0-9]+Z$"; "Z") | try fromdate catch null) as $rs
              | if $rs != null then D + " · " + (($NOW - $rs) | hum_t) + " in" + R else "" end)
           + D + " · last verdict: " + ($V.verdict // "none") + " r\($V.round // 0)" + R
         else null end) as $running
    | (if $running != null then $running
       elif $V == null then D + "no review round yet — ./.plinth/review.sh" + R
       else ((if $V.verdict == "APPROVED" then GR elif $V.verdict == "UNBOUND" then YE else YE end) + $V.verdict + R
         + D + " · round " + ($V.round | tostring) + " @ " + ($V.sha[0:7]) + R
         + (if ($V.sha[0:7]) == $head then GR + " = HEAD ✓" + R else RD + " ≠ HEAD " + $head + " — stale, re-run review" + R end)
         + (if $V.usage then D + " · reviewer " + ($V.usage.input_tokens | hum_k) + " in / " + ($V.usage.output_tokens | hum_k) + " out" + R else "" end)
         + (($us | map(.usage.input_tokens // 0) | add // 0) as $rtot
            | if $rtot > 0 then D + " · Σ " + ($rtot | hum_k) + " in" + R else "" end)
         + (if $V.audit then (if ($V.audit.verdict // "") == "UNAVAILABLE" then YE + " · audit unavailable" + R elif ($V.audit.blocking // 0) > 0 then RD + " · AUDIT DISAGREES (\($V.audit.blocking))" + R else D + " · audit ✓" + R end) else "" end))
       end) as $review
    | (if ($rc | length) == 0 then D + "no run receipt — RUNTIME findings await plinth smoke" + R
       else ($rc[0]) as $R
         | (if ($R.exit // 1) == 0 then GR + "exit 0" + R else RD + "exit \($R.exit)" + R end)
           + D + " · " + (($R.cmd // "?")[0:44]) + " · " + (($R.ended // $NOW) | ago($NOW)) + " @ " + (($R.sha // "")[0:7]) + R
       end) as $runline
    | (if $evd == null then D + "no test runner seen this session" + R
       else ($evd.detail[0:56])
         + (if $evd.rc == 0 then GR + " → exit 0" + R
            elif $evd.rc != null then RD + " → exit \($evd.rc)" + R
            else D + " → ran" + R end)
         + D + " · " + ($evd.epoch | ago($NOW)) + R
       end) as $evidence
    | (if $lastact == null then D + "—" + R
       else ($lastact.tool // "?") + D + " " + (($lastact.detail // "")[0:56]) + " · " + ($lastact.epoch | ago($NOW)) + R end) as $nowline

    | ($V.model // null) as $rmodel
    | B + CY + " ◤ PLINTH WATCH " + R + B + ($task[0:58]) + R + "\n"
    + D + "   " + $branch + " @ " + $head + " · session " + (($NOW - $t0) | hum_t) + R + "\n"
    + B + " models   " + R + "driver " + CY + $model + R
      + "  ·  reviewer " + CY + ($rmodel // "—") + R
      + (if $rmodel == null then D + " (no review yet)" + R else "" end) + "\n"
    + D + " ─────────────────────────────────────────────────────────────────" + R + "\n"
    + $pipe + "\n"
    + D + " ─────────────────────────────────────────────────────────────────" + R + "\n"
    + B + " tokens   " + R + (($tot.i + $tot.cc + $tot.cr + $tot.o) | hum_k)
      + D + "  (in " + ($tot.i | hum_k) + " · cache-write " + ($tot.cc | hum_k) + " · cache-read " + ($tot.cr | hum_k) + " · out " + ($tot.o | hum_k) + ")" + R + "\n"
    + B + " burn     " + R + (($last5 / 5 | floor) | hum_k) + "/min  " + MG + $spark + R + D + "  (last 12 min, fresh+out)" + R + "\n"
    + B + " review   " + R + $review + "\n"
    + B + " run      " + R + $runline + "\n"
    + B + " evidence " + R + $evidence + "\n"
    + B + " signals  " + R
      + (if $blocks > 0 then RD + "guard blocks \($blocks)" + R else D + "guard blocks 0" + R end)
      + (if $releases > 0 then RD + " · GATE RELEASES \($releases) — unreviewed work escaped the session gate" + R
         else D + " · gate releases 0" + R end)
      + D + " · compactions \($compacts) · subagent runs \($subs)" + R + "\n"
    + B + " now      " + R + $nowline
    # Variable-height content lives at the BOTTOM: the fixed dashboard keeps a
    # stable screen position; the queue grows downward where it displaces nothing.
    + (if $nh != "" then
         "\n" + D + " ─────────────────────────────────────────────────────────────────" + R + "\n"
         + (if $nhb > 0 then B + RD + RV else RD + RV end)
           + " ⏸ NEEDS HUMAN (\($nhn) open\(if $nhb > 0 then " · \($nhb) BLOCKING" else "" end)) " + R + "\n"
         # Per-line tag: "!" blocking -> bold bright red; " " normal -> dim.
         + ([$nh | split("\n")[] | select(length > 0)
             | if (.[0:1]) == "!" then B + RD + "   " + (.[1:]) + R
               else D + "   " + (.[1:]) + R end] | join("\n"))
       else "" end)
    end
  ' 2>/dev/null || echo "plinth watch: render error (malformed event or transcript line?)"
}

# Execution evidence: run a real command and write a SHA-bound receipt the
# review loop consumes (RUNTIME findings get verified against observation,
# not guesses). Failures are data — the receipt records them the same way.
run_smoke() {
  shift 2   # drop 'smoke' <path>
  [ "${1:-}" = "--" ] && shift
  [ $# -ge 1 ] || usage
  local br rslug rdir ts log start end rc=0
  br="$(git -C "$target" symbolic-ref --short -q HEAD 2>/dev/null || echo detached)"
  rslug="$(printf '%s' "$br" | tr '/ ' '--')"
  rdir="$target/.plinth/session/run/$rslug"
  mkdir -p "$rdir"
  [ -f "$target/.plinth/session/.gitignore" ] || printf '*\n' > "$target/.plinth/session/.gitignore"
  ts="$(date -u +%Y%m%dT%H%M%SZ)"; log="$rdir/smoke-$ts.log"
  echo "plinth smoke [$br]: $*"
  start="$(date +%s)"
  ( cd "$target" && "$@" ) 2>&1 | tee "$log" || rc=$?
  end="$(date +%s)"
  jq -n --arg sha "$(git -C "$target" rev-parse HEAD 2>/dev/null || echo none)" \
        --arg branch "$br" --arg cmd "$*" --argjson exit "${rc:-0}" \
        --argjson started "$start" --argjson ended "$end" \
        --arg hw "$(uname -m) · $(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -s)" \
        --arg log "$log" --arg tail "$(tail -n 40 "$log" 2>/dev/null)" \
        '{sha: $sha, branch: $branch, cmd: $cmd, exit: $exit, started: $started, ended: $ended,
          secs: ($ended - $started), hw: $hw, log: $log, log_tail: $tail}' \
        > "$rdir/receipt.json"
  echo "plinth smoke: exit ${rc:-0} in $((end - start))s · receipt: $rdir/receipt.json"
  exit "${rc:-0}"
}

# One-line renderer for Claude Code's statusLine setting. Reads the statusLine
# JSON on stdin (workspace dir), or takes an explicit project path. Consults
# only the event feed + verdict — no transcript parse, cheap at statusline
# cadence. Token economics stay on `plinth watch`.
statusline_render() {
  local in dir
  in="$(cat 2>/dev/null || true)"
  dir="$target"
  [ -n "$dir" ] || dir="$(printf '%s' "$in" | jq -r '.workspace.current_dir // .cwd // empty' 2>/dev/null)"
  { [ -n "$dir" ] && [ -d "$dir" ]; } || exit 0
  local EV="$dir/.plinth/session/events.jsonl"
  [ -f "$EV" ] || { printf 'plinth: no session feed'; exit 0; }
  local head vfile
  head="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo '-')"
  local sslug nh=""
  sslug="$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null | tr '/ ' '--')"
  vfile="$dir/.plinth/session/review/${sslug:-detached}/verdict.json"; [ -f "$vfile" ] || vfile=/dev/null
  local nhblk="" nhf; nhf="$(needs_human_file "$dir")"
  if [ -s "$nhf" ]; then
    nh="$(grep -cE '^- \[ \]' "$nhf" 2>/dev/null || echo 1)"
    nhblk="$(grep -cE '^- \[ \] \[BLOCKING\]' "$nhf" 2>/dev/null || true)"
    [ "$nhblk" != "0" ] && [ -n "$nhblk" ] && nh="${nh}⛔${nhblk}"
  fi
  jq -rn --slurpfile ev "$EV" --slurpfile vd "$vfile" --arg head "$head" --arg nh "$nh" '
    def hum_t: if . < 60 then "\(. | floor)s" elif . < 3600 then "\((. / 60) | floor)m"
      else "\((. / 3600) | floor)h\(((. % 3600) / 60) | floor)m" end;
    ($ev | map(select(type == "object"))) as $all
    | (now | floor) as $NOW
    | (([$all[] | select(.sid != null)] | .[-1].sid)) as $sid
    | ($all | map(select(.sid == $sid))) as $sev
    | if ($sev | length) == 0 then "plinth: no session" else
      ($sev[0].epoch) as $t0
      | def stage_of:
          if .event == "PostToolUse" and (.tool == "Edit" or .tool == "Write" or .tool == "MultiEdit" or .tool == "NotebookEdit")
          then "IMPLEMENT"
          elif .event == "PostToolUse" and .tool == "Bash" then
            ((.detail // "") |
              if test("review\\.sh") then "REVIEW"
              elif test("gh pr (create|merge)") then "PR"
              elif test("(^|[;&|(\\s])(pytest|go test|cargo (test|nextest|check)|npm (test|run test)|yarn test|pnpm test|python3? -m (pytest|unittest)|make (test|check)|mix test|rspec|jest|vitest|tox|swift test)")
              then "VERIFY" else null end)
          else null end;
      (([{e: $t0, s: "PLAN"}] + [$sev[] | (stage_of) as $s | select($s != null) | {e: .epoch, s: $s}])
        | reduce .[] as $m ([]; if ((.[-1].s) // "") == $m.s then . else . + [$m] end) | .[-1]) as $cur
      | ($vd[0] // null) as $V
      | (if $V == null then "no review"
         elif $V.verdict == "APPROVED" and ($V.sha[0:7]) == $head then "APPROVED ✓"
         elif $V.verdict == "APPROVED" then "APPROVED (stale)"
         elif $V.verdict == "UNBOUND" then "UNBOUND r\($V.round)"
         else "CHANGES r\($V.round)" end) as $rv
      | ([$all[] | select(.event == "guard_block" and .epoch >= $t0)] | length) as $b
      | ([$all[] | select(.event == "gate_release" and .epoch >= $t0)] | length) as $r
      | "◆ " + $cur.s + " " + (($NOW - $cur.e) | hum_t) + " · " + $rv
        + (if $nh != "" and $nh != "0" then " · ⏸ HUMAN×" + $nh else "" end)
        + (if $b > 0 then " · guard⛔\($b)" else "" end)
        + (if $r > 0 then " · RELEASED \($r)" else "" end)
      end'
}

# Inside $(render_frame) tput talks to a pipe and reports 24×80 regardless of
# the real window, starving the queue budget. Read the size from the TTY and
# hand it down via the PLINTH_WATCH_* overrides (honoring any the user set).
capture_tty_size() {
  local _sz
  # Test that the controlling tty can actually be OPENED (a device node may
  # exist but be unconfigured, e.g. a headless/background context) — the
  # subshell swallows the open error instead of leaking it to stderr.
  ( : </dev/tty ) 2>/dev/null || return 0   # no controlling tty: keep default sizing
  if _sz="$(stty size </dev/tty 2>/dev/null)"; then
    [ -n "${PLINTH_WATCH_ROWS_USER:-}" ] || export PLINTH_WATCH_ROWS="${_sz% *}"
    [ -n "${PLINTH_WATCH_COLS_USER:-}" ] || export PLINTH_WATCH_COLS="${_sz#* }"
  fi
}

watch_project() {
  # User-provided sizes win permanently; otherwise track the TTY per repaint.
  [ -n "${PLINTH_WATCH_ROWS:-}" ] && export PLINTH_WATCH_ROWS_USER=1
  [ -n "${PLINTH_WATCH_COLS:-}" ] && export PLINTH_WATCH_COLS_USER=1
  if [ "$opt" = "--once" ]; then capture_tty_size; render_frame; exit 0; fi
  local EV="$target/.plinth/session/events.jsonl"
  local wslug VD
  wslug="$(git -C "$target" symbolic-ref --short -q HEAD 2>/dev/null | tr '/ ' '--')"
  VD="$target/.plinth/session/review/${wslug:-detached}/verdict.json"
  # mtime+size stamp, BSD then GNU stat.
  fstamp() { stat -f '%m %z' "$1" 2>/dev/null || stat -c '%Y %s' "$1" 2>/dev/null || echo 0; }
  # Alt screen + hidden cursor; restore on exit. Clear once at startup only.
  printf '\033[?1049h\033[?25l\033[2J'
  trap 'printf "\033[?25h\033[?1049l"; exit 0' INT TERM
  local last="" beat=10 stamp frame
  while :; do
    # Cheap 1s poll on file stamps; re-render (jq over feed + transcript) only
    # on change, plus a 10s heartbeat so elapsed/ago clocks stay live.
    stamp="$(fstamp "$EV") $(fstamp "$VD")"
    if [ "$stamp" != "$last" ] || [ "$beat" -ge 10 ]; then
      last="$stamp"; beat=0
      capture_tty_size   # per repaint: window resizes tracked
      # Repaint in place: home cursor, overwrite each line erasing its tail
      # (ESC[K), then erase below the frame (ESC[J). No full clear, no blink.
      frame="$(render_frame; printf '\n\033[2m  live — repaints on activity · plinth queue for the full list · ctrl-c to quit\033[0m')"
      # HARD CAP: never emit more lines than the viewport. One extra line
      # scrolls the terminal, and the next cursor-home lands mid-frame — the
      # top (identity, models) rolls off. Capping preserves the top always;
      # the queue budget already keeps the important rows above the cut.
      local trows="${PLINTH_WATCH_ROWS:-$(tput lines 2>/dev/null || echo 40)}"
      [ "$trows" -ge 10 ] 2>/dev/null || trows=40
      printf '\033[H'
      printf '%s\n' "$frame" | head -n $((trows - 1)) | sed $'s/$/\033[K/'
      printf '\033[J'
    fi
    beat=$((beat + 1))
    sleep 1
  done
}

# plinth advise [--impactful] "<question>" — consult a model as good or BETTER than
# the driver, READ-ONLY, and print its guidance. COLLABORATIVE + non-blocking +
# driver-initiated (distinct from the adversarial reviewer and the auditor). Works
# for ANY driver and cross-family: a grok driver with advisor_vendor=claude consults
# Fable. --impactful (architectural / high-consequence / irreversible-shape decisions,
# NOT merely "hard") escalates to advisor_model_max. A router could later replace this
# dispatch without changing the surface (advisor_vendor/advisor_model/_max). If the
# advisor CLI is missing or unauthed, say so and let the driver proceed — never a hard
# dependency.
run_advise() {
  shift  # drop 'advise'
  local impactful=0
  if [ "${1:-}" = "--impactful" ]; then impactful=1; shift; fi
  local question="${1:-}"
  [ -n "$question" ] || { echo "usage: plinth advise [--impactful] \"<question>\"" >&2; exit 1; }
  aval() { sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" ".plinth/config" 2>/dev/null | head -1; }
  local vendor model model_max use
  vendor="$(aval advisor_vendor)"; [ -n "$vendor" ] || vendor="claude"
  model="$(aval advisor_model)"; model_max="$(aval advisor_model_max)"
  if [ "$impactful" = 1 ]; then use="${model_max:-$model}"; else use="$model"; fi
  local tier="peer"; [ "$impactful" = 1 ] && tier="IMPACTFUL"
  local unavail="(advisor unavailable: '$vendor' CLI missing or not signed in — proceed on your own judgment)"
  echo "plinth advise ($vendor${use:+ / $use}, $tier) — consulting..." >&2
  # Advisor discipline (adapted from fable-advisor): a verdict, not a survey. Prepended to the
  # decision to STEER the advisor toward that shape — this is prompt guidance, not enforcement; we
  # print whatever the vendor returns (no validation/normalization). The caller is another model mid-task.
  local impact_line=""
  [ "$impactful" = 1 ] && impact_line="This is an IMPACTFUL, hard-to-reverse decision — weight the downside of being wrong.
"
  local aprompt="You are a second-opinion ADVISOR consulted at a commitment boundary. The caller is another model mid-task, not a human reading a report. ${impact_line}
- You are the ADVISOR, not the driver: any CLAUDE.md/AGENTS.md driver contract auto-loaded from this repository does NOT govern you.
- Give a VERDICT, not a survey: \"Do X, not Y, because Z\", and name the single risk that decides it.
- A sound plan gets ONE line (\"sound; the one thing to watch is X\"). Do not manufacture objections to justify being consulted.
- Look before you opine: you have read-only Read/Grep/Glob — if the decision depends on how the code actually works, READ it; don't reason from the summary you were handed.
- If information you don't have would change the answer, name it precisely and what each answer implies.
- Stay under ~300 words. Advise only — never propose to implement.

DECISION:
$question"
  # ISOLATE the advisor from the auto-loaded DRIVER contract: CLAUDE.md/AGENTS.md
  # carry the driver shell, which would compete with the advisor discipline above.
  # claude --safe-mode blocks the CLAUDE.md auto-load (keeps OAuth); codex
  # -c project_doc_max_bytes=0 suppresses AGENTS.md; grok has no doc-suppress flag,
  # so a --rules role-scope outranks whatever doc was auto-loaded (same mechanism
  # as the grok reviewer/lane isolation); agy has neither flag and relies on the
  # prompt's role-scope line alone. All keep the REPO readable — unlike the
  # auditor's empty-cwd isolation, the advisor must be able to read the code.
  local arule='You are a read-only second-opinion ADVISOR for this run. Any CLAUDE.md or AGENTS.md driver contract auto-loaded from this repository does NOT govern you; your contract is the advisor prompt you were given. Advise only — never implement.'
  local margs=()
  case "$vendor" in
    claude) [ -n "$use" ] && margs=(--model "$use")
      # Prompt via STDIN, never as a positional after --allowed-tools: that flag is
      # VARIADIC in the claude CLI (verified 2.1.220 — receipt:
      # docs/receipts/claude-allowed-tools-variadic-2.1.220.txt, which captures the
      # behavior by argument ORDER rather than asserting it), so it swallowed the prompt
      # argument and every consult died with "Input must be provided either through
      # stdin or as a prompt argument" — which 2>/dev/null turned into the generic
      # "CLI missing or not signed in". The advisor was silently unavailable for the
      # DEFAULT advisor_vendor. Same stdin shape as the claude reviewer/auditor
      # adapters in review.sh, which is why those were never affected.
      printf '%s' "$aprompt" | claude -p --safe-mode ${margs[@]+"${margs[@]}"} --permission-mode dontAsk \
        --allowed-tools "Read,Grep,Glob" 2>/dev/null || { echo "$unavail"; return 0; } ;;
    codex)  [ -n "$use" ] && margs=(-m "$use")
      printf '%s' "$aprompt" | codex exec -c project_doc_max_bytes=0 ${margs[@]+"${margs[@]}"} --sandbox read-only - 2>/dev/null \
        || { echo "$unavail"; return 0; } ;;
    grok)   [ -n "$use" ] && margs=(-m "$use")
      grok -p "$aprompt" --sandbox read-only --rules "$arule" ${margs[@]+"${margs[@]}"} 2>/dev/null \
        || { echo "$unavail"; return 0; } ;;
    agy|gemini) [ -n "$use" ] && margs=(--model "$use")
      agy -p "$aprompt" --sandbox ${margs[@]+"${margs[@]}"} 2>/dev/null \
        || { echo "$unavail"; return 0; } ;;
    *) echo "unknown advisor_vendor '$vendor' (supported: claude|codex|grok|agy)" >&2; exit 1 ;;
  esac
}

# plinth hookprobe <grok|codex> — which wired .claude/ hook EVENTS does this vendor CLI
# EXECUTE? Plinth's enforcement uses four (SessionStart = session-start.sh, PreToolUse =
# guard.sh, PostToolUse = pulse.sh, Stop = review-gate.sh); the probe wires a marker for
# EACH in a SCRATCH repo, drives the CLI through one trivial command (one small model
# call, wall-clock capped), and reports each event separately — a driver could execute
# some events and not others; a NOT-invoked event is certainly unenforced, and an
# invoked one is necessary-but-not-sufficient (enforcement also needs Claude-shaped
# stdin + env — verify end-to-end). The answer is
# VERSION/ENVIRONMENT-dependent; vendor docs and prose claims both go stale — this probe
# is the source of truth. Exit 0 = ALL FOUR executed; 1 = none or some (each named);
# 2 = usage; 3 = CLI missing; 4 = INCONCLUSIVE: timed out (PLINTH_HOOKPROBE_TIMEOUT,
# default 120s), the CLI never executed the probe sentinel (unauth/sandbox/model
# failure), or it exited nonzero AFTER the sentinel (a late failure could swallow
# late hook events such as Stop) — an inconclusive run is never hook evidence.
run_hookprobe() {
  shift  # drop 'hookprobe'
  # EXACTLY one vendor argument — no silent default (a bare `plinth hookprobe` must not
  # start a real model call), no ignored surplus args.
  [ "$#" = 1 ] || { echo "usage: plinth hookprobe <grok|codex>" >&2; exit 2; }
  local vendor="$1" d marker ver p ev report="" allfired=1 fired vrc=0
  local evs="SessionStart PreToolUse PostToolUse Stop"
  case "$vendor" in grok|codex) : ;; *) echo "usage: plinth hookprobe <grok|codex>" >&2; exit 2 ;; esac
  command -v "$vendor" >/dev/null 2>&1 || { echo "hookprobe: '$vendor' CLI not installed"; exit 3; }
  local d marker
  d="$(mktemp -d)" || { echo "hookprobe: could not create a scratch dir — INCONCLUSIVE (setup failed)"; exit 4; }
  marker="$d/hookmark"
  # The marker also CAPTURES stdin per event: Plinth's real hooks need Claude-shaped
  # JSON on stdin (and CLAUDE_PROJECT_DIR) to enforce anything, so invocation alone is
  # necessary but NOT sufficient — the report distinguishes the two.
  # Guard the whole setup subshell: under set -e a failed git-init/mkdir/probe-write/chmod would
  # exit 1 and COLLIDE with the NONE/SOME result code. A setup failure is not evidence about which
  # events fired — it must surface as INCONCLUSIVE (exit 4), never as "executed NONE".
  # SHELL-QUOTE $marker/$d before embedding them in the generated probe.sh: a TMPDIR containing a
  # quote, backtick, or $() would otherwise corrupt the script or execute command substitution when
  # the hook runs — and a corrupted probe.sh means the marker never gets written, so hookprobe would
  # FALSELY report NONE. printf %q makes each path a safe single shell token in the emitted source.
  local qmarker qd
  qmarker="$(printf '%q' "$marker")"; qd="$(printf '%q' "$d")"
  ( cd "$d" && git init -qb main . >/dev/null 2>&1 \
    && mkdir -p .claude/hooks \
    && printf '#!/usr/bin/env bash\necho "$1" >> %s\n[ -t 0 ] || head -c 4096 > %s/payload-"$1" 2>/dev/null\nexit 0\n' "$qmarker" "$qd" > .claude/hooks/probe.sh \
    && chmod +x .claude/hooks/probe.sh ) \
    || { echo "hookprobe: could not build the scratch .claude probe harness — INCONCLUSIVE (setup failed)"; exit 4; }
  p="$d/.claude/hooks/probe.sh"
  # Build settings.json with a JSON ENCODER and SHELL-QUOTE the probe path. The scratch dir lives
  # under $TMPDIR; if that contains a space (or a quote/backslash), a hand-rolled JSON string would
  # (a) break the JSON, or (b) make the hook COMMAND split on the space so the vendor executes only
  # the prefix — the hook never fires, the marker stays empty, and hookprobe would FALSELY report
  # NONE. That directly contradicts the safety-critical claim that "NONE proves the events are
  # unenforced." json.dumps escapes the path for JSON; shlex.quote makes the command robust to a
  # metacharacter-bearing path. python3 is a declared dependency (see SETUP.md).
  python3 - "$p" "$d/.claude/settings.json" <<'PY' || { echo "hookprobe: could not write the scratch .claude/settings.json — INCONCLUSIVE (setup failed)"; exit 4; }
import json, sys, shlex
p, out = sys.argv[1], sys.argv[2]
q = shlex.quote(p)
def cmd(ev): return {"type": "command", "command": q + " " + ev}
settings = {"hooks": {
    "SessionStart": [{"hooks": [cmd("SessionStart")]}],
    "PreToolUse":  [{"matcher": "Bash", "hooks": [cmd("PreToolUse")]}],
    "PostToolUse": [{"matcher": "Bash", "hooks": [cmd("PostToolUse")]}],
    "Stop":        [{"hooks": [cmd("Stop")]}],
}}
with open(out, "w") as f:
    f.write(json.dumps(settings))
PY
  # Wall-clock cap (same pattern as the lanes: timeout/gtimeout, else a python3 process-group
  # cap) — a CLI hung on auth/network/sandbox must fail loud and bounded, not hang the verification.
  # Defined BEFORE the --version probe: an installed CLI that hangs during version discovery would
  # otherwise hang hookprobe forever (the cap must cover EVERY external CLI call, --version included).
  local cap="${PLINTH_HOOKPROBE_TIMEOUT:-120}" tmo=""
  # Validate the cap: it MUST be a positive integer. GNU `timeout 0` (and the python fallback with
  # a 0/negative/non-numeric value) DISABLES the timeout entirely — a silent hard-cap bypass. Reject
  # rather than run uncapped: a bad env value is a setup error, not a licence to hang.
  case "$cap" in ''|*[!0-9]*) echo "hookprobe: PLINTH_HOOKPROBE_TIMEOUT='$cap' is not a positive integer — INCONCLUSIVE (refusing to run uncapped)"; exit 4 ;; esac
  [ "$cap" -ge 1 ] || { echo "hookprobe: PLINTH_HOOKPROBE_TIMEOUT='$cap' must be >= 1s (0 disables the cap) — INCONCLUSIVE (refusing to run uncapped)"; exit 4; }
  command -v timeout >/dev/null 2>&1 && tmo="timeout"
  [ -z "$tmo" ] && command -v gtimeout >/dev/null 2>&1 && tmo="gtimeout"
  # HARD cap: timeout -k 10 escalates TERM->KILL after 10s; the python3 fallback (no coreutils)
  # runs the CLI in its own process group and TERM-then-KILLs it, so a signal-ignoring CLI cannot
  # wait forever. Exit 124 on timeout (mapped to INCONCLUSIVE by the caller).
  capped() {
    if [ -n "$tmo" ]; then "$tmo" -k 10 "$cap" "$@"
    else python3 -c 'import subprocess,sys,signal,os
cap=float(sys.argv[1]); p=subprocess.Popen(sys.argv[2:], preexec_fn=os.setsid)
try: sys.exit(p.wait(timeout=cap))
except subprocess.TimeoutExpired:
    g=os.getpgid(p.pid); os.killpg(g, signal.SIGTERM)
    try: p.wait(timeout=10)
    except subprocess.TimeoutExpired: os.killpg(g, signal.SIGKILL)
    sys.exit(124)' "$cap" "$@"; fi
  }
  # --version is capped too: a broken/unauthenticated CLI that hangs on version discovery must
  # fail bounded, not hang hookprobe forever. `head` closing the pipe early is fine; the cap
  # guarantees a bounded wait regardless of the CLI's behavior.
  ver="$(capped "$vendor" --version 2>/dev/null | head -1 || echo unknown)"
  [ -n "$ver" ] || ver=unknown
  # The probe command leaves a SENTINEL (cli-ran.txt): hooks only had a chance to fire
  # if the CLI actually executed a tool command. Without the sentinel the result is
  # INCONCLUSIVE (unauthenticated CLI, sandbox refusal, model failure, …), never
  # "executed NONE" — an empty marker from a broken run is not evidence of anything.
  # `|| vrc=$?`, not `; vrc=$?`: this script runs set -e, and a bare failing subshell
  # statement would abort the probe before the timeout/inconclusive branches report.
  case "$vendor" in
    grok)  ( cd "$d" && capped grok -p "Run this exact shell command: touch cli-ran.txt" \
               --permission-mode bypassPermissions --sandbox workspace --max-turns 3 ) >/dev/null 2>&1 || vrc=$? ;;
    codex) ( cd "$d" && printf 'Run this exact shell command: touch cli-ran.txt' \
               | capped codex exec --skip-git-repo-check --sandbox workspace-write - ) >/dev/null 2>&1 || vrc=$? ;;
  esac
  if [ "$vrc" = 124 ] || [ "$vrc" = 142 ] || [ "$vrc" = 137 ]; then
    echo "hookprobe: $vendor ($ver) TIMED OUT after ${cap}s — probe INCONCLUSIVE (auth/network/sandbox hang?). Nothing verified."
    exit 4
  fi
  if [ ! -f "$d/cli-ran.txt" ]; then
    echo "hookprobe: $vendor ($ver) FAILED to execute the probe command (CLI exit $vrc — unauthenticated? sandbox refused? model error?) — INCONCLUSIVE: this is NOT evidence about hook execution. Fix the CLI and re-run."
    exit 4
  fi
  if [ "$vrc" != 0 ]; then
    echo "hookprobe: $vendor ($ver) exited NONZERO ($vrc) after executing the probe command — INCONCLUSIVE: a late failure (finalization/teardown) could swallow late hook events such as Stop. Nothing verified; fix the CLI and re-run."
    exit 4
  fi
  # marker read/transform failure is INCONCLUSIVE, not evidence of NONE. An ABSENT marker is
  # legitimately "no events fired" (empty); a sort ERROR on a present marker is a broken probe.
  if [ -e "$marker" ]; then
    fired="$(sort -u "$marker")" || { echo "hookprobe: $vendor ($ver) — could not read the marker file — INCONCLUSIVE (broken probe). Re-run."; exit 4; }
  else fired=""; fi
  for ev in $evs; do
    # Distinguish grep's MATCH (0) / NO-MATCH (1) from a grep ERROR (>=2): an error must be
    # INCONCLUSIVE, never silently read as "event not invoked" (that would be false NONE/SOME).
    # `|| _mg=$?` (not a bare pipeline): under set -e a bare failing grep would abort with grep's
    # status BEFORE we could branch to INCONCLUSIVE.
    local _mg=0; printf '%s\n' "$fired" | grep -qx "$ev" || _mg=$?
    if [ "$_mg" -ge 2 ]; then
      echo "hookprobe: $vendor ($ver) — could not evaluate event membership for '$ev' (grep rc=$_mg) — INCONCLUSIVE (broken probe). Re-run."; exit 4
    elif [ "$_mg" = 0 ]; then
      # invocation happened — did it come with parseable JSON on stdin (what the real
      # hooks need)? Reported per event; never treated as proof of enforcement.
      if jq -e . "$d/payload-$ev" >/dev/null 2>&1; then report="${report}${ev}: INVOKED(json-stdin:yes); "
      else report="${report}${ev}: INVOKED(json-stdin:no); "; fi
    else report="${report}${ev}: no; "; allfired=0; fi
  done
  if [ "$allfired" = 1 ]; then
    echo "hookprobe: $vendor ($ver) invoked ALL FOUR wired .claude/ hook events (${report% }) — NECESSARY for local enforcement but NOT SUFFICIENT: Plinth's real hooks also need Claude-shaped stdin JSON and CLAUDE_PROJECT_DIR. Verify END-TO-END before relying on local gates (wire the real hooks, run one session, confirm the pulse feed appears and a guard block fires). A missing pulse feed under an all-four driver means BROKEN WIRING."
    exit 0
  elif [ -z "$fired" ]; then
    echo "hookprobe: $vendor ($ver) executed NONE of the wired .claude/ hook events (${report% }) — nothing local is enforced: expect feedless watch and contract-bound review under this driver. Re-run after CLI upgrades."
    exit 1
  else
    echo "hookprobe: $vendor ($ver) invoked SOME hook events only (${report% }) — PARTIAL Claude-compat: a NOT-invoked event is certainly unenforced; an INVOKED event still needs end-to-end verification before you rely on it."
    exit 1
  fi
}

# plinth changelog-collate [<target-repo>] — fold every changelog.d/*.md fragment
# (except README.md) into a new top section of CHANGELOG.md, bump VERSION from the
# highest declared bump, then delete the collated fragments. Branches declare
# INTENT via fragments; this command computes the NUMBER at release time so
# parallel branches never collide on VERSION or the top of CHANGELOG.md.
# Atomic writes via the same .plinth-tmp.XXXXXX idiom as edit_file — never leave
# CHANGELOG.md or VERSION half-written. Fail closed on any invalid/missing bump
# (never guess a default; never silently skip a fragment).
run_changelog_collate() {
  shift  # drop 'changelog-collate'
  # Exactly zero or one target path — extra args are not "options to ignore" for a
  # destructive release helper (would silently collate the wrong tree).
  local root="."
  if [ "$#" -gt 1 ]; then
    echo "usage: plinth changelog-collate [<target-repo>]" >&2; exit 1
  fi
  if [ "$#" -eq 1 ]; then
    root="$1"
    [ -d "$root" ] || { echo "No such directory: $root" >&2; exit 1; }
  fi
  local cdir="$root/changelog.d" vfile="$root/VERSION" clfile="$root/CHANGELOG.md"
  # Collect fragment paths (sorted for a deterministic summary + body order).
  # README.md is documentation, never a fragment. An empty or absent dir is a
  # no-op (exit 0), not an error — nothing to collate is a successful release step.
  local frags="" f base slug _flist
  if [ -d "$cdir" ]; then
    # Enumerate every *.md name (including hidden and non-regular entries).
    # Do NOT use -type f: that silently omits symlinks the prior glob accepted.
    # Type validation below accepts regular files and symlinks-to-files, and
    # hard-errors on directories / broken links so release prose cannot hide.
    # Capture find status: a failed find must not become a successful no-op.
    _flist="$(mktemp)" || { echo "changelog-collate: mktemp failed while listing fragments" >&2; exit 1; }
    # -H: follow a command-line starting-point that is itself a symlink to a
    # directory (default find does not, and would silently no-op on a linked
    # changelog.d/). Do not use -L (would also follow links inside the tree).
    if ! find -H "$cdir" -maxdepth 1 -name '*.md' -print > "$_flist"; then
      rm -f "$_flist"
      echo "changelog-collate: failed to list $cdir/*.md" >&2
      exit 1
    fi
    # Sort for deterministic summary/body order.
    if ! LC_ALL=C sort -o "$_flist" "$_flist"; then
      rm -f "$_flist"
      echo "changelog-collate: failed to sort fragment list" >&2
      exit 1
    fi
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      base="$(basename "$f")"
      [ "$base" = "README.md" ] && continue
      if [ -d "$f" ]; then
        rm -f "$_flist"
        echo "changelog-collate: $f is a directory (expected a fragment file)" >&2
        exit 1
      fi
      # [ -f ] is true for a regular file or a symlink to one; false for a
      # broken symlink or special file — both must hard-error, not skip.
      if [ ! -f "$f" ]; then
        rm -f "$_flist"
        echo "changelog-collate: $f is not a readable regular file (broken symlink or special file?)" >&2
        exit 1
      fi
      slug="${base%.md}"
      if ! printf '%s' "$slug" | LC_ALL=C grep -Eq '^[a-z0-9][a-z0-9._-]*$'; then
        rm -f "$_flist"
        echo "changelog-collate: invalid fragment slug in $f (expected changelog.d/<slug>.md where slug matches [a-z0-9][a-z0-9._-]*)" >&2
        exit 1
      fi
      frags="$frags$f"$'\n'
    done < "$_flist"
    rm -f "$_flist"
  fi
  if [ -z "$frags" ]; then
    echo "plinth changelog-collate: nothing to collate in $cdir"
    exit 0
  fi

  [ -f "$vfile" ] || { echo "changelog-collate: missing VERSION at $vfile" >&2; exit 1; }
  [ -f "$clfile" ] || { echo "changelog-collate: missing CHANGELOG.md at $clfile" >&2; exit 1; }
  # Entire file is exactly MAJOR.MINOR.PATCH with at most one trailing newline —
  # no whitespace stripping (would turn "1. 2.3" into a false positive), no
  # second line/junk, no empty components ("1..2"). A missing trailing newline is fine.
  # Preserve trailing newlines: plain $(cat) strips them all, which would accept
  # "1.2.3\n\n" as a clean single line. Append a sentinel, then strip it.
  local raw oldver
  raw="$(cat "$vfile"; printf x)" || { echo "changelog-collate: failed to read $vfile" >&2; exit 1; }
  raw="${raw%x}"
  # Reject NULs via byte-count compare (grep '\0' is not portable — it can match
  # every file). tr -d '\0' shortens the stream iff a NUL was present.
  _vbytes="$(wc -c < "$vfile" | tr -d '[:space:]')"
  _vnul="$(tr -d '\0' < "$vfile" | wc -c | tr -d '[:space:]')"
  if [ "$_vbytes" != "$_vnul" ]; then
    echo "changelog-collate: VERSION contains a NUL byte — refusing" >&2; exit 1
  fi
  case "$raw" in
    *$'\n'?*) echo "changelog-collate: VERSION must be a single MAJOR.MINOR.PATCH line (got multi-line or trailing junk)" >&2; exit 1 ;;
    *$'\n'*$'\n'*) echo "changelog-collate: VERSION must be a single MAJOR.MINOR.PATCH line (got multi-line or trailing junk)" >&2; exit 1 ;;
    *$'\n') oldver="${raw%$'\n'}" ;;
    *) oldver="$raw" ;;
  esac
  # After stripping one optional trailing newline, no newline may remain.
  case "$oldver" in *$'\n'*) echo "changelog-collate: VERSION must be a single MAJOR.MINOR.PATCH line (got multi-line or trailing junk)" >&2; exit 1 ;; esac
  local major minor patch
  major="${oldver%%.*}"
  local rest="${oldver#*.}"
  minor="${rest%%.*}"
  patch="${rest#*.}"
  # Each component: non-empty digits only, bounded length (Bash integers are
  # fixed-width; a 20-digit component overflows into a wrong release number).
  # Reassemble must equal the parsed line (rejects "1..2", "1.2.", ".1.2", "1.2.3.4").
  case "$major" in ''|*[!0-9]*|[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*) echo "changelog-collate: VERSION must be MAJOR.MINOR.PATCH (got '$oldver')" >&2; exit 1 ;; esac
  case "$minor" in ''|*[!0-9]*|[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*) echo "changelog-collate: VERSION must be MAJOR.MINOR.PATCH (got '$oldver')" >&2; exit 1 ;; esac
  case "$patch" in ''|*[!0-9]*|[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*) echo "changelog-collate: VERSION must be MAJOR.MINOR.PATCH (got '$oldver')" >&2; exit 1 ;; esac
  [ "$oldver" = "$major.$minor.$patch" ] || { echo "changelog-collate: VERSION must be MAJOR.MINOR.PATCH (got '$oldver')" >&2; exit 1; }

  # Parse every fragment BEFORE any write. Rank: patch=1, minor=2, major=3.
  local win_rank=0 win_bump="" bodies="" slugs="" line bump body rank
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$f" ] || { echo "changelog-collate: cannot read fragment $f" >&2; exit 1; }
    line="$(head -n 1 "$f" | tr -d '\r')"
    case "$line" in
      "bump: patch") bump=patch; rank=1 ;;
      "bump: minor") bump=minor; rank=2 ;;
      "bump: major") bump=major; rank=3 ;;
      *) echo "changelog-collate: invalid or missing bump: in $f (first line must be 'bump: patch|minor|major')" >&2; exit 1 ;;
    esac
    # Body is everything after the first --- separator line. Missing ---, an
    # empty body, or a body with no bullet line is a hard error — never bump
    # VERSION for a fragment that records no prose (would drop a shipped change).
    if ! grep -q '^---$' "$f"; then
      echo "changelog-collate: missing '---' header/body separator in $f" >&2; exit 1
    fi
    body="$(sed -n '/^---$/,$p' "$f" | sed '1d')" || {
      echo "changelog-collate: failed to read body of $f" >&2; exit 1
    }
    if [ -z "$(printf '%s' "$body" | tr -d '[:space:]')" ]; then
      echo "changelog-collate: empty body in $f (need one or more bullet lines after ---)" >&2; exit 1
    fi
    # Heredoc (not printf|grep) so pipefail never sees SIGPIPE from grep -q
    # closing early on a large body.
    grep -q '^- ' <<EOF || { echo "changelog-collate: body in $f has no bullet line (expected lines starting with '- ')" >&2; exit 1; }
$body
EOF
    slug="$(basename "$f" .md)"
    if [ "$rank" -gt "$win_rank" ]; then win_rank=$rank; win_bump=$bump; fi
    if [ -n "$slugs" ]; then slugs="$slugs, $slug"; else slugs="$slug"; fi
    if [ -n "$bodies" ]; then bodies="$bodies"$'\n'"$body"; else bodies="$body"; fi
  done <<EOF
$frags
EOF

  local newver
  # 10# forces decimal (leading-zero components must not be parsed as octal).
  case "$win_bump" in
    major) newver="$((10#$major + 1)).0.0" ;;
    minor) newver="$major.$((10#$minor + 1)).0" ;;
    patch) newver="$major.$minor.$((10#$patch + 1))" ;;
    *) echo "changelog-collate: internal error: no winning bump" >&2; exit 1 ;;
  esac

  local today; today="$(date -u +"%B %d, %Y")"
  local section="## v${newver} — ${slugs} — ${today}"
  # Build the new CHANGELOG in a temp, then VERSION in a temp, then mv both.
  # Read original modes first (same fail-closed contract as edit_file).
  local clmode vmode
  clmode="$(stat -c '%a' "$clfile" 2>/dev/null || stat -f '%Lp' "$clfile" 2>/dev/null)"
  case "$clmode" in ''|*[!0-7]*) echo "changelog-collate: cannot determine mode of $clfile — refusing" >&2; exit 1 ;; esac
  vmode="$(stat -c '%a' "$vfile" 2>/dev/null || stat -f '%Lp' "$vfile" 2>/dev/null)"
  case "$vmode" in ''|*[!0-7]*) echo "changelog-collate: cannot determine mode of $vfile — refusing" >&2; exit 1 ;; esac

  local cltmp vtmp
  cltmp="$(mktemp "$(dirname "$clfile")/.plinth-tmp.XXXXXX")" || { echo "changelog-collate: mktemp failed for CHANGELOG.md" >&2; exit 1; }
  vtmp="$(mktemp "$(dirname "$vfile")/.plinth-tmp.XXXXXX")" || { rm -f "$cltmp"; echo "changelog-collate: mktemp failed for VERSION" >&2; exit 1; }
  chmod "$clmode" "$cltmp" || { rm -f "$cltmp" "$vtmp"; echo "changelog-collate: could not apply mode $clmode to CHANGELOG temp — refusing" >&2; exit 1; }
  chmod "$vmode" "$vtmp" || { rm -f "$cltmp" "$vtmp"; echo "changelog-collate: could not apply mode $vmode to VERSION temp — refusing" >&2; exit 1; }

  # New section sits immediately after the "# Plinth changelog" title line.
  # Fail closed if the title line is missing — never invent a new document shape.
  if ! head -n 1 "$clfile" | grep -q '^# Plinth changelog$'; then
    rm -f "$cltmp" "$vtmp"
    echo "changelog-collate: $clfile does not start with '# Plinth changelog' — refusing" >&2
    exit 1
  fi
  {
    head -n 1 "$clfile"
    printf '\n%s\n' "$section"
    printf '%s\n' "$bodies"
    # Remainder of the file after the title line (may start with a blank line).
    tail -n +2 "$clfile"
  } > "$cltmp" || { rm -f "$cltmp" "$vtmp"; echo "changelog-collate: failed to write CHANGELOG temp" >&2; exit 1; }
  printf '%s\n' "$newver" > "$vtmp" || { rm -f "$cltmp" "$vtmp"; echo "changelog-collate: failed to write VERSION temp" >&2; exit 1; }

  mv "$cltmp" "$clfile" || { rm -f "$cltmp" "$vtmp"; echo "changelog-collate: failed to install new CHANGELOG.md" >&2; exit 1; }
  mv "$vtmp" "$vfile" || { rm -f "$vtmp"; echo "changelog-collate: failed to install new VERSION (CHANGELOG.md already updated to v$newver — fix VERSION by hand)" >&2; exit 1; }

  # Drain collated fragments; leave README.md and .gitkeep.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rm -f "$f" || { echo "changelog-collate: failed to delete fragment $f (VERSION=$newver already written)" >&2; exit 1; }
  done <<EOF
$frags
EOF

  echo "plinth changelog-collate: $oldver -> $newver ($win_bump wins)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    echo "  collated: $(basename "$f")"
  done <<EOF
$frags
EOF
}

# ── plinth dash / dashboard ───────────────────────────────────────────────────
# Multi-instance HTML wallboard. Discovery (first match wins):
#   1. PLINTH_DASH_ROOTS — colon-separated absolute paths (tests / operators)
#   2. ~/.config/plinth/dashboard-projects — one absolute path per line (# comments)
#   3. Default: every ~/Dev/* that has .plinth/config
# Serves only on 127.0.0.1. Read-only. --snapshot prints JSON and exits (CI/smoke).

_dash_mtime() {  # epoch seconds or 0
  # Prefer GNU -c (Linux). BSD/macOS -f second. NEVER try -f first: GNU
  # `stat -f` is filesystem status and prints `?` with exit 0 for unknown
  # formats, so the -c branch would never run and activity age would be 0
  # on every Linux host (including the canary runner).
  local t
  t="$(stat -c '%Y' "$1" 2>/dev/null || true)"
  case "$t" in ''|*[!0-9]*) t="$(stat -f '%m' "$1" 2>/dev/null || true)" ;; esac
  case "$t" in ''|*[!0-9]*) echo 0 ;; *) printf '%s\n' "$t" ;; esac
}

# True if $1 is strictly newer than $2.
# - With python3: nanosecond mtime (portable subsecond retries).
# - Without: bash -nt only (whole-second on some platforms). Same-second ties
#   are NOT newer — subsecond retry detection requires python3 (documented).
_dash_file_newer() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import os,sys
sys.exit(0 if os.stat(sys.argv[1]).st_mtime_ns > os.stat(sys.argv[2]).st_mtime_ns else 1)' \
      "$1" "$2" 2>/dev/null && return 0
    return 1
  fi
  [ "$1" -nt "$2" ]
}

_dash_realpath() {
  # Prefer realpath; fall back to cd/pwd (no -P on pure logical paths).
  if command -v realpath >/dev/null 2>&1; then realpath "$1" 2>/dev/null && return 0; fi
  ( cd "$1" 2>/dev/null && pwd -P ) || return 1
}

discover_dashboard_projects() {
  local p cfg="$HOME/.config/plinth/dashboard-projects" line rp
  if [ -n "${PLINTH_DASH_ROOTS:-}" ]; then
    # set -f: unquoted colon-split must not pathname-expand roots that contain * ? [.
    local IFS=':'
    set -f
    for p in $PLINTH_DASH_ROOTS; do
      [ -n "$p" ] || continue
      [ -d "$p" ] || continue
      [ -f "$p/.plinth/config" ] || continue
      rp="$(_dash_realpath "$p")" || continue
      printf '%s\n' "$rp"
    done
    set +f
    return 0
  fi
  if [ -f "$cfg" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|\#*) continue ;; esac
      # Expand leading ~/ only (no arbitrary shell expansion).
      # Escape ~ in ${line#\~/}: unescaped ~ tilde-expands inside the pattern and
      # leaves a literal ~/ after $HOME/ (e.g. $HOME/~/Dev/foo).
      case "$line" in "~/"*) line="${HOME}/${line#\~/}" ;; esac
      [ -d "$line" ] || continue
      [ -f "$line/.plinth/config" ] || continue
      rp="$(_dash_realpath "$line")" || continue
      printf '%s\n' "$rp"
    done < "$cfg"
    return 0
  fi
  # Default scan: ~/Dev/*/.plinth/config
  local dev="${PLINTH_DASH_DEV_ROOT:-$HOME/Dev}"
  [ -d "$dev" ] || return 0
  for p in "$dev"/*; do
    [ -d "$p" ] || continue
    [ -f "$p/.plinth/config" ] || continue
    rp="$(_dash_realpath "$p")" || continue
    printf '%s\n' "$rp"
  done
}

# Newest in-flight request-N.json for a review slug (numeric N, basename only).
# Full-path `sort -t- -k2` breaks when any parent directory contains '-'.
_dash_latest_request() {
  local dir="$1" slug="$2" f bn n
  [ -d "$dir/.plinth/session/review/$slug" ] || return 0
  for f in "$dir/.plinth/session/review/$slug"/request-*.json; do
    [ -f "$f" ] || continue
    bn="${f##*/}"
    n="${bn#request-}"
    n="${n%.json}"
    case "$n" in ''|*[!0-9]*) continue ;; esac
    printf '%s\t%s\n' "$n" "$f"
  done | sort -n -k1,1 | tail -1 | cut -f2-
}

# Bounds for per-poll work. Session identity streams at most the last N event
# lines (O(N) time / O(unique SIDs in window) mem). Transcript burn uses a tail.
_DASH_EV_MAX_LINES=10000
_DASH_TR_TAIL=300

# One project card as a compact JSON object on stdout (single line).
# Always emits a card (error field on render failure) so projects are never dropped.
snapshot_one_project() {
  local dir="$1" NOW
  NOW="$(date +%s)"
  local feedless=0 EV_RAW="$dir/.plinth/session/events.jsonl"
  local tr_tmp=""
  if [ ! -f "$EV_RAW" ]; then feedless=1; fi

  local head head_full branch slug
  head_full="$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo '')"
  head="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo '-')"
  # Detached HEAD → slug "detached" (same contract as smoke/statusline), not "-".
  branch="$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null || true)"
  if [ -z "$branch" ]; then branch="detached"; fi
  slug="$(printf '%s' "$branch" | tr '/ ' '--')"

  local vfile="$dir/.plinth/session/review/$slug/verdict.json"
  local verdict_file_bad=false
  if [ -f "$vfile" ]; then
    # Exactly one JSON document and it must be an object (rejects null/false,
    # multi-doc files where the last doc is an object, empty files, etc.).
    if ! jq -se 'length == 1 and (.[0] | type) == "object"' "$vfile" >/dev/null 2>&1; then
      verdict_file_bad=true
    fi
  else
    vfile=/dev/null
  fi
  # Do not slurp usage.jsonl — the wallboard never renders it, and a malformed
  # ledger must not collapse the card (would zero NEEDS-HUMAN etc.).
  local rqfile
  rqfile="$(_dash_latest_request "$dir" "$slug")"
  [ -n "$rqfile" ] && [ -f "$rqfile" ] || rqfile=/dev/null
  # Infra failure leaves last-error. A request file strictly newer than last-error
  # means a retry is in flight (review.sh writes request, then on fail last-error;
  # a later retry rewrites request). Same mtime or older request → keep error.
  local has_last_error=false
  local errfile="$dir/.plinth/session/review/$slug/last-error"
  if [ -f "$errfile" ]; then
    if [ -n "$rqfile" ] && [ -f "$rqfile" ] && [ "$rqfile" != /dev/null ] \
       && _dash_file_newer "$rqfile" "$errfile"; then
      has_last_error=false
    else
      has_last_error=true
    fi
  fi

  local activity_ago=null events_mtime=0
  if [ "$feedless" -eq 0 ]; then
    events_mtime="$(_dash_mtime "$EV_RAW")"
    case "$events_mtime" in ''|*[!0-9]*) events_mtime=0 ;; esac
    if [ "$events_mtime" -gt 0 ] 2>/dev/null; then
      activity_ago=$((NOW - events_mtime))
      [ "$activity_ago" -ge 0 ] 2>/dev/null || activity_ago=0
    fi
  fi

  local nhn=0 nhb=0 nhf raw nh_items_json='{"items":[],"truncated":false}'
  nhf="$(needs_human_file "$dir")"
  if [ -s "$nhf" ]; then
    raw="$(open_items "$nhf")"
    # Open = unchecked boxes only. Empty open_items means the queue is clear —
    # do NOT fall back to counting headings / checked lines as open.
    if [ -n "$raw" ]; then
      nhn="$(printf '%s\n' "$raw" | grep -c . || true)"
      nhb="$(printf '%s\n' "$raw" | grep -c '^\[BLOCKING\]' || true)"
      # Drill-down list for the wallboard (cap 50; full queue via `plinth queue`).
      # Avoid printf|head SIGPIPE under pipefail: materialize then slice in jq.
      nh_items_json="$(printf '%s\n' "$raw" | jq -Rsc --argjson open "$nhn" '
        split("\n")
        | map(select(length > 0))
        | . as $all
        | ($all[:50]) as $items
        | {items: ($items | map({text: ., blocking: startswith("[BLOCKING]")})),
           truncated: (($items | length) < $open)}
      ' 2>/dev/null || echo '{"items":[],"truncated":true}')"
    fi
    case "$nhn" in ''|*[!0-9]*) nhn=0 ;; esac
    case "$nhb" in ''|*[!0-9]*) nhb=0 ;; esac
    # If open_items ran but jq packaging failed, still expose empty list.
    case "$nh_items_json" in
      '{'*) ;;
      *) nh_items_json='{"items":[],"truncated":false}' ;;
    esac
  fi
  # Unpack packaged items for the card JSON (open/blocking stay top-level).
  local nh_items_arr nh_trunc
  nh_items_arr="$(jq -c '.items // []' <<<"$nh_items_json" 2>/dev/null || echo '[]')"
  # JSON boolean for --argjson (not the strings "true"/"false").
  nh_trunc="$(jq -c '.truncated // false' <<<"$nh_items_json" 2>/dev/null || echo false)"
  case "$nh_trunc" in true|false) ;; *) nh_trunc=false ;; esac

  # Config seat labels (always present when set) — models row must not depend only
  # on a live Claude transcript, which leaves feedless drivers looking "stuck".
  local cfgf="$dir/.plinth/config"
  local seat_reviewer_vendor="" seat_reviewer_t1="" seat_reviewer_t2=""
  local seat_audit_vendor="" seat_audit_model="" seat_advisor_vendor=""
  local seat_advisor_model="" seat_advisor_max=""
  if [ -f "$cfgf" ]; then
    seat_reviewer_vendor="$(sed -n 's/^reviewer_vendor[[:space:]]*=[[:space:]]*//p' "$cfgf" 2>/dev/null | head -1 | tr -d '\r')"
    seat_reviewer_t1="$(sed -n 's/^reviewer_model_tier1[[:space:]]*=[[:space:]]*//p' "$cfgf" 2>/dev/null | head -1 | tr -d '\r')"
    seat_reviewer_t2="$(sed -n 's/^reviewer_model_tier2[[:space:]]*=[[:space:]]*//p' "$cfgf" 2>/dev/null | head -1 | tr -d '\r')"
    seat_audit_vendor="$(sed -n 's/^audit_vendor[[:space:]]*=[[:space:]]*//p' "$cfgf" 2>/dev/null | head -1 | tr -d '\r')"
    seat_audit_model="$(sed -n 's/^audit_model[[:space:]]*=[[:space:]]*//p' "$cfgf" 2>/dev/null | head -1 | tr -d '\r')"
    seat_advisor_vendor="$(sed -n 's/^advisor_vendor[[:space:]]*=[[:space:]]*//p' "$cfgf" 2>/dev/null | head -1 | tr -d '\r')"
    seat_advisor_model="$(sed -n 's/^advisor_model[[:space:]]*=[[:space:]]*//p' "$cfgf" 2>/dev/null | head -1 | tr -d '\r')"
    seat_advisor_max="$(sed -n 's/^advisor_model_max[[:space:]]*=[[:space:]]*//p' "$cfgf" 2>/dev/null | head -1 | tr -d '\r')"
  fi

  # Session identity: always `tail -n $_DASH_EV_MAX_LINES` then stream (no wc -l
  # pre-scan of the full file). t0 is set only from SessionStart — if that event
  # fell off the window, session_secs is null rather than a fabricated age.
  # Phase seconds: attribute inter-event gaps on the active SID to a coarse stage
  # (coding / research / reviewing / advising / ci / shell / planning / other).
  local sid="" session_t0="" task="" transcript_path=""
  local phases_json='{}'
  local events_parse_failed=false
  if [ "$feedless" -eq 0 ]; then
    local meta_out meta_rc=0 ev_tmp=""
    ev_tmp="$(mktemp "${TMPDIR:-/tmp}/plinth-dash-ev.XXXXXX")" || ev_tmp=""
    if [ -z "$ev_tmp" ]; then
      events_parse_failed=true
    else
      tail -n "$_DASH_EV_MAX_LINES" "$EV_RAW" > "$ev_tmp" 2>/dev/null || : > "$ev_tmp"
      meta_out="$(jq -nr --argjson now "$NOW" '
        # Event names actually produced by Plinth hooks + pulse passthrough.
        def known_event:
          . == "SessionStart" or . == "UserPromptSubmit" or . == "PostToolUse"
          or . == "PreToolUse" or . == "Stop" or . == "SubagentStop"
          or . == "PreCompact" or . == "guard_block" or . == "gate_release"
          or . == "unknown";
        def phase_of($tool; $detail):
          if $tool == null or $tool == "" then "other"
          elif $tool == "Edit" or $tool == "Write" or $tool == "NotebookEdit"
               or $tool == "MultiEdit" then "coding"
          elif $tool == "Read" or $tool == "Grep" or $tool == "Glob"
               or $tool == "WebSearch" or $tool == "WebFetch" then "research"
          elif $tool == "TodoWrite" or $tool == "TodoRead" or $tool == "EnterPlanMode"
               or $tool == "ExitPlanMode" then "planning"
          elif $tool == "Bash" or $tool == "bash" then
            (($detail // "") as $d
             | if ($d | test("review\\.sh|plinth/review|/\\.plinth/review")) then "reviewing"
               elif ($d | test("plinth[ ]+advise")) then "advising"
               elif ($d | test("\\bgh\\b|canary|ci\\.yml|\\bact\\b|workflow")) then "ci"
               else "shell" end)
          else "other" end;
        # Phase timing (active SID only) — EVENT-GAP HEURISTIC, not instrumented
        # tool wall clocks (pulse often has PostToolUse without PreToolUse):
        # - PostToolUse: gap since previous same-SID event is attributed to that
        #   tool class (completion stamp only).
        # - PreToolUse: gap is idle/previous; then phase becomes the new tool.
        # - Other events: gap accrues to last_phase; UserPromptSubmit -> planning.
        # Gaps >=3600s are dropped (session pause).
        reduce inputs as $e (
          {cur:null, by:{}};
          if ($e | type) != "object" then error("bad_event_type")
          elif ($e.event == null) or (($e.event | type) != "string")
               or (($e.event | known_event) | not) then error("bad_event_name")
          elif ($e.sid != null) and (($e.sid | type) != "string") then error("bad_event_sid")
          elif ($e.epoch != null) and (($e.epoch | type) != "number") then error("bad_event_epoch")
          elif ($e.transcript != null) and (($e.transcript | type) != "string") then error("bad_event_transcript")
          elif ($e.detail != null) and (($e.detail | type) != "string") then error("bad_event_detail")
          elif ($e.sid == null) then .
          else
            (if .by[$e.sid] == null then
               .by[$e.sid] = {t0:null, task:null, tr:null, phases:{},
                              last_epoch:null, last_phase:"other"}
             else . end)
            | .cur = $e.sid
            | .by[$e.sid] as $S
            | if ($e.event == "SessionStart") and ($e.epoch != null)
                 and ($S.t0 == null)
              then .by[$e.sid].t0 = $e.epoch else . end
            | if ($e.event == "UserPromptSubmit")
                and (($e.detail // "") | length > 0)
                and ((($e.detail // "") | test("^\\s*<")) | not)
              then .by[$e.sid].task = $e.detail else . end
            | if ($e.transcript != null) then .by[$e.sid].tr = $e.transcript else . end
            | (
                if $S.last_epoch != null and ($e.epoch != null)
                   and ($e.epoch >= $S.last_epoch)
                   and (($e.epoch - $S.last_epoch) < 3600)
                then
                  (if $e.event == "PostToolUse"
                   then phase_of($e.tool; $e.detail)
                   else $S.last_phase end) as $ph
                  | .by[$e.sid].phases[$ph] =
                      ((.by[$e.sid].phases[$ph] // 0) + ($e.epoch - $S.last_epoch))
                else . end
              )
            | if $e.epoch != null then .by[$e.sid].last_epoch = $e.epoch else . end
            | if $e.event == "PostToolUse"
              then .by[$e.sid].last_phase = phase_of($e.tool; $e.detail)
              elif $e.event == "PreToolUse"
              then .by[$e.sid].last_phase = phase_of($e.tool; $e.detail)
              elif $e.event == "UserPromptSubmit"
              then .by[$e.sid].last_phase = "planning"
              else . end
          end
        )
        | if .cur == null then {sid:null, t0:null, task:null, tr:null, phases:{}}
          else
            ((.by[.cur] // {}) as $S
             | {sid:.cur, t0:$S.t0, task:$S.task, tr:$S.tr,
                phases:($S.phases // {})})
          end
        | @json
      ' "$ev_tmp" 2>/dev/null)" || meta_rc=$?
      rm -f "$ev_tmp"
      if [ "$meta_rc" -ne 0 ] || [ -z "$meta_out" ]; then
        events_parse_failed=true
      else
        sid="$(printf '%s' "$meta_out" | jq -r '.sid // empty')"
        session_t0="$(printf '%s' "$meta_out" | jq -r '.t0 // empty')"
        task="$(printf '%s' "$meta_out" | jq -r '.task // empty')"
        transcript_path="$(printf '%s' "$meta_out" | jq -r '.tr // empty')"
        phases_json="$(printf '%s' "$meta_out" | jq -c '.phases // {}' 2>/dev/null || echo '{}')"
      fi
    fi
  fi

  # Separate review-round wall time (request-N → findings-N mtimes). NOT folded into
  # phases.reviewing (that would double-count Bash review.sh event gaps).
  local review_round_secs=0
  local rev_dir="$dir/.plinth/session/review/$slug"
  if [ -d "$rev_dir" ]; then
    local n rqff fnd t0 t1
    for fnd in "$rev_dir"/findings-*.json; do
      [ -f "$fnd" ] || continue
      n="${fnd##*/findings-}"
      n="${n%.json}"
      case "$n" in ''|*[!0-9]*) continue ;; esac
      rqff="$rev_dir/request-$n.json"
      [ -f "$rqff" ] || continue
      t0="$(_dash_mtime "$rqff")"
      t1="$(_dash_mtime "$fnd")"
      case "$t0" in ''|*[!0-9]*) continue ;; esac
      case "$t1" in ''|*[!0-9]*) continue ;; esac
      if [ "$t1" -ge "$t0" ] 2>/dev/null; then
        review_round_secs=$((review_round_secs + t1 - t0))
      fi
    done
  fi

  # Malformed events or present-but-non-object verdict → error card.
  # Keep independently available fields (seats, phases, review_round_secs, NH).
  if [ "$events_parse_failed" = true ] || [ "$verdict_file_bad" = true ]; then
    jq -nc --arg path "$dir" --arg name "$(basename "$dir")" \
      --arg head "$head" --arg branch "$branch" \
      --argjson feedless "$feedless" --argjson nhn "$nhn" --argjson nhb "$nhb" \
      --argjson nh_items "$nh_items_arr" --argjson nh_trunc "$nh_trunc" \
      --argjson phases "$phases_json" --argjson review_round_secs "$review_round_secs" \
      --arg seat_rv "${seat_reviewer_vendor:-}" --arg seat_rt1 "${seat_reviewer_t1:-}" \
      --arg seat_rt2 "${seat_reviewer_t2:-}" --arg seat_av "${seat_audit_vendor:-}" \
      --arg seat_am "${seat_audit_model:-}" --arg seat_advv "${seat_advisor_vendor:-}" \
      --arg seat_advm "${seat_advisor_model:-}" --arg seat_advx "${seat_advisor_max:-}" \
      'def nonempty($s): if ($s|type)=="string" and ($s|length)>0 then $s else null end;
      {path:$path,name:$name,branch:$branch,head:$head,feedless:($feedless==1),
        error:"snapshot_render_failed",
        needs_human:{open:$nhn,blocking:$nhb,items:$nh_items,truncated:$nh_trunc},
        phases:($phases // {}),
        review_round_secs:$review_round_secs,
        models:{live:{driver:null,reviewer:null,reviewer_vendor:null},
          seats:{reviewer_vendor:nonempty($seat_rv),reviewer_tier1:nonempty($seat_rt1),
                 reviewer_tier2:nonempty($seat_rt2),audit_vendor:nonempty($seat_av),
                 audit_model:nonempty($seat_am),advisor_vendor:nonempty($seat_advv),
                 advisor_model:nonempty($seat_advm),advisor_model_max:nonempty($seat_advx)}},
        quota:{available:false,note:"Vendor plan remaining quota/reset is polled separately (CLI /usage|/status cache)"}}'
    return 0
  fi

  # Burn/tokens: tail the transcript only (recent window; UI labels it as such).
  local transcript=/dev/null
  if [ -n "${transcript_path:-}" ] && [ -f "$transcript_path" ]; then
    tr_tmp="$(mktemp "${TMPDIR:-/tmp}/plinth-dash-tr.XXXXXX")" || tr_tmp=""
    if [ -n "$tr_tmp" ]; then
      tail -n "$_DASH_TR_TAIL" "$transcript_path" > "$tr_tmp" 2>/dev/null || : > "$tr_tmp"
      transcript="$tr_tmp"
    else
      transcript="$transcript_path"
    fi
  fi

  local session_secs_json=null
  if [ -n "${session_t0:-}" ]; then
    case "$session_t0" in *[!0-9]*) ;; *)
      session_secs_json=$((NOW - session_t0))
      [ "$session_secs_json" -ge 0 ] 2>/dev/null || session_secs_json=0
    ;; esac
  fi

  local rq_round_from_name=null
  if [ -n "$rqfile" ] && [ "$rqfile" != /dev/null ]; then
    local rqbn="${rqfile##*/}"
    local rqn="${rqbn#request-}"
    rqn="${rqn%.json}"
    case "$rqn" in ''|*[!0-9]*) ;; *) rq_round_from_name="$rqn" ;; esac
  fi
  jq -nc --slurpfile vd "$vfile" --slurpfile rq "$rqfile" --slurpfile tr "$transcript" \
        --arg path "$dir" --arg name "$(basename "$dir")" \
        --arg head "$head" --arg head_full "$head_full" --arg branch "$branch" \
        --arg sid "${sid:-}" --arg task "${task:-}" \
        --argjson feedless "$feedless" --argjson now "$NOW" \
        --argjson activity_ago "${activity_ago:-null}" \
        --argjson session_secs "${session_secs_json:-null}" \
        --argjson nhn "$nhn" --argjson nhb "$nhb" \
        --argjson nh_items "$nh_items_arr" --argjson nh_trunc "$nh_trunc" \
        --argjson phases "$phases_json" \
        --argjson review_round_secs "$review_round_secs" \
        --arg seat_rv "${seat_reviewer_vendor:-}" \
        --arg seat_rt1 "${seat_reviewer_t1:-}" \
        --arg seat_rt2 "${seat_reviewer_t2:-}" \
        --arg seat_av "${seat_audit_vendor:-}" \
        --arg seat_am "${seat_audit_model:-}" \
        --arg seat_advv "${seat_advisor_vendor:-}" \
        --arg seat_advm "${seat_advisor_model:-}" \
        --arg seat_advx "${seat_advisor_max:-}" \
        --argjson has_last_error "$has_last_error" \
        --argjson rq_round_from_name "$rq_round_from_name" '
    def sha_match($a; $b):
      ($a != null and $b != null and ($a | length) > 0 and ($b | length) > 0)
      and (($a | startswith($b)) or ($b | startswith($a)));
    def toksum: .i + .cc + .cr + .o;
    def verdict_ok($v):
      $v == "APPROVED" or $v == "CHANGES_NEEDED" or $v == "UNBOUND";
    def sha_ok($s):
      # 7–40 hex (sha1) or up to 64 hex (sha256 object format).
      ($s | type == "string") and ($s | test("^[0-9a-fA-F]{7,64}$"));
    def round_ok($r):
      ($r | type == "number") and ($r == ($r | floor)) and ($r >= 0);
    def nonempty($s): if ($s | type) == "string" and ($s | length) > 0 then $s else null end;
    ($vd[0] // null) as $V0
    # Protocol-shape guard: present verdict.json needs enum + hex sha + round.
    | (if $V0 == null then null
       elif ($V0 | type) != "object" then error("bad_verdict_shape")
       elif ($V0.verdict == null) or ($V0.verdict | type != "string")
            or (verdict_ok($V0.verdict) | not) then error("bad_verdict_enum")
       elif ($V0.sha == null) or (sha_ok($V0.sha) | not) then error("bad_verdict_sha")
       elif ($V0.round == null) or (round_ok($V0.round) | not) then error("bad_verdict_round")
       else $V0 end) as $V
    | ($rq[0] // null) as $RQ0
    | (if $RQ0 == null then null
       elif ($RQ0 | type) != "object" then error("bad_request_shape")
       elif ($RQ0.round == null) or (round_ok($RQ0.round) | not) then error("bad_request_round")
       elif ($rq_round_from_name != null)
            and (($RQ0.round | floor) != $rq_round_from_name) then error("bad_request_round_mismatch")
       else $RQ0 end) as $RQ
    # RUNNING only when a newer request exists AND no last-error (infra failure
    # leaves request-N behind without a live reviewer).
    | (if $RQ != null and (($RQ.round // 0) > ($V.round // 0)) and ($has_last_error | not)
       then true else false end) as $running
    | (if $V == null then null
       else (sha_match($V.sha // ""; $head_full) | not) end) as $stale
    | ($tr | map(select(type == "object" and .type == "assistant" and (.message.usage? != null))
        | {e: ((.timestamp // "") | sub("\\.[0-9]+Z$"; "Z") | try fromdate catch null),
           i: (.message.usage.input_tokens // 0),
           cc: (.message.usage.cache_creation_input_tokens // 0),
           cr: (.message.usage.cache_read_input_tokens // 0),
           o: (.message.usage.output_tokens // 0),
           m: (.message.model // null)}
        | select(.e != null))) as $use
    | (if ($use | length) == 0 then null
       else ([$use[] | select(.e > $now - 300) | toksum] | add // 0) / 5 | floor end) as $burn
    # tokens_total = sum over the recent transcript window (all token categories).
    | (if ($use | length) == 0 then null
       else ([$use[] | toksum] | add // 0) end) as $tok
    | (($use | map(.m) | map(select(. != null)) | .[-1]) // null) as $driver_model
    # Live reviewer from verdict only (request-N.json has no model/vendor field).
    # Config seats are separate under models.seats for first-round / feedless.
    | (($V.model // null)) as $rev_model
    | (($V.vendor // null) // null) as $rev_vendor
    | {
        path: $path,
        name: $name,
        branch: $branch,
        head: $head,
        feedless: ($feedless == 1),
        sid: (if $sid == "" then null else $sid end),
        task: (if $task == "" then null else $task end),
        session_secs: $session_secs,
        activity_secs_ago: (if $activity_ago == null then null else $activity_ago end),
        model_driver: $driver_model,
        model_reviewer: $rev_model,
        models: {
          live: {
            driver: $driver_model,
            reviewer: $rev_model,
            reviewer_vendor: $rev_vendor
          },
          seats: {
            reviewer_vendor: nonempty($seat_rv),
            reviewer_tier1: nonempty($seat_rt1),
            reviewer_tier2: nonempty($seat_rt2),
            audit_vendor: nonempty($seat_av),
            audit_model: nonempty($seat_am),
            advisor_vendor: nonempty($seat_advv),
            advisor_model: nonempty($seat_advm),
            advisor_model_max: nonempty($seat_advx)
          }
        },
        tokens_total: $tok,
        tokens_window: "recent_transcript_tail",
        burn_per_min: $burn,
        phases: ($phases // {}),
        review_round_secs: $review_round_secs,
        review: (if $V == null and ($running | not) and ($has_last_error | not) then null
                 elif $V == null and $has_last_error then {
                   verdict: null, round: ($RQ.round // null), sha7: null,
                   stale: null, running: false, mode: ($RQ.mode // null),
                   tier: null, last_error: true
                 }
                 else {
          verdict: ($V.verdict // null),
          round: (if $running then ($RQ.round // null) else ($V.round // null) end),
          sha7: (if $V == null then null else ($V.sha // "")[0:7] end),
          stale: $stale,
          running: $running,
          mode: (if $running then ($RQ.mode // null) else ($V.mode // null) end),
          tier: ($V.risk.tier // null),
          last_error: $has_last_error
        } end),
        needs_human: {
          open: $nhn, blocking: $nhb, items: $nh_items, truncated: $nh_trunc
        },
        quota: {
          available: false,
          note: "Per-project burn only; vendor plan quota is top-level (CLI /usage cache)"
        }
      }
  ' 2>/dev/null || jq -nc --arg path "$dir" --arg name "$(basename "$dir")" \
      --arg head "$head" --arg branch "$branch" --argjson feedless "$feedless" \
      --argjson nhn "$nhn" --argjson nhb "$nhb" --argjson nh_items "$nh_items_arr" \
      --argjson nh_trunc "$nh_trunc" --argjson phases "$phases_json" \
      --argjson review_round_secs "$review_round_secs" \
      --arg seat_rv "${seat_reviewer_vendor:-}" --arg seat_rt1 "${seat_reviewer_t1:-}" \
      --arg seat_rt2 "${seat_reviewer_t2:-}" --arg seat_av "${seat_audit_vendor:-}" \
      --arg seat_am "${seat_audit_model:-}" --arg seat_advv "${seat_advisor_vendor:-}" \
      --arg seat_advm "${seat_advisor_model:-}" --arg seat_advx "${seat_advisor_max:-}" \
      'def nonempty($s): if ($s|type)=="string" and ($s|length)>0 then $s else null end;
      {path:$path,name:$name,branch:$branch,head:$head,feedless:($feedless==1),
        error:"snapshot_render_failed",
        needs_human:{open:$nhn,blocking:$nhb,items:$nh_items,truncated:$nh_trunc},
        phases:($phases // {}), review_round_secs:$review_round_secs,
        models:{live:{driver:null,reviewer:null,reviewer_vendor:null},
          seats:{reviewer_vendor:nonempty($seat_rv),reviewer_tier1:nonempty($seat_rt1),
                 reviewer_tier2:nonempty($seat_rt2),audit_vendor:nonempty($seat_av),
                 audit_model:nonempty($seat_am),advisor_vendor:nonempty($seat_advv),
                 advisor_model:nonempty($seat_advm),advisor_model_max:nonempty($seat_advx)}},
        quota:{available:false,note:"Per-project burn only; vendor plan quota is top-level (CLI /usage cache)"}}'
  [ -n "$tr_tmp" ] && rm -f "$tr_tmp"
  return 0
}

# Vendor plan quota (overall weekly) via official CLIs — NOT scraped web UIs.
# Cached under ~/.config/plinth/dash-quota.json; refresh interval default 900s
# (15 min). PLINTH_DASH_QUOTA_TTL overrides.
#
# Offline by default: plain `plinth dash --snapshot` only READs the cache
# (or returns skipped/offline). Live CLI probes run only for the internal
# `dash --snapshot-with-quota` command used by the HTTP serve child (not a
# caller-set env var). PLINTH_DASH_QUOTA=0 disables probes entirely.
# Claude: `claude -p /usage --output-format json` with a hard timeout.
_DASH_QUOTA_TTL="${PLINTH_DASH_QUOTA_TTL:-900}"
_DASH_QUOTA_CACHE="${PLINTH_DASH_QUOTA_CACHE:-$HOME/.config/plinth/dash-quota.json}"
_DASH_QUOTA_TIMEOUT="${PLINTH_DASH_QUOTA_TIMEOUT:-25}"
# Set by run_dashboard when argv is --snapshot-with-quota (serve child only).
_DASH_QUOTA_ALLOW_PROBE=0

_dash_quota_probe() {
  # Prints one JSON object on stdout. Never fails the snapshot (always 0).
  local now ttl=$_DASH_QUOTA_TTL cache="$_DASH_QUOTA_CACHE"
  now="$(date +%s)"
  case "$ttl" in ''|*[!0-9]*) ttl=900 ;; esac
  if [ "${PLINTH_DASH_QUOTA:-1}" = "0" ]; then
    jq -nc --argjson now "$now" \
      '{available:false, refreshed_at:$now, skipped:true,
        note:"quota probes disabled (PLINTH_DASH_QUOTA=0)", vendors:[]}'
    return 0
  fi
  # Offline / public --snapshot: never spawn vendor CLIs — cache only.
  # Probes require the internal --snapshot-with-quota path (serve child).
  if [ "${_DASH_QUOTA_ALLOW_PROBE:-0}" != "1" ]; then
    if [ -f "$cache" ]; then
      if jq -e 'type == "object"' "$cache" >/dev/null 2>&1; then
        cat "$cache"
        return 0
      fi
    fi
    jq -nc --argjson now "$now" \
      '{available:false, refreshed_at:$now, offline:true,
        note:"quota cache empty — HTTP serve refreshes via CLI ~15m",
        vendors:[]}'
    return 0
  fi
  # Serve-mode: use cache when fresh.
  if [ -f "$cache" ]; then
    local age refreshed
    refreshed="$(jq -r '.refreshed_at // 0' "$cache" 2>/dev/null || echo 0)"
    case "$refreshed" in ''|*[!0-9]*) refreshed=0 ;; esac
    age=$((now - refreshed))
    if [ "$age" -ge 0 ] 2>/dev/null && [ "$age" -lt "$ttl" ] 2>/dev/null; then
      cat "$cache"
      return 0
    fi
  fi

  local vendors_tmp
  vendors_tmp="$(mktemp)" || {
    jq -nc --argjson now "$now" \
      '{available:false, refreshed_at:$now, note:"mktemp failed", vendors:[]}'
    return 0
  }
  : > "$vendors_tmp"

  # ── Claude: headless /usage (hard timeout; never hang the wallboard) ──
  if command -v claude >/dev/null 2>&1; then
    local cl_out cl_rc=0 cl_to="$_DASH_QUOTA_TIMEOUT"
    case "$cl_to" in ''|*[!0-9]*) cl_to=25 ;; esac
    # Empty cwd: never inherit a project checkout's hooks/settings into the probe.
    cl_out="$(python3 -c '
import os, subprocess, sys, tempfile
to = int(sys.argv[1])
try:
    with tempfile.TemporaryDirectory(prefix="plinth-quota-") as d:
        p = subprocess.run(
            ["claude", "-p", "/usage", "--output-format", "json"],
            capture_output=True, text=True, timeout=to, cwd=d,
            env={**os.environ, "CLAUDE_PROJECT_DIR": d},
        )
        sys.stdout.write(p.stdout or "")
        sys.exit(p.returncode)
except subprocess.TimeoutExpired:
    sys.exit(124)
except Exception:
    sys.exit(1)
' "$cl_to" 2>/dev/null)" || cl_rc=$?
    if [ "$cl_rc" -eq 124 ]; then
      jq -nc --argjson now "$now" \
        '{vendor:"claude",available:false,error:"cli_timeout",probed_at:$now}' >> "$vendors_tmp"
    elif [ "$cl_rc" -eq 0 ] && [ -z "$cl_out" ]; then
      # Empty stdout is parse_failed (not cli_failed) — promised empty/unparsed path.
      jq -nc --argjson now "$now" \
        '{vendor:"claude",available:false,error:"parse_failed",probed_at:$now}' >> "$vendors_tmp"
    elif [ "$cl_rc" -eq 0 ]; then
      printf '%s' "$cl_out" | jq -c --argjson now "$now" '
        (.result // "") as $t
        | [ ($t
            | capture("(?m)^Current session:\\s*(?<pct>\\d+)% used · resets (?<reset>.+)$")? // empty
            | {window:"session", used_pct:(.pct|tonumber), reset_text:.reset}),
            ($t
            | capture("(?m)^Current week \\(all models\\):\\s*(?<pct>\\d+)% used · resets (?<reset>.+)$")? // empty
            | {window:"week_all_models", used_pct:(.pct|tonumber), reset_text:.reset}),
            ($t
            | capture("(?m)^Current week \\((?<label>[^)]+)\\):\\s*(?<pct>\\d+)% used · resets (?<reset>.+)$")? // empty
            | select(.label != "all models")
            | {window:("week_"+(.label|ascii_downcase|gsub(" ";"_"))), used_pct:(.pct|tonumber), reset_text:.reset})
          ] as $wins
        | if ($wins | length) == 0 then
            {vendor:"claude", available:false, error:"parse_failed", probed_at:$now}
          else
            {vendor:"claude", available:true, windows:$wins, probed_at:$now}
          end
      ' >> "$vendors_tmp" 2>/dev/null || \
        jq -nc --argjson now "$now" \
          '{vendor:"claude",available:false,error:"parse_failed",probed_at:$now}' >> "$vendors_tmp"
    else
      jq -nc --argjson now "$now" \
        '{vendor:"claude",available:false,error:"cli_failed",probed_at:$now}' >> "$vendors_tmp"
    fi
  else
    jq -nc --argjson now "$now" \
      '{vendor:"claude",available:false,error:"cli_missing",probed_at:$now}' >> "$vendors_tmp"
  fi

  # ── Codex / Grok: no stable headless surface yet (interactive /status|/usage).
  # Record honest unavailability so the UI does not invent numbers.
  for v in codex grok; do
    if command -v "$v" >/dev/null 2>&1; then
      jq -nc --arg v "$v" --argjson now "$now" \
        '{vendor:$v,available:false,error:"no_headless_usage_surface",
          note:"Use interactive /status (codex) or /usage (grok) until a headless API exists",
          probed_at:$now}' >> "$vendors_tmp"
    else
      jq -nc --arg v "$v" --argjson now "$now" \
        '{vendor:$v,available:false,error:"cli_missing",probed_at:$now}' >> "$vendors_tmp"
    fi
  done

  # Assemble + projection from history of week_all_models samples.
  local history_in='[]'
  if [ -f "$cache" ]; then
    history_in="$(jq -c '.history // []' "$cache" 2>/dev/null || echo '[]')"
  fi
  local assembled
  assembled="$(jq -nc --slurpfile v "$vendors_tmp" --argjson now "$now" --argjson hist "$history_in" '
    def week_pct:
      [.[] | select(.vendor=="claude" and .available==true)
           | (.windows // [])[]
           | select(.window=="week_all_models")
           | .used_pct] | .[0] // null;
    def week_reset:
      [.[] | select(.vendor=="claude" and .available==true)
           | (.windows // [])[]
           | select(.window=="week_all_models")
           | .reset_text] | .[0] // null;
    ($v[0:] | map(select(type=="object"))) as $vendors
    | ($vendors | week_pct) as $wp
    | ($vendors | week_reset) as $reset
    | (if $wp == null then $hist
       else
         # Keep only same-reset samples; drop legacy reset-less entries and other weeks.
         ([ $hist[]
            | select(($reset != null) and (.reset_text != null) and (.reset_text == $reset))
          ] + [{t:$now, week_all_models_pct:$wp, reset_text:$reset}])
         | .[-48:]
       end) as $hist2
    # Rate from same-reset samples only (both ends must carry reset_text).
    | ([$hist2[] | select(.week_all_models_pct != null and .reset_text != null)] | sort_by(.t)) as $hs
    | (if ($hs|length) < 2 then null
       else
         ($hs[-1]) as $a
         | ([ $hs[]
             | select(($a.t - .t) >= 600
                      and .week_all_models_pct < $a.week_all_models_pct
                      and .reset_text == $a.reset_text)
           ] | .[0] // null) as $b
         | if $b != null then
             {rate_pct_per_s: (($a.week_all_models_pct - $b.week_all_models_pct) / ($a.t - $b.t)),
              from_t:$b.t, to_t:$a.t}
           else
             ($hs[0]) as $f
             | if ($a.t - $f.t) >= 600 and ($a.week_all_models_pct > $f.week_all_models_pct)
                  and ($f.reset_text == $a.reset_text)
               then {rate_pct_per_s: (($a.week_all_models_pct - $f.week_all_models_pct) / ($a.t - $f.t)),
                     from_t:$f.t, to_t:$a.t}
               else null end
           end
       end) as $rate
    | (if $wp == null or $rate == null or ($rate.rate_pct_per_s // 0) <= 0 then null
       elif $wp >= 100 then $now
       else ($now + (((100 - $wp) / $rate.rate_pct_per_s) | floor)) end) as $proj100
    | {
        available: ([$vendors[] | select(.available==true)] | length > 0),
        refreshed_at: $now,
        overall: (if $wp == null then null else {
          vendor: "claude",
          window: "week_all_models",
          used_pct: $wp,
          remaining_pct: (100 - $wp),
          reset_text: $reset,
          projected_100pct_at: $proj100,
          rate_pct_per_hour: (if $rate == null then null
                              else (($rate.rate_pct_per_s * 3600 * 10) | floor / 10) end)
        } end),
        vendors: $vendors,
        history: $hist2,
        note: "Overall weekly plan usage from claude -p /usage; refreshed every ~15m. Projection needs ≥2 same-reset samples ≥10m apart."
      }
  ' 2>/dev/null)" || assembled=""
  rm -f "$vendors_tmp"
  if [ -z "$assembled" ]; then
    jq -nc --argjson now "$now" \
      '{available:false, refreshed_at:$now, note:"quota assemble failed", vendors:[]}'
    return 0
  fi
  # Persist cache (best-effort).
  mkdir -p "$(dirname "$cache")" 2>/dev/null || true
  printf '%s\n' "$assembled" > "$cache" 2>/dev/null || true
  printf '%s\n' "$assembled"
}

build_dashboard_snapshot() {
  local roots tmp dir projects_json discovery quota_json
  tmp="$(mktemp)" || { echo "plinth dash: mktemp failed" >&2; exit 1; }
  : > "$tmp"
  roots="$(discover_dashboard_projects | sort -u)"
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    snapshot_one_project "$dir" >> "$tmp" || true
  done <<< "$roots"
  # jq -s on an empty file yields []; if the slurp itself fails, surface a top-level
  # error rather than a silent empty wallboard (looks-idle-while-broken).
  local top_err=""
  if projects_json="$(jq -s '.' "$tmp" 2>/dev/null)"; then
    :
  else
    projects_json='[]'
    top_err="projects_aggregate_failed"
  fi
  rm -f "$tmp"
  if [ -n "${PLINTH_DASH_ROOTS:-}" ]; then
    discovery="env:PLINTH_DASH_ROOTS"
  elif [ -f "$HOME/.config/plinth/dashboard-projects" ]; then
    discovery="config:~/.config/plinth/dashboard-projects"
  else
    discovery="default:~/Dev/*/.plinth/config"
  fi
  # Quota probe is independent of project cards; failures stay inside the object.
  quota_json="$(_dash_quota_probe 2>/dev/null || true)"
  [ -n "$quota_json" ] || quota_json='{"available":false,"note":"quota probe unavailable","vendors":[]}'
  if [ -n "$top_err" ]; then
    jq -nc --argjson projects "$projects_json" --argjson generated_at "$(date +%s)" \
       --arg discovery "$discovery" --arg error "$top_err" --argjson quota "$quota_json" \
       '{generated_at:$generated_at, discovery:$discovery, projects:$projects, error:$error, quota:$quota}'
  else
    jq -nc --argjson projects "$projects_json" --argjson generated_at "$(date +%s)" \
       --arg discovery "$discovery" --argjson quota "$quota_json" \
       '{generated_at:$generated_at, discovery:$discovery, projects:$projects, quota:$quota}'
  fi
}

run_dashboard() {
  shift  # drop cmd
  local mode=serve port="${PLINTH_DASH_PORT:-7348}" arg
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --snapshot) mode=snapshot ;;
      # Internal: HTTP serve child only. Not a public operator flag.
      --snapshot-with-quota) mode=snapshot_quota ;;
      --port)
        port="${1:-}"
        [ -n "$port" ] || { echo "plinth dash: --port needs a number" >&2; exit 1; }
        shift || true
        ;;
      --help|-h) usage ;;
      *) echo "plinth dash: unknown arg: $arg" >&2; usage ;;
    esac
  done

  if [ "$mode" = snapshot ] || [ "$mode" = snapshot_quota ]; then
    # Public --snapshot is always offline. Probe only via --snapshot-with-quota
    # (serve child). Env vars cannot enable probes on --snapshot.
    if [ "$mode" = snapshot_quota ]; then
      _DASH_QUOTA_ALLOW_PROBE=1
    else
      _DASH_QUOTA_ALLOW_PROBE=0
    fi
    build_dashboard_snapshot
    exit 0
  fi

  # Validate the final port whether it came from --port or PLINTH_DASH_PORT
  # (serve mode only — snapshot never binds). Length-cap first so an oversized
  # digit string cannot trip bash "integer expression expected" and fall through.
  case "$port" in ''|*[!0-9]*) echo "plinth dash: bad port: $port" >&2; exit 1 ;; esac
  if [ "${#port}" -gt 5 ] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo "plinth dash: port out of range (1-65535): $port" >&2; exit 1
  fi

  command -v python3 >/dev/null 2>&1 || { echo "plinth dash: python3 required to serve the UI" >&2; exit 1; }
  local html="$PLINTH_ROOT/shared/dashboard/index.html"
  [ -f "$html" ] || { echo "plinth dash: missing $html" >&2; exit 1; }

  # Resolve self for the child to re-invoke --snapshot (same checkout / same env).
  local self="$PLINTH_ROOT/bin/plinth"
  [ -x "$self" ] || self="$(command -v plinth 2>/dev/null || true)"
  [ -n "$self" ] || { echo "plinth dash: cannot locate plinth binary" >&2; exit 1; }

  echo "plinth dash: http://127.0.0.1:${port}/  (loopback only · ctrl-c to quit)"
  echo "  discovery: $(if [ -n "${PLINTH_DASH_ROOTS:-}" ]; then echo "PLINTH_DASH_ROOTS"; elif [ -f "$HOME/.config/plinth/dashboard-projects" ]; then echo "~/.config/plinth/dashboard-projects"; else echo "~/Dev/*/.plinth/config"; fi)"
  # Env passed explicitly so the child inherits roots/config the same way.
  # Serve child re-invokes `dash --snapshot-with-quota` (not public --snapshot).
  PLINTH_BIN="$self" PLINTH_DASH_HTML="$html" \
  PLINTH_DASH_ROOTS="${PLINTH_DASH_ROOTS:-}" \
  python3 - "$port" <<'PY'
import json, os, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(sys.argv[1])
HOST = "127.0.0.1"
HTML = os.environ["PLINTH_DASH_HTML"]
BIN = os.environ["PLINTH_BIN"]
# Preserve operator discovery overrides for snapshot child.
CHILD_ENV = os.environ.copy()

# Single-flight + TTL cache: concurrent /api/snapshot callers share one builder.
# TTL is >= the UI poll interval (2s) so steady-state polling reuses the body
# instead of re-scanning every project's events.jsonl every tick. Loopback-only.
_snap_lock = threading.Lock()
_snap_body = None  # success body bytes
_snap_err = None   # failure body bytes (shared single-flight)
_snap_mono = 0.0
_SNAP_TTL = 2.5
_SNAP_ERR_TTL = 1.0
# Optional test hook: PLINTH_DASH_SNAPSHOT_BIN overrides the offline builder
# (smoke counts invocations for single-flight / TTL assertions).
SNAP_BIN = os.environ.get("PLINTH_DASH_SNAPSHOT_BIN") or BIN

def _host_ok(handler):
    # DNS-rebinding defense: only accept loopback Host values.
    # Handles "127.0.0.1:7348", "localhost", "[::1]", "[::1]:7348".
    # Rejects "[::1]attacker.example" and any non-empty non-:port suffix after ].
    h = (handler.headers.get("Host") or "").strip().lower()
    if not h:
        return False
    if h.startswith("["):
        end = h.find("]")
        if end < 0:
            return False
        host = h[1:end]
        rest = h[end + 1:]
        if rest:
            # Must be exactly :digits (port); nothing else.
            if not (rest.startswith(":") and rest[1:].isdigit() and len(rest) > 1):
                return False
    else:
        # hostname / IPv4, optional :port (exactly one colon for port split)
        if h.count(":") == 1:
            host, port = h.rsplit(":", 1)
            if not port.isdigit():
                return False
        else:
            host = h
    return host in ("127.0.0.1", "localhost", "::1")

def _snapshot_bytes():
    """Single-flight success + short-lived shared failure (no stampede on errors)."""
    global _snap_body, _snap_err, _snap_mono
    now = time.monotonic()
    with _snap_lock:
        if _snap_body is not None and (now - _snap_mono) < _SNAP_TTL:
            return 200, _snap_body
        if _snap_err is not None and (now - _snap_mono) < _SNAP_ERR_TTL:
            return 500, _snap_err
        try:
            proc = subprocess.run(
                # Internal flag: may refresh vendor quota; public --snapshot cannot.
                [SNAP_BIN, "dash", "--snapshot-with-quota"],
                env=CHILD_ENV,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=120,
                check=False,
            )
            if proc.returncode != 0:
                detail = (proc.stderr or b"").decode("utf-8", "replace").strip()
                if not detail:
                    detail = (proc.stdout or b"").decode("utf-8", "replace").strip()
                if not detail:
                    detail = "dash --snapshot exited %s" % proc.returncode
                err = json.dumps({"error": "snapshot_failed", "detail": detail[:2000]}).encode()
                _snap_err = err
                _snap_body = None
                _snap_mono = time.monotonic()
                return 500, err
            out = proc.stdout or b""
            json.loads(out)
            _snap_body = out
            _snap_err = None
            _snap_mono = time.monotonic()
            return 200, out
        except Exception as e:
            err = json.dumps({"error": "snapshot_failed", "detail": str(e)[:2000]}).encode()
            _snap_err = err
            _snap_body = None
            _snap_mono = time.monotonic()
            return 500, err

class H(BaseHTTPRequestHandler):
    server_version = "plinth-dash/1"
    def log_message(self, fmt, *args):
        sys.stderr.write("plinth dash: %s - %s\n" % (self.address_string(), fmt % args))

    def _send(self, code, body: bytes, ctype: str):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if not _host_ok(self):
            self._send(400, b"bad host", "text/plain; charset=utf-8")
            return
        path = self.path.split("?", 1)[0]
        if path in ("/", "/index.html"):
            try:
                with open(HTML, "rb") as f:
                    body = f.read()
            except OSError as e:
                self._send(500, str(e).encode(), "text/plain; charset=utf-8")
                return
            self._send(200, body, "text/html; charset=utf-8")
            return
        if path == "/api/snapshot":
            code, out = _snapshot_bytes()
            self._send(code, out, "application/json; charset=utf-8")
            return
        self._send(404, b"not found", "text/plain; charset=utf-8")

    def do_POST(self):
        if not _host_ok(self):
            self._send(400, b"bad host", "text/plain; charset=utf-8")
            return
        self._send(405, b"read-only", "text/plain; charset=utf-8")

class LoopbackServer(ThreadingHTTPServer):
    allow_reuse_address = True
    def server_bind(self):
        # Belt: refuse non-loopback even if HOST were ever changed above.
        if self.server_address[0] not in ("127.0.0.1", "::1"):
            raise RuntimeError("plinth dash refuses non-loopback bind")
        super().server_bind()

httpd = LoopbackServer((HOST, PORT), H)
try:
    httpd.serve_forever()
except KeyboardInterrupt:
    pass
finally:
    httpd.server_close()
PY
}

case "$cmd" in
  statusline) statusline_render ;;
  advise) run_advise "$@" ;;
  hookprobe) run_hookprobe "$@" ;;
  changelog-collate) run_changelog_collate "$@" ;;
  queue) run_queue ;;
  smoke) run_smoke "$@" ;;
  watch) watch_project ;;
  dash|dashboard) run_dashboard "$@" ;;
  init)
    preflight_reserved_lanes
    copy_templates_if_absent
    copy_shared
    # Backfill security patterns even on init: a re-run (or a partially-scaffolded repo)
    # may already have a pre-v4.4 .plinth/protected-paths that copy_templates_if_absent
    # keeps as-is, so the new contract-file patterns (reviewer.md, CLAUDE.md, AGENTS.md)
    # would otherwise be missing. Idempotent — a fresh template already has them.
    ensure_protected_paths
    github_preflight
    warn_missing_gate_wiring
    echo "Plinth $PLINTH_VERSION initialized in $target"
    echo "Next: edit SPEC.md; commit. (ci.yml is zero-edit: owner auto-injected, checks auto-detect the stack at CI time.)"
    ;;
  update)
    [ -f "$target/.plinth-version" ] || { echo "Not a Plinth project (no .plinth-version). Run 'plinth init' first."; exit 1; }
    old="$(cat "$target/.plinth-version")"
    preflight_reserved_lanes
    warn_live_review
    copy_templates_if_absent
    copy_shared
    ensure_protected_paths
    migrate_needs_human
    # Tier-2 cross-vendor audit needs audit_vendor; init sets it but existing
    # configs are preserved, so remind upgraded projects (MANUAL.md points here).
    # The audit only runs when audit_vendor DIFFERS from the primary reviewer_vendor,
    # so suggest a different one than whatever this project's primary is.
    if ! grep -q '^audit_vendor' "$target/.plinth/config" 2>/dev/null; then
      rv="$(sed -n 's/^reviewer_vendor[[:space:]]*=[[:space:]]*//p' "$target/.plinth/config" 2>/dev/null | head -1)"
      [ -n "$rv" ] || rv=codex
      # v4 seats: the claude audit is the recommended second opinion (a different
      # family than both the grok driver and a codex/grok primary); a claude
      # PRIMARY can't audit itself, so it gets grok.
      case "$rv" in claude) sug=grok ;; *) sug=claude ;; esac
      # The suggested value is a SINGLE valid vendor (copy-pastable); agy is offered in
      # prose OUTSIDE the config line so it is never pasted as part of the value.
      # An unset audit_vendor DEFAULTS to codex in review.sh, so the audit is OFF only when
      # the primary is also codex; for a claude/grok primary the codex default already runs.
      if [ "$rv" = codex ]; then
        echo "  note: audit_vendor unset — it defaults to codex == reviewer_vendor (codex), so Tier 2 approvals get NO cross-vendor second opinion. Add 'audit_vendor = $sug' (or 'agy') to .plinth/config."
      else
        echo "  note: audit_vendor unset — it defaults to codex, which differs from reviewer_vendor ($rv), so the cross-vendor audit already runs with codex. Add 'audit_vendor = $sug' (or 'agy') to pin the auditor explicitly."
      fi
    fi
    github_preflight
    warn_missing_gate_wiring
    warn_stale_reusable_refs
    echo "Plinth updated in $target: $old -> $PLINTH_VERSION"
    echo "Review before committing: git -C \"$target\" diff"
    ;;
  goal)
    if [ -f "$target/GOAL.md" ]; then
      echo "GOAL.md already exists in $target — not overwriting."
      exit 1
    fi
    cp "$PLINTH_ROOT/templates/GOAL.template.md" "$target/GOAL.md"
    echo "GOAL.md draft created in $target."
    echo "Workflow: have the driver draft the specifics -> YOU ratify (STATUS: RATIFIED)"
    echo "-> add the eval script pattern to .plinth/protected-paths -> have Codex attack"
    echo "the rubric for gameability -> then let the loop run."
    ;;
  *) usage ;;
esac
