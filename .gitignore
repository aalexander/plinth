# Plinth repo's own .gitignore (repo housekeeping — not the project template,
# which lives at templates/.gitignore). Kept minimal on purpose: broad patterns
# here could mask files under templates/.

# macOS / OS junk
.DS_Store
Thumbs.db

# Delivered archives — never commit build zips into the source repo
*.zip

# Temp files from bin/plinth's portable in-place edits
*.plinth-tmp

# Implementer-lane prompt dirs + canary scratch (project-local Write paths)
/.plinth-lane.*
/.plinth-lane-canary.*

# Editor droppings
*.swp
*~

# Ephemeral agent worktrees. The Claude Code harness creates isolated subagent
# worktrees UNDER the repo here, so without this the tree reads as dirty and
# ./.plinth/review.sh refuses to run ("working tree is dirty") for as long as any
# subagent is alive — which is exactly when you want the reviewer running in
# parallel with the workers. Never committable; always local and transient.
.claude/worktrees/
